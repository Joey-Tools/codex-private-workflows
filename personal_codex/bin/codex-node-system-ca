#!/usr/bin/env python3
"""Opt in to Node.js using the macOS system certificate store."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import plistlib
import pwd
import subprocess
import sys
import tempfile
import stat
from typing import Any, Dict, Optional, Tuple


LABEL = "com.joey.node-system-ca"
VARIABLE = "NODE_USE_SYSTEM_CA"
LAUNCHCTL = "/bin/launchctl"
TIMEOUT_SECONDS = 8


class HelperError(RuntimeError):
    pass


def plist_path(home: Path) -> Path:
    return home / "Library" / "LaunchAgents" / (LABEL + ".plist")


def expected_plist() -> Dict[str, Any]:
    return {
        "Label": LABEL,
        "ProgramArguments": ["/bin/launchctl", "setenv", VARIABLE, "1"],
        "RunAtLoad": True,
        "LimitLoadToSessionType": "Aqua",
    }


def launchctl(*args: str) -> Tuple[int, str, str]:
    try:
        result = subprocess.run(
            [LAUNCHCTL, *args], capture_output=True, text=True,
            timeout=TIMEOUT_SECONDS, check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise HelperError("launchctl timed out: " + " ".join(args)) from exc
    except OSError as exc:
        raise HelperError("could not run launchctl: " + str(exc)) from exc
    return result.returncode, result.stdout, result.stderr


def command_ok(*args: str) -> None:
    code, _out, err = launchctl(*args)
    if code:
        raise HelperError("launchctl " + " ".join(args) + " failed: " + err.strip())


def service_loaded(uid: int) -> bool:
    code, _out, err = launchctl("print", "gui/%d/%s" % (uid, LABEL))
    if code == 0:
        return True
    # Match the observed launchctl diagnostic to this exact label and GUI UID.
    missing = 'Could not find service "%s" in domain for user gui: %d' % (LABEL, uid)
    if code == 113 and missing in err:
        return False
    raise HelperError("cannot determine LaunchAgent state: " + err.strip())


def gui_value() -> Optional[str]:
    code, out, err = launchctl("getenv", VARIABLE)
    if code:
        raise HelperError("cannot query GUI environment: " + err.strip())
    value = out.rstrip("\r\n")
    return value if value else None


def managed_file(path: Path) -> Tuple[bool, str]:
    """Match semantic ownership and detect inode replacement observed during read."""
    try:
        before = path.lstat()
    except FileNotFoundError:
        return False, "missing"
    if not stat.S_ISREG(before.st_mode):
        return False, "foreign object (expected a regular plist file)"
    try:
        with path.open("rb") as stream:
            opened = os.fstat(stream.fileno())
            content = stream.read(1024 * 1024 + 1)
        after = path.lstat()
    except OSError as exc:
        raise HelperError("cannot read LaunchAgent plist: " + str(exc)) from exc
    # Object identity is checked around the single content read. Metadata churn is
    # benign; this does not guarantee content stability against concurrent same-UID edits.
    if (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino):
        return False, "foreign object (replaced during inspection)"
    if (opened.st_dev, opened.st_ino) != (after.st_dev, after.st_ino):
        return False, "foreign object (replaced during inspection)"
    if len(content) > 1024 * 1024:
        return False, "foreign content (plist exceeds size limit)"
    try:
        parsed = plistlib.loads(content)
    except Exception:
        return False, "foreign content (invalid plist)"
    if parsed != expected_plist():
        return False, "foreign content (does not match this helper)"
    return True, "managed"


def write_plist(path: Path) -> None:
    directory = path.parent
    directory.mkdir(parents=True, exist_ok=True)
    if directory.is_symlink() or not directory.is_dir():
        raise HelperError("LaunchAgents path is not a directory")
    data = plistlib.dumps(expected_plist(), fmt=plistlib.FMT_XML, sort_keys=True)
    fd, temporary = tempfile.mkstemp(prefix=".node-system-ca-", dir=str(directory))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        # link() is atomic and refuses to replace an object created concurrently.
        os.link(temporary, path)
    except FileExistsError as exc:
        raise HelperError("LaunchAgent plist appeared during install; retry") from exc
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def unlink_managed(path: Path) -> None:
    owned, reason = managed_file(path)
    if not owned:
        if reason == "missing":
            return
        raise HelperError("refusing to remove LaunchAgent plist: " + reason)
    # Recheck inode identity and semantic content before unlinking. This catches
    # observed replacement, but cannot guarantee safety against concurrent same-UID edits.
    try:
        before = path.lstat()
        with path.open("rb") as stream:
            opened = os.fstat(stream.fileno())
            content = stream.read(1024 * 1024 + 1)
        after = path.lstat()
    except OSError as exc:
        raise HelperError("cannot revalidate LaunchAgent plist: " + str(exc)) from exc
    if (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino) or (
        (opened.st_dev, opened.st_ino) != (after.st_dev, after.st_ino)
    ) or plistlib.loads(content) != expected_plist():
        raise HelperError("LaunchAgent plist changed during uninstall; retry")
    path.unlink()


def account() -> Tuple[int, Path]:
    if sys.platform != "darwin":
        raise HelperError("this helper only supports macOS")
    uid = os.getuid()
    if uid == 0:
        raise HelperError("run as the logged-in user, not root or with sudo")
    entry = pwd.getpwuid(uid)
    return uid, Path(entry.pw_dir)


def require_gui(uid: int) -> None:
    code, out, err = launchctl("managername")
    if code or out.strip() != "Aqua":
        detail = err.strip() or ("managername reported " + repr(out.strip()))
        raise HelperError("the caller must be in an Aqua GUI session: " + detail)
    code, out, err = launchctl("manageruid")
    if code or out.strip() != str(uid):
        detail = err.strip() or ("manageruid reported " + repr(out.strip()))
        raise HelperError("the Aqua context must belong to the current account: " + detail)


def report(uid: int, home: Path, gui: bool, error: Optional[str] = None) -> Dict[str, Any]:
    path = plist_path(home)
    installed: Optional[bool]
    ownership, reason = managed_file(path)
    installed = None if reason.startswith("foreign") else ownership
    loaded: Optional[bool] = None
    value: Optional[str] = None
    failures = []
    if reason.startswith("foreign"):
        failures.append(reason)
    if gui:
        try:
            loaded = service_loaded(uid)
        except HelperError as exc:
            failures.append(str(exc))
        try:
            value = gui_value()
        except HelperError as exc:
            failures.append(str(exc))
    configured = ownership and loaded is True and value == "1"
    if error:
        state = error
    elif failures:
        state = "; ".join(failures)
    elif configured:
        state = "configured"
    else:
        missing = []
        if not ownership:
            missing.append("managed plist missing")
        if loaded is False:
            missing.append("LaunchAgent not loaded")
        if value != "1":
            missing.append("GUI environment %s is not 1" % VARIABLE)
        state = "not configured: " + "; ".join(missing)
    return {
        "platform": sys.platform,
        "uid": uid,
        "home": str(home),
        "plist_path": str(path),
        "plist_installed": installed,
        "plist_state": reason,
        "service_loaded": loaded,
        "gui_environment_value": value,
        "gui_context": gui,
        "configured": configured,
        "status": state,
        "ok": not failures and error is None,
    }


def execute(action: str, dry_run: bool = False) -> Dict[str, Any]:
    uid, home = account()
    if action == "status":
        try:
            require_gui(uid)
        except HelperError as exc:
            return report(uid, home, False, str(exc))
        return report(uid, home, True)
    require_gui(uid)
    path = plist_path(home)
    ownership, reason = managed_file(path)
    if reason.startswith("foreign"):
        raise HelperError("refusing to manage LaunchAgent plist: " + reason)
    if dry_run:
        if action == "install":
            planned = ["install matching plist" if not ownership else "reuse matching plist"]
            planned.extend(("set GUI environment %s=1" % VARIABLE, "enable %s" % LABEL))
            if not service_loaded(uid):
                planned.append("bootstrap LaunchAgent")
        else:
            loaded = service_loaded(uid)
            if not ownership and loaded:
                raise HelperError("refusing to uninstall an orphaned loaded service without its matching plist")
            if ownership:
                planned = ["disable %s" % LABEL]
                if loaded:
                    planned.append("unload %s" % LABEL)
                planned.append("remove matching plist")
            else:
                planned = []
            current = gui_value()
            planned.append("clear GUI environment %s" % VARIABLE if current == "1" else "preserve GUI environment value")
            if not ownership:
                planned.append("no managed plist or loaded service to remove")
        result = report(uid, home, True)
        if result["ok"]:
            result["status"] = "dry-run"
        result["planned_actions"] = planned
        return result

    if action == "install":
        if not ownership:
            write_plist(path)
        command_ok("setenv", VARIABLE, "1")
        domain = "gui/%d" % uid
        command_ok("enable", domain + "/" + LABEL)
        was_loaded = service_loaded(uid)
        if not was_loaded:
            command_ok("bootstrap", domain, str(path))
        result = report(uid, home, True)
        if not result["configured"]:
            raise HelperError("install did not reach the configured state: " + result["status"])
        if was_loaded:
            result["status"] = "installed; existing service was already loaded, running processes keep their current environment"
        return result

    loaded = service_loaded(uid)
    if not ownership:
        if loaded:
            raise HelperError("refusing to uninstall an orphaned loaded service without its matching plist")
        if gui_value() == "1":
            command_ok("unsetenv", VARIABLE)
        result = report(uid, home, True)
        if result["ok"]:
            result["status"] = "uninstalled; no managed plist or loaded service was present"
        return result
    domain = "gui/%d" % uid
    command_ok("disable", domain + "/" + LABEL)
    if loaded:
        command_ok("bootout", domain + "/" + LABEL)
    current = gui_value()
    if current == "1":
        command_ok("unsetenv", VARIABLE)
    unlink_managed(path)
    result = report(uid, home, True)
    if result["ok"]:
        result["status"] = "uninstalled"
    return result


def main(argv: Optional[list[str]] = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="action", required=True)
    for name in ("install", "uninstall", "status"):
        sub = subparsers.add_parser(name)
        if name != "status":
            sub.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        result = execute(args.action, getattr(args, "dry_run", False))
    except HelperError as exc:
        result = {"platform": sys.platform, "status": str(exc), "ok": False}
        if args.action != "status":
            try:
                uid, home = account()
                require_gui(uid)
                result["partial_state"] = report(uid, home, True)
            except HelperError:
                pass
        print(json.dumps(result, sort_keys=True))
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("ok", True) else 1


if __name__ == "__main__":
    raise SystemExit(main())
