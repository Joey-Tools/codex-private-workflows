        _revalidate_canonical_runner_binding(self, held_only=False)

    def revalidate_held(self) -> None:
        _revalidate_canonical_runner_binding(self, held_only=True)


class Runtime:
    """Narrow runtime surface so tests never call launchctl, ssh, or sleep."""

    def account(self) -> Account:
        raise NotImplementedError

    def host_candidates(self) -> Tuple[str, ...]:
        raise NotImplementedError

    def machine_identity_sha256(self) -> str:
        raise NotImplementedError

    def run(
        self,
        argv: Sequence[str],
        *,
        timeout: float,
        output_limit: int,
        before_spawn: Optional[Callable[[], None]] = None,
    ) -> CommandResult:
        raise NotImplementedError

    def monotonic(self) -> float:
        return time.monotonic()

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)


class SystemRuntime(Runtime):
    def account(self) -> Account:
        uid = os.geteuid()
        try:
            record = pwd.getpwuid(uid)
        except KeyError as error:
            raise ControllerError(f"current uid has no account record: {uid}") from error
        return Account(record.pw_name, uid, Path(record.pw_dir))

    def host_candidates(self) -> Tuple[str, ...]:
        candidates: List[str] = []
        for key in ("ComputerName", "LocalHostName", "HostName"):
            result = self.run(
                ("/usr/sbin/scutil", "--get", key),
                timeout=5.0,
                output_limit=1024,
            )
            if result.returncode == 0 and not result.timed_out and not result.output_overflow:
                try:
                    value = result.stdout.decode("utf-8", errors="strict").strip()
                except UnicodeDecodeError:
                    value = ""
                if value and HOST_ID_RE.fullmatch(value) and value not in candidates:
                    candidates.append(value)
        fallback = socket.gethostname().split(".", 1)[0]
        if HOST_ID_RE.fullmatch(fallback) and fallback not in candidates:
            candidates.append(fallback)
        if not candidates:
            raise ControllerError("unable to determine a bounded macOS host id")
        return tuple(candidates)

    def machine_identity_sha256(self) -> str:
        result = self.run(
            ("/usr/sbin/ioreg", "-rd1", "-c", "IOPlatformExpertDevice"),
            timeout=5.0,
            output_limit=64 * 1024,
        )
        _require_success(result, "macOS platform identity query")
        matches = PLATFORM_UUID_RE.findall(result.stdout)
        if len(matches) != 1:
            raise ControllerError("macOS platform identity query was ambiguous")
        normalized = matches[0].lower()
        return hashlib.sha256(b"macos-platform-uuid-v1\0" + normalized).hexdigest()

    def run(
        self,
        argv: Sequence[str],
        *,
        timeout: float,
        output_limit: int,
        before_spawn: Optional[Callable[[], None]] = None,
    ) -> CommandResult:
        return _run_bounded_process(
            argv,
            timeout=timeout,
            output_limit=output_limit,
            before_spawn=before_spawn,
        )


class _ManagedProcessSignal(BaseException):
    def __init__(self, signum: int) -> None:
        self.signum = signum
        super().__init__(signum)


class _ProcessStatusTimeout(ControllerError):
    pass


@dataclass
class _ProcessOwnership:
    state: str = "unlaunched"
    expected_returncode: Optional[int] = None
    identity_lost: bool = False
    identity_lost_reason: Optional[str] = None

    def bind(self) -> None:
        if self.state != "unlaunched":
            raise RuntimeError(f"cannot bind process ownership from {self.state!r}")
        self.state = "group-owned"

    def transfer_to_reap(self, returncode: Optional[int]) -> None:
        if self.state != "group-owned":
            raise RuntimeError(f"cannot transfer process ownership from {self.state!r}")
        self.expected_returncode = returncode
        self.state = "reap-only"

    def release(self) -> None:
        if self.state != "reap-only":
            raise RuntimeError(f"cannot release process ownership from {self.state!r}")
        self.state = "released"

    def lose_identity(self, reason: str) -> None:
        if not self.identity_lost:
            self.identity_lost = True
            self.identity_lost_reason = reason


@dataclass
class _ProcessStatusObserver:
    queue: Optional[Any] = None
    exit_observed: bool = False
    returncode: Optional[int] = None


@dataclass(frozen=True)
class _ProcessSignalResult:
    target_existed: bool
    error: Optional[str] = None


@dataclass(frozen=True)
class _ProcessCleanupReceipt:
    returncode: Optional[int]
    group_absent: bool
    pipes_drained: bool
    child_reaped: bool
    issues: Tuple[str, ...] = ()

    @property
    def complete(self) -> bool:
        return (
            self.group_absent
            and self.pipes_drained
            and self.child_reaped
            and self.returncode is not None
            and not self.issues
        )


class _ProcessSignalLatch:
    def __init__(self) -> None:
        self.pending: Optional[int] = None
        self.previous: Dict[int, Any] = {}

    def _handle(self, signum: int, _frame: Any) -> None:
        if self.pending is None:
            self.pending = signum

    def install(self) -> None:
        try:
            for signum in MANAGED_PROCESS_SIGNALS:
                self.previous[signum] = signal.getsignal(signum)
                signal.signal(signum, self._handle)
        except BaseException:
            self.restore()
            raise

    def restore(self) -> List[str]:
        issues: List[str] = []
        for signum, handler in reversed(tuple(self.previous.items())):
            try:
                signal.signal(signum, handler)
            except BaseException as error:
                issues.append(f"failed to restore signal {signum}: {error}")
        self.previous.clear()
        return issues

    def raise_if_pending(self) -> None:
        if self.pending is not None:
            raise _ManagedProcessSignal(self.pending)


class _DarwinSigaction(ctypes.Structure):
    _fields_ = (
        ("handler", ctypes.c_void_p),
        ("mask", ctypes.c_uint32),
        ("flags", ctypes.c_int),
    )


def _waitable_sigchld_failure() -> Optional[str]:
    if os.name != "posix":
        return "POSIX process-group supervision is required"
    try:
        handler = signal.getsignal(signal.SIGCHLD)
    except (AttributeError, OSError, ValueError) as error:
        return f"cannot inspect SIGCHLD disposition: {error}"
    if handler == signal.SIG_IGN:
        return "SIGCHLD is ignored and direct children may be auto-reaped"
    if handler != signal.SIG_DFL:
        return "SIGCHLD has a custom handler that may reap direct children"
    if sys.platform != "darwin":
        return None
    try:
        library = ctypes.CDLL(None, use_errno=True)
        sigaction = library.sigaction
        sigaction.argtypes = (
            ctypes.c_int,
            ctypes.POINTER(_DarwinSigaction),
            ctypes.POINTER(_DarwinSigaction),
        )
        sigaction.restype = ctypes.c_int
        action = _DarwinSigaction()
        ctypes.set_errno(0)
        if sigaction(int(signal.SIGCHLD), None, ctypes.byref(action)) != 0:
            error_number = ctypes.get_errno() or errno.EINVAL
            return f"cannot inspect Darwin SIGCHLD disposition: {os.strerror(error_number)}"
    except (AttributeError, OSError) as error:
        return f"Darwin SIGCHLD disposition inspection is unavailable: {error}"
    if int(action.handler or 0) != 0:
        return "Darwin SIGCHLD has a non-default native handler"
    if int(action.flags) & DARWIN_SA_NOCLDWAIT:
        return "Darwin SIGCHLD has SA_NOCLDWAIT"
    return None


def _waitid_available() -> bool:
    return all(
        callable(getattr(os, name, None)) if name == "waitid" else hasattr(os, name)
        for name in ("waitid", "WNOWAIT", "WEXITED", "WNOHANG", "P_PID")
    )


def _darwin_status_observer_available() -> bool:
    return sys.platform == "darwin" and all(
        hasattr(select, name)
        for name in (
            "kqueue",
            "kevent",
            "KQ_FILTER_PROC",
            "KQ_EV_ADD",
            "KQ_EV_ENABLE",
            "KQ_EV_ONESHOT",
            "KQ_EV_ERROR",
            "KQ_NOTE_EXIT",
        )
    )


def _require_process_supervision_support() -> None:
    failure = _waitable_sigchld_failure()
    if failure is not None:
        raise ControllerError(f"bounded process supervision unavailable: {failure}")
    if not _waitid_available() and not _darwin_status_observer_available():
        raise ControllerError(
            "bounded process supervision requires waitid/WNOWAIT or Darwin kqueue"
        )


def _register_process_status_observer(
    process: subprocess.Popen[bytes],
    observer: Optional[_ProcessStatusObserver] = None,
) -> _ProcessStatusObserver:
    if observer is None:
        observer = _ProcessStatusObserver()
    if _waitid_available():
        return observer
    queue = select.kqueue()
    observer.queue = queue
    try:
        change = select.kevent(
            process.pid,
            filter=select.KQ_FILTER_PROC,
            flags=(select.KQ_EV_ADD | select.KQ_EV_ENABLE | select.KQ_EV_ONESHOT),
            fflags=select.KQ_NOTE_EXIT,
        )
        queue.control([change], 0, 0)
    except ProcessLookupError:
        failure = _waitable_sigchld_failure()
        if failure is not None:
            queue.close()
            observer.queue = None
            raise ControllerError(
                f"direct child identity was lost after launch: {failure}"
            )
        queue.close()
        observer.queue = None
        observer.exit_observed = True
    except BaseException:
        queue.close()
        observer.queue = None
        raise
    return observer


def _waitid_returncode(result: Any) -> int:
    if result.si_code == os.CLD_EXITED:
        return int(result.si_status)
    if result.si_code in (os.CLD_KILLED, os.CLD_DUMPED):
        return -int(result.si_status)
    raise ControllerError(f"unexpected direct-child status code {result.si_code!r}")


def _observe_process_exit_without_reaping(
    process: subprocess.Popen[bytes],
    observer: _ProcessStatusObserver,
    deadline: float,
    *,
    cancel: Optional[Callable[[], None]] = None,
) -> Optional[int]:
    if cancel is not None:
        cancel()
    if observer.exit_observed:
        return observer.returncode
    while True:
        failure = _waitable_sigchld_failure()
        if failure is not None:
            raise ControllerError(f"waitable child identity changed: {failure}")
        if _waitid_available():
            try:
                result = os.waitid(
                    os.P_PID,
                    process.pid,
                    os.WEXITED | os.WNOHANG | os.WNOWAIT,
                )
            except ChildProcessError as error:
                raise ControllerError(
                    "direct child identity was lost before group cleanup"
                ) from error
            except InterruptedError:
                result = None
            if result is not None:
                if int(result.si_pid) != process.pid:
                    raise ControllerError("direct-child status identity mismatch")
                observer.exit_observed = True
                observer.returncode = _waitid_returncode(result)
        else:
            if observer.queue is None:
                raise ControllerError("Darwin child-status observer is unavailable")
            remaining = max(0.0, deadline - time.monotonic())
            try:
                events = observer.queue.control(
                    None,
                    1,
                    min(remaining, PROCESS_SELECTOR_POLL_SECONDS),
                )
            except InterruptedError:
                events = []
            if events:
                event = events[0]
                if int(event.flags) & int(select.KQ_EV_ERROR):
                    error_number = int(event.data) or errno.EIO
                    raise ControllerError(
                        "Darwin child-status observer failed: "
                        + os.strerror(error_number)
                    )
                if (
                    int(event.ident) != process.pid
                    or int(event.filter) != int(select.KQ_FILTER_PROC)
                    or not (int(event.fflags) & int(select.KQ_NOTE_EXIT))
                ):
                    raise ControllerError("Darwin child-status identity mismatch")
                observer.exit_observed = True
        # Preserve an exit status obtained by this probe before surfacing a
        # signal that arrived after pipe EOF. Cleanup can then stay reap-only.
        if cancel is not None:
            cancel()
        if observer.exit_observed:
            return observer.returncode
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise _ProcessStatusTimeout("direct child did not exit before deadline")
        time.sleep(min(PROCESS_STATUS_POLL_SECONDS, remaining))


def _linux_group_has_live_nonleader(
    pgid: int,
    deadline: float,
) -> Tuple[bool, Optional[str]]:
    scanned = 0
    try:
        entries = os.scandir("/proc")
    except OSError as error:
        return True, f"cannot enumerate Linux process metadata: {error}"
    try:
        with entries:
            for entry in entries:
                if not entry.name.isascii() or not entry.name.isdigit():
                    continue
                scanned += 1
                if scanned > MAX_LINUX_PROCESS_SCAN_ENTRIES:
                    return True, "Linux process-group scan exceeded its entry limit"
                if time.monotonic() >= deadline:
                    return True, None
                pid = int(entry.name)
                if pid == pgid:
                    continue
                try:
                    with open(
                        f"/proc/{entry.name}/stat", "rb", buffering=0
                    ) as handle:
                        payload = handle.read(MAX_LINUX_PROCESS_STAT_BYTES + 1)
                except FileNotFoundError:
                    continue
                except OSError as error:
                    return True, f"cannot read Linux process metadata: {error}"
                if len(payload) > MAX_LINUX_PROCESS_STAT_BYTES:
                    return True, "Linux process metadata exceeded its byte limit"
                command_end = payload.rfind(b")")
                if command_end < 0:
                    return True, "malformed Linux process metadata"
                fields = payload[command_end + 2 :].split()
                if len(fields) < 3:
                    return True, "malformed Linux process metadata"
                try:
                    member_pgid = int(fields[2])
                except ValueError:
                    return True, "malformed Linux process-group metadata"
                if member_pgid == pgid and fields[0] not in (b"Z", b"X", b"x"):
                    return True, None
    except OSError as error:
        return True, f"Linux process-group scan failed: {error}"
    return False, None


def _call_darwin_proc_listpids(
    proc_type: int,
    type_info: int,
    buffer: Any,
    buffer_size: int,
) -> Tuple[int, int]:
    libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    proc_listpids = libproc.proc_listpids
    proc_listpids.argtypes = (
        ctypes.c_uint32,
        ctypes.c_uint32,
        ctypes.c_void_p,
        ctypes.c_int,
    )
    proc_listpids.restype = ctypes.c_int
    ctypes.set_errno(0)
    byte_count = int(
        proc_listpids(
            proc_type,
            type_info,
            ctypes.cast(buffer, ctypes.c_void_p),
            buffer_size,
        )
    )
    return byte_count, ctypes.get_errno()


def _darwin_process_group_census(
    pgid: int,
    deadline: float,
) -> Tuple[Optional[Tuple[int, ...]], Optional[str]]:
    if time.monotonic() >= deadline:
        return None, "Darwin process-group census deadline expired"
    pid_type = ctypes.c_int
    pid_size = ctypes.sizeof(pid_type)
    capacity = MAX_DARWIN_PROCESS_GROUP_PIDS + 1
    buffer = (pid_type * capacity)()
    buffer_size = ctypes.sizeof(buffer)
    try:
        byte_count, error_number = _call_darwin_proc_listpids(
            DARWIN_PROC_PGRP_ONLY,
            pgid,
            buffer,
            buffer_size,
        )
    except BaseException as error:
        return None, f"Darwin process-group census failed: {error}"
    if time.monotonic() >= deadline:
        return None, "Darwin process-group census exceeded its deadline"
    if byte_count <= 0:
        detail = os.strerror(error_number) if error_number else "no identities returned"
        return None, f"Darwin process-group census failed: {detail}"
    if byte_count >= buffer_size:
        return None, "Darwin process-group census may be truncated"
    if byte_count % pid_size:
        return None, "Darwin process-group census returned misaligned identities"
    members = tuple(int(buffer[index]) for index in range(byte_count // pid_size))
    if (
        not members
        or any(pid <= 0 for pid in members)
        or len(set(members)) != len(members)
        or pgid not in members
    ):
        return None, "Darwin process-group census identity anomaly"
    return tuple(sorted(members)), None


def _darwin_group_has_live_nonleader(
    pgid: int,
    deadline: float,
) -> Tuple[bool, Optional[str]]:
    first, error = _darwin_process_group_census(pgid, deadline)
    if error is not None:
        return True, error
    second, error = _darwin_process_group_census(pgid, deadline)
    if error is not None:
        return True, error
    if first != second:
        return True, "Darwin process-group census identities changed"
    if first == (pgid,):
        # The kqueue NOTE_EXIT observation pins the unreaped zombie leader.
        # Seeing only that identity proves no signalable descendant remains.
        return False, None
    return True, None


def _bound_process_group_exists(
    process: subprocess.Popen[bytes],
    *,
    leader_exited: bool,
    deadline: float,
) -> Tuple[bool, Optional[str]]:
    failure = _waitable_sigchld_failure()
    if failure is not None:
        return True, f"waitable child identity changed: {failure}"
    if sys.platform.startswith("linux") and leader_exited:
        return _linux_group_has_live_nonleader(process.pid, deadline)
    try:
        os.killpg(process.pid, 0)
    except ProcessLookupError:
        return False, None
    except PermissionError as error:
        if (
            sys.platform == "darwin"
            and leader_exited
            and error.errno == errno.EPERM
        ):
            return _darwin_group_has_live_nonleader(process.pid, deadline)
        # EPERM alone proves neither absence nor quiescence.
        return True, str(error)
    except OSError as error:
        return True, str(error)
    return True, None


def _wait_for_process_group_absence(
    process: subprocess.Popen[bytes],
    deadline: float,
    *,
    leader_exited: bool,
) -> Tuple[bool, Optional[str]]:
    while True:
        exists, error = _bound_process_group_exists(
            process,
            leader_exited=leader_exited,
            deadline=deadline,
        )
        if error is not None or not exists:
            return exists, error
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return True, None
        time.sleep(min(PROCESS_STATUS_POLL_SECONDS, remaining))


def _validate_linux_signal_identity(
    process: subprocess.Popen[bytes],
    ownership: _ProcessOwnership,
) -> Optional[str]:
    if ownership.identity_lost:
        return ownership.identity_lost_reason or "direct child identity was lost"
    if not sys.platform.startswith("linux"):
        return None
    if not _waitid_available():
        reason = "Linux waitid identity validation is unavailable"
        ownership.lose_identity(reason)
        return reason
    try:
        result = os.waitid(
            os.P_PID,
            process.pid,
            os.WEXITED | os.WNOHANG | os.WNOWAIT,
        )
    except ChildProcessError as error:
        reason = f"direct child identity was lost before group signal: {error}"
        ownership.lose_identity(reason)
        return reason
    except OSError as error:
        if error.errno == errno.ECHILD:
            reason = f"direct child identity was lost before group signal: {error}"
        else:
            reason = f"cannot validate direct child identity before group signal: {error}"
        ownership.lose_identity(reason)
        return reason
    except BaseException as error:
        reason = f"cannot validate direct child identity before group signal: {error}"
        ownership.lose_identity(reason)
        return reason
    if result is not None:
        try:
            observed_pid = int(result.si_pid)
        except BaseException as error:
            reason = f"cannot read direct-child signal identity: {error}"
            ownership.lose_identity(reason)
            return reason
        if observed_pid != process.pid:
            reason = "direct-child signal identity mismatch"
            ownership.lose_identity(reason)
            return reason
    return None


def _signal_process_group(
    process: subprocess.Popen[bytes],
    signum: int,
    ownership: _ProcessOwnership,
) -> _ProcessSignalResult:
    identity_error = _validate_linux_signal_identity(process, ownership)
    if identity_error is not None:
        return _ProcessSignalResult(target_existed=True, error=identity_error)
    identity_failure = _waitable_sigchld_failure()
    if identity_failure is not None:
        return _ProcessSignalResult(
            target_existed=True,
            error="waitable child identity changed: " + identity_failure,
        )
    try:
        os.killpg(process.pid, signum)
    except ProcessLookupError:
        return _ProcessSignalResult(target_existed=False)
    except OSError as error:
        return _ProcessSignalResult(target_existed=True, error=str(error))
    return _ProcessSignalResult(target_existed=True)


def _selector_has_stream(selector: selectors.BaseSelector, stream: Any) -> bool:
    return any(key.fileobj is stream for key in selector.get_map().values())


def _register_cleanup_streams(
    process: subprocess.Popen[bytes],
    selector: selectors.BaseSelector,
    eof: set,
) -> List[str]:
    issues: List[str] = []
    for name, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
        if name in eof:
            continue
        if stream is None:
            issues.append(f"{name} pipe is missing")
            continue
        try:
            os.set_blocking(stream.fileno(), False)
            if not _selector_has_stream(selector, stream):
                selector.register(stream, selectors.EVENT_READ, name)
        except BaseException as error:
            issues.append(f"cannot register {name} cleanup drain: {error}")
    return issues


def _drain_process_pipes(
    selector: selectors.BaseSelector,
    eof: set,
    deadline: float,
) -> Tuple[bool, List[str]]:
    issues: List[str] = []
    while eof != {"stdout", "stderr"}:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False, issues
        try:
            events = selector.select(min(remaining, PROCESS_SELECTOR_POLL_SECONDS))
        except BaseException as error:
            issues.append(f"cannot drain process pipes: {error}")
            return False, issues
        if not events:
            continue
        for key, _mask in events:
            name = key.data
            if name not in ("stdout", "stderr"):
                issues.append(f"unexpected cleanup selector entry {name!r}")
                continue
            try:
                chunk = os.read(key.fileobj.fileno(), PROCESS_READ_CHUNK_BYTES)
            except BlockingIOError:
                continue
            except BaseException as error:
                issues.append(f"cannot drain {name}: {error}")
                return False, issues
            if chunk:
                continue
            eof.add(name)
            try:
                selector.unregister(key.fileobj)
            except BaseException as error:
                issues.append(f"cannot unregister drained {name}: {error}")
                return False, issues
    return True, issues


def _terminate_process(
    process: subprocess.Popen[bytes],
    selector: selectors.BaseSelector,
    observer: _ProcessStatusObserver,
    ownership: _ProcessOwnership,
    eof: set,
    *,
    known_returncode: Optional[int] = None,
) -> _ProcessCleanupReceipt:
    """Prove group absence and pipe EOF before the one final leader reap."""

    issues = _register_cleanup_streams(process, selector, eof)
    status_observation_failed = False
    if not _waitid_available() and observer.queue is None and not observer.exit_observed:
        try:
            _register_process_status_observer(process, observer)
        except BaseException as error:
            issues.append(f"cannot restore child-status observation: {error}")
            status_observation_failed = True
    leader_exited = observer.exit_observed or known_returncode is not None
    observed_returncode = known_returncode
    term_deadline = time.monotonic() + PROCESS_TERM_GRACE_SECONDS
    final_deadline = term_deadline + PROCESS_KILL_DRAIN_SECONDS

    try:
        group_exists, probe_error = _bound_process_group_exists(
            process,
            leader_exited=leader_exited,
            deadline=term_deadline,
        )
    except BaseException as error:
        group_exists, probe_error = True, str(error)
    if probe_error is not None:
        issues.append(f"cannot probe process group before SIGTERM: {probe_error}")
    if group_exists:
        term_result = _signal_process_group(process, signal.SIGTERM, ownership)
        if term_result.error is not None:
            issues.append(f"cannot signal process group with SIGTERM: {term_result.error}")
        if not term_result.target_existed:
            group_exists = False

    _drained, drain_issues = _drain_process_pipes(selector, eof, term_deadline)
    issues.extend(drain_issues)
    if not leader_exited:
        try:
            observed_returncode = _observe_process_exit_without_reaping(
                process,
                observer,
                term_deadline,
            )
            leader_exited = True
        except _ProcessStatusTimeout:
            pass
        except BaseException as error:
            issues.append(f"cannot observe direct-child exit after SIGTERM: {error}")
            status_observation_failed = True
    if group_exists:
        try:
            group_exists, probe_error = _wait_for_process_group_absence(
                process,
                term_deadline,
                leader_exited=leader_exited,
            )
        except BaseException as error:
            group_exists, probe_error = True, str(error)
        if probe_error is not None:
            issues.append(f"cannot probe process group after SIGTERM: {probe_error}")
    must_final_kill = (
        sys.platform.startswith("linux") and ownership.state == "group-owned"
    )
    if group_exists or must_final_kill:
        kill_result = _signal_process_group(process, signal.SIGKILL, ownership)
        if kill_result.error is not None:
            issues.append(f"cannot signal process group with SIGKILL: {kill_result.error}")

    pipes_drained, drain_issues = _drain_process_pipes(selector, eof, final_deadline)
    issues.extend(drain_issues)
    try:
        if not observer.exit_observed:
            observed_returncode = _observe_process_exit_without_reaping(
                process,
                observer,
                final_deadline,
            )
        elif observed_returncode is None:
            observed_returncode = observer.returncode
        leader_exited = True
    except BaseException as error:
        issues.append(f"cannot observe direct-child exit without reaping: {error}")
        status_observation_failed = True

    try:
        group_exists, final_probe_error = _wait_for_process_group_absence(
            process,
            final_deadline,
            leader_exited=leader_exited,
        )
    except BaseException as error:
        group_exists, final_probe_error = True, str(error)
    if final_probe_error is not None:
        issues.append(f"cannot prove process-group absence: {final_probe_error}")
    group_absent = not group_exists and final_probe_error is None
    if not group_absent:
        issues.append("process group remained after final signal")
    if not pipes_drained:
        issues.append("process pipes did not reach EOF before cleanup deadline")

    child_reaped = False
    returncode: Optional[int] = None
    if group_absent and pipes_drained and leader_exited:
        ownership.transfer_to_reap(observed_returncode)
        try:
            returncode = process.wait(
                timeout=max(0.0, final_deadline - time.monotonic())
            )
            child_reaped = True
        except subprocess.TimeoutExpired as error:
            issues.append(f"direct child was not reaped: {error}")
        except BaseException as error:
            issues.append(f"cannot reap direct child: {error}")
        if child_reaped:
            if observed_returncode is not None and returncode != observed_returncode:
                issues.append(
                    "direct-child return code changed from "
                    f"{observed_returncode} to {returncode}"
                )
            ownership.release()
    elif status_observation_failed and ownership.state == "group-owned":
        # The final group signal has already happened and no later destructive
        # PGID operation is allowed. Reap the direct child so an observer setup
        # failure cannot leak a zombie, then use only a zero-signal probe. The
        # retained observer issue keeps this receipt inconclusive/quarantined.
        ownership.transfer_to_reap(None)
        reap_deadline = time.monotonic() + PROCESS_REAP_SECONDS
        try:
            returncode = process.wait(
                timeout=max(0.0, reap_deadline - time.monotonic())
            )
            child_reaped = True
        except subprocess.TimeoutExpired as error:
            issues.append(f"direct child was not reaped after observer failure: {error}")
        except BaseException as error:
            issues.append(f"cannot reap direct child after observer failure: {error}")
        if child_reaped:
            ownership.release()
    if child_reaped and os.name == "posix":
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            group_absent = True
        except BaseException as error:
            group_absent = False
            issues.append(f"post-reap zero-signal group probe failed: {error}")
        else:
            group_absent = False
            issues.append("post-reap zero-signal probe found a process group")
    return _ProcessCleanupReceipt(
        returncode=returncode,
        group_absent=group_absent,
        pipes_drained=pipes_drained,
        child_reaped=child_reaped,
        issues=tuple(issues),
    )


def _close_process_resources(
    process: Optional[subprocess.Popen[bytes]],
    selector: Optional[selectors.BaseSelector],
    observer: Optional[_ProcessStatusObserver],
) -> List[str]:
    issues: List[str] = []
    if selector is not None:
        try:
            selector.close()
        except BaseException as error:
            issues.append(f"cannot close process selector: {error}")
    if observer is not None and observer.queue is not None:
        try:
            observer.queue.close()
        except BaseException as error:
            issues.append(f"cannot close process status observer: {error}")
    if process is not None:
        for name in ("stdout", "stderr"):
            stream = getattr(process, name, None)
            if stream is None:
                continue
            try:
                stream.close()
            except BaseException as error:
                issues.append(f"cannot close process {name}: {error}")
    return issues


def _run_bounded_process(
    argv: Sequence[str],
    *,
    timeout: float,
    output_limit: int,
    before_spawn: Optional[Callable[[], None]] = None,
) -> CommandResult:
    if not argv or any(not isinstance(value, str) or not value for value in argv):
        raise ControllerError("command argv must contain non-empty strings")
    if timeout <= 0 or output_limit <= 0:
        raise ControllerError("command bounds must be positive")
    command = list(argv)
    output: Dict[str, bytearray] = {"stdout": bytearray(), "stderr": bytearray()}
    deadline = time.monotonic() + timeout
    _require_process_supervision_support()
    latch = _ProcessSignalLatch()
    ownership = _ProcessOwnership()
    process: Optional[subprocess.Popen[bytes]] = None
    selector: Optional[selectors.BaseSelector] = None
    observer: Optional[_ProcessStatusObserver] = _ProcessStatusObserver()
    eof: set = set()
    timed_out = False
    overflow = False
    known_returncode: Optional[int] = None
    receipt: Optional[_ProcessCleanupReceipt] = None
    primary: Optional[BaseException] = None
    close_issues: List[str] = []

    try:
        latch.install()
        selector = selectors.DefaultSelector()
        # Avoid spawning when a managed signal was already latched. A signal
        # arriving in the remaining check-to-Popen window is handled by the
        # post-bind check and the owned process-group cleanup path below.
        latch.raise_if_pending()
        if before_spawn is not None:
            before_spawn()
        latch.raise_if_pending()
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=True,
                start_new_session=True,
            )
        except OSError as error:
            raise ControllerError(
                f"failed to start command {command[0]}: {error}"
            ) from error
        ownership.bind()
        latch.raise_if_pending()
        if process.stdout is None or process.stderr is None:
            raise ControllerError("started command did not provide bounded output pipes")
        observer = _register_process_status_observer(process, observer)
        for name, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, name)

        while eof != {"stdout", "stderr"}:
            latch.raise_if_pending()
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            events = selector.select(min(remaining, PROCESS_SELECTOR_POLL_SECONDS))
            for key, _mask in events:
                latch.raise_if_pending()
                try:
                    chunk = os.read(key.fileobj.fileno(), PROCESS_READ_CHUNK_BYTES)
                except BlockingIOError:
                    continue
                if not chunk:
                    eof.add(key.data)
                    selector.unregister(key.fileobj)
                    continue
                bucket = output[key.data]
                total_output = len(output["stdout"]) + len(output["stderr"])
                if total_output + len(chunk) > output_limit:
                    keep = max(0, output_limit - total_output)
                    bucket.extend(chunk[:keep])
                    overflow = True
                    break
                bucket.extend(chunk)
            if overflow:
                break
        if not timed_out and not overflow:
            try:
                known_returncode = _observe_process_exit_without_reaping(
                    process,
                    observer,
                    deadline,
                    cancel=latch.raise_if_pending,
                )
            except _ProcessStatusTimeout:
                timed_out = True
        receipt = _terminate_process(
            process,
            selector,
            observer,
            ownership,
            eof,
            known_returncode=known_returncode,
        )
        latch.raise_if_pending()
    except BaseException as error:
        primary = error
    finally:
        if process is not None and ownership.state == "unlaunched":
            ownership.bind()
        if (
            process is not None
            and selector is not None
            and observer is not None
            and receipt is None
            and ownership.state == "group-owned"
        ):
            try:
                receipt = _terminate_process(
                    process,
                    selector,
                    observer,
                    ownership,
                    eof,
                )
            except BaseException as cleanup_error:
                close_issues.append(f"process cleanup raised: {cleanup_error}")
        close_issues.extend(_close_process_resources(process, selector, observer))
        close_issues.extend(latch.restore())

    cleanup_details: List[str] = []
    if process is not None:
        if receipt is None:
            cleanup_details.append("process cleanup produced no receipt")
        elif not receipt.complete:
            cleanup_details.extend(receipt.issues)
            if not receipt.group_absent:
                cleanup_details.append("process-group absence was not proved")
            if not receipt.pipes_drained:
                cleanup_details.append("process pipe EOF was not proved")
            if not receipt.child_reaped:
                cleanup_details.append("direct child was not reaped")
    cleanup_details.extend(close_issues)
    if cleanup_details:
        error = ProcessCleanupInconclusiveError(
            "bounded process cleanup was inconclusive: " + "; ".join(cleanup_details)
        )
        if primary is not None:
            raise error from primary
        raise error
    if primary is not None:
        raise primary.with_traceback(primary.__traceback__)
    if latch.pending is not None:
        raise _ManagedProcessSignal(latch.pending)
    if receipt is None or receipt.returncode is None:
        raise ProcessCleanupInconclusiveError(
            "bounded process cleanup did not provide a final return code"
        )
    return CommandResult(
        receipt.returncode,
        bytes(output["stdout"]),
        bytes(output["stderr"]),
        timed_out=timed_out,
        output_overflow=overflow,
    )


def _duplicate_rejecting_object(pairs: List[Tuple[str, Any]]) -> Dict[str, Any]:
    result: Dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def _reject_json_constant(raw: str) -> Any:
    raise ValueError(f"non-standard JSON constant: {raw}")


def _bounded_json(payload: bytes, label: str) -> Any:
    try:
        text = payload.decode("utf-8", errors="strict")
        return json.loads(
            text,
            object_pairs_hook=_duplicate_rejecting_object,
            parse_constant=_reject_json_constant,
        )
    except (UnicodeDecodeError, ValueError, RecursionError) as error:
        raise ControllerError(f"invalid {label} JSON: {error}") from error


def _canonical_json_bytes(value: Any) -> bytes:
    try:
        return (
            json.dumps(
                value,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=True,
                allow_nan=False,
            ).encode("ascii")
            + b"\n"
        )
    except (TypeError, ValueError, RecursionError) as error:
        raise ControllerError(f"failed to encode bounded JSON: {error}") from error


def _require_exact_keys(value: Mapping[str, Any], expected: Sequence[str], label: str) -> None:
    actual = set(value)
    wanted = set(expected)
    if actual != wanted:
        unknown = sorted(actual - wanted)
        missing = sorted(wanted - actual)
        details: List[str] = []
        if unknown:
            details.append("unknown=" + ",".join(unknown))
        if missing:
            details.append("missing=" + ",".join(missing))
        raise ControllerError(f"{label} fields are invalid ({'; '.join(details)})")


def _validate_host_id(value: Any, label: str) -> str:
    if not isinstance(value, str) or HOST_ID_RE.fullmatch(value) is None:
        raise ControllerError(f"{label} must be a bounded host id")
    return value


def _validate_username(value: Any, label: str) -> str:
    if not isinstance(value, str) or USERNAME_RE.fullmatch(value) is None:
        raise ControllerError(f"{label} must be a bounded account name")
    return value


def _validate_home(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value or "\x00" in value:
        raise ControllerError(f"{label} must be an absolute path")
    try:
        encoded = value.encode("utf-8", errors="strict")
    except UnicodeEncodeError as error:
        raise ControllerError(f"{label} must contain valid UTF-8") from error
    if len(encoded) > 1024:
        raise ControllerError(f"{label} exceeds 1024 UTF-8 bytes")
    path = PurePosixPath(value)
    if not path.is_absolute() or ".." in path.parts or "." in path.parts:
        raise ControllerError(f"{label} must be a normalized absolute path")
    return value


def _parse_host_entry(raw: Any, index: int) -> HostEntry:
    if not isinstance(raw, dict):
        raise ControllerError(f"inventory host #{index} must be an object")
    role = raw.get("role")
    if role not in ROLES:
        raise ControllerError(f"inventory host #{index} has unsupported role")
    common = ("id", "role", "username", "uid", "home")
    if role == "headless-managed":
        expected = common + ("controller", "ssh_alias")
    else:
        expected = common
    _require_exact_keys(raw, expected, f"inventory host #{index}")
    host_id = _validate_host_id(raw["id"], f"inventory host #{index} id")
    username = _validate_username(raw["username"], f"inventory host {host_id} username")
    uid = raw["uid"]
    if type(uid) is not int or uid < 0 or uid > 2**31 - 1:
        raise ControllerError(f"inventory host {host_id} uid is invalid")
    home = _validate_home(raw["home"], f"inventory host {host_id} home")
    if role == "gui-controller":
        return HostEntry(host_id, role, username, uid, home)
    if role == "headless-managed":
        controller = _validate_host_id(
            raw["controller"], f"inventory headless host {host_id} controller"
        )
        ssh_alias = _validate_host_id(
            raw["ssh_alias"], f"inventory headless host {host_id} ssh alias"
        )
        if controller == host_id:
            raise ControllerError(f"inventory headless host {host_id} controls itself")
        return HostEntry(
            host_id,
            role,
            username,
            uid,
            home,
            controller=controller,
            ssh_alias=ssh_alias,
        )
    return HostEntry(host_id, role, username, uid, home)


def _parse_inventory(payload: bytes) -> Inventory:
    raw = _bounded_json(payload, "private host inventory")
    if not isinstance(raw, dict):
        raise ControllerError("private host inventory must be an object")
    _require_exact_keys(raw, ("version", "hosts"), "private host inventory")
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("private host inventory version must be 1")
    raw_hosts = raw["hosts"]
    if not isinstance(raw_hosts, list) or not raw_hosts or len(raw_hosts) > MAX_HOSTS:
        raise ControllerError("private host inventory hosts are invalid")
    entries = [_parse_host_entry(item, index) for index, item in enumerate(raw_hosts, 1)]
    hosts: Dict[str, HostEntry] = {}
    aliases: Dict[str, str] = {}
    portable_host_ids: Dict[str, str] = {}
    portable_aliases: Dict[str, str] = {}
    for entry in entries:
        if entry.host_id in hosts:
            raise ControllerError(f"duplicate inventory host id: {entry.host_id}")
        portable_id = entry.host_id.casefold()
        previous_portable_id = portable_host_ids.get(portable_id)
        if previous_portable_id is not None:
            raise ControllerError(
                "portable duplicate inventory host ids: "
                f"{previous_portable_id}, {entry.host_id}"
            )
        portable_host_ids[portable_id] = entry.host_id
        hosts[entry.host_id] = entry
        if entry.ssh_alias is not None:
            previous = aliases.get(entry.ssh_alias)
            if previous is not None:
                raise ControllerError(
                    f"duplicate inventory ssh alias {entry.ssh_alias}: {previous}, {entry.host_id}"
                )
            aliases[entry.ssh_alias] = entry.host_id
            portable_alias = entry.ssh_alias.casefold()
            previous_portable_alias = portable_aliases.get(portable_alias)
            if previous_portable_alias is not None:
                raise ControllerError(
                    "portable duplicate inventory ssh aliases: "
                    f"{previous_portable_alias}, {entry.ssh_alias}"
                )
            portable_aliases[portable_alias] = entry.ssh_alias
    derived_targets: Dict[str, List[str]] = {}
    for entry in entries:
        if entry.role != "headless-managed":
            continue
        controller = hosts.get(entry.controller or "")
        if controller is None or controller.role != "gui-controller":
            raise ControllerError(
                f"inventory headless host {entry.host_id} has invalid controller"
            )
        targets = derived_targets.setdefault(controller.host_id, [])
        if len(targets) >= MAX_TARGETS:
            raise ControllerError(
                f"inventory controller {controller.host_id} exceeds {MAX_TARGETS} targets"
            )
        targets.append(entry.host_id)
    for controller_id, targets in derived_targets.items():
        hosts[controller_id] = replace(hosts[controller_id], targets=tuple(targets))
    for entry in entries:
        if entry.role == "gui-controller" and entry.host_id not in derived_targets:
            raise ControllerError(
                f"inventory controller has no headless target: {entry.host_id}"
            )
    return Inventory(hosts=hosts)


def _metadata_identity(
    metadata: os.stat_result,
) -> Tuple[int, int, int, int, int, int]:
    # Bind object identity plus the selected access policy. Timestamps are not a
    # protected property: benign reads or directory churn may change metadata
    # without replacing content, the object, or its owner/group/mode policy.
    return (
        metadata.st_dev,
        metadata.st_ino,
        stat.S_IFMT(metadata.st_mode),
        stat.S_IMODE(metadata.st_mode),
        metadata.st_uid,
        metadata.st_gid,
    )


def _raise_access_policy_error(
    error_type: Any,
    label: str,
    detail: str,
) -> None:
    raise error_type(f"{label} extended ACL policy {detail}")


def _darwin_acl_api(error_type: Any, label: str) -> _DarwinAclApi:
    global _DARWIN_ACL_API
    try:
        if _DARWIN_ACL_API is None:
            _DARWIN_ACL_API = _DarwinAclApi()
        return _DARWIN_ACL_API
    except (AttributeError, OSError, TypeError, ValueError) as error:
        _raise_access_policy_error(
            error_type,
            label,
            f"could not be verified: Darwin ACL API unavailable: {error}",
        )
    raise AssertionError("unreachable")


def _access_policy_property(metadata: os.stat_result) -> Tuple[int, ...]:
    """Return the descriptor identity and metadata-backed access policy.

    Device, inode, and file type bind the object. The complete mode, owner UID,
    and group GID bind the metadata portion of its access policy. A regular
    file's link count binds the single-link property checked by every caller;
    directory link counts are excluded because ordinary child-entry churn can
    change them. Timestamps are change signals, not protected policy.
    """
    file_type = stat.S_IFMT(metadata.st_mode)
    return (
        metadata.st_dev,
        metadata.st_ino,
        file_type,
        metadata.st_mode,
        metadata.st_uid,
        metadata.st_gid,
        metadata.st_nlink if stat.S_ISREG(file_type) else 0,
    )


def _access_policy_sample(metadata: os.stat_result) -> Tuple[int, ...]:
    """Return one coherence sample for access-policy validation."""
    return _access_policy_property(metadata) + (metadata.st_ctime_ns,)


def _read_darwin_fd_acl_policy(
    fd: int,
    uid: int,
    label: str,
    api: _DarwinAclApi,
    error_type: Any,
) -> Optional[str]:
    """Return an unsafe-policy detail, or ``None`` for a safe ACL snapshot."""
    ctypes.set_errno(0)
    try:
        acl = api.acl_get_fd_np(fd, DARWIN_ACL_TYPE_EXTENDED)
    except (OSError, TypeError, ValueError, ctypes.ArgumentError) as error:
        _raise_access_policy_error(
            error_type,
            label,
            f"could not be verified: acl_get_fd_np failed: {error}",
        )
    if not acl:
        error_number = ctypes.get_errno()
        if error_number == errno.ENOENT:
            return None
        _raise_access_policy_error(
            error_type,
            label,
            "could not be verified: acl_get_fd_np returned "
            f"{os.strerror(error_number) if error_number else 'unknown error'}",
        )
    unsafe_detail: Optional[str] = None
    try:
        ctypes.set_errno(0)
        if api.acl_valid(acl) != 0:
            error_number = ctypes.get_errno()
            _raise_access_policy_error(
                error_type,
                label,
                "could not be verified: acl_valid returned "
                f"{os.strerror(error_number) if error_number else 'unknown error'}",
            )
        owner_uuid = (ctypes.c_ubyte * 16)()
        owner_result = api.mbr_uid_to_uuid(ctypes.c_uint32(uid), owner_uuid)
        if owner_result != 0:
            _raise_access_policy_error(
                error_type,
                label,
                "could not be verified: mbr_uid_to_uuid returned "
                f"{os.strerror(owner_result) if owner_result > 0 else 'unknown error'}",
            )
        owner_uuid_bytes = bytes(owner_uuid)
        entry_id = DARWIN_ACL_FIRST_ENTRY
        entry_count = 0
        while True:
            entry = ctypes.c_void_p()
            ctypes.set_errno(0)
            entry_result = api.acl_get_entry(acl, entry_id, ctypes.byref(entry))
            if entry_result == -1 and ctypes.get_errno() == errno.EINVAL:
                break
            if entry_result != 0 or not entry.value:
                error_number = ctypes.get_errno()
                _raise_access_policy_error(
                    error_type,
                    label,
                    "could not be verified: acl_get_entry returned "
                    f"{os.strerror(error_number) if error_number else entry_result}",
                )
            entry_count += 1
            if entry_count > DARWIN_ACL_MAX_ENTRIES:
                _raise_access_policy_error(
                    error_type,
                    label,
                    "could not be verified: extended ACL exceeds the Darwin entry limit",
                )
            tag = ctypes.c_int()
            ctypes.set_errno(0)
            if api.acl_get_tag_type(entry, ctypes.byref(tag)) != 0:
                error_number = ctypes.get_errno()
                _raise_access_policy_error(
                    error_type,
                    label,
                    "could not be verified: acl_get_tag_type returned "
                    f"{os.strerror(error_number) if error_number else 'unknown error'}",
                )
            if tag.value == DARWIN_ACL_EXTENDED_DENY:
                entry_id = DARWIN_ACL_NEXT_ENTRY
                continue
            if tag.value != DARWIN_ACL_EXTENDED_ALLOW:
                _raise_access_policy_error(
                    error_type,
                    label,
                    f"could not be verified: unknown ACL tag {tag.value}",
                )
            ctypes.set_errno(0)
            qualifier = api.acl_get_qualifier(entry)
            if not qualifier:
                error_number = ctypes.get_errno()
                _raise_access_policy_error(
                    error_type,
                    label,
                    "could not be verified: acl_get_qualifier returned "
                    f"{os.strerror(error_number) if error_number else 'unknown error'}",
                )
            try:
                qualifier_bytes = ctypes.string_at(qualifier, 16)
            finally:
                ctypes.set_errno(0)
                if api.acl_free(qualifier) != 0:
                    error_number = ctypes.get_errno()
                    _raise_access_policy_error(
                        error_type,
                        label,
                        "could not be verified: qualifier acl_free returned "
                        f"{os.strerror(error_number) if error_number else 'unknown error'}",
                    )
            if not secrets.compare_digest(qualifier_bytes, owner_uuid_bytes):
                unsafe_detail = "grants a non-owner ALLOW entry"
                break
            entry_id = DARWIN_ACL_NEXT_ENTRY
    finally:
        ctypes.set_errno(0)
        if api.acl_free(acl) != 0:
            error_number = ctypes.get_errno()
            _raise_access_policy_error(
                error_type,
                label,
                "could not be verified: acl_free returned "
                f"{os.strerror(error_number) if error_number else 'unknown error'}",
            )
    return unsafe_detail


def _validate_fd_access_policy(
    fd: int,
    uid: int,
    label: str,
    *,
    error_type: Any = ControllerError,
) -> Tuple[int, str]:
    """Bind expected UID and reject unsafe link or Darwin ACL policy.

    The semantic result deliberately does not fingerprint entry order, DENY
    entries, or owner-only ALLOW details. Safe ACL churn is benign; every
    critical boundary instead re-evaluates the same bound descriptor and fails
    closed if the policy becomes unsafe or unverifiable.
    """
    binding = (uid, "expected-owner-and-no-nonowner-allow-v1")
    # Darwin-only symbols must never be resolved on another platform.
    if sys.platform != "darwin":
        try:
            metadata = os.fstat(fd)
        except OSError as error:
            _raise_access_policy_error(
                error_type,
                label,
                f"could not be verified: descriptor is unreadable: {error}",
            )
        if metadata.st_uid != uid:
            _raise_access_policy_error(
                error_type,
                label,
                f"mismatched expected owner uid {uid}",
            )
        return binding
    if uid < 0 or uid > 0xFFFFFFFF:
        _raise_access_policy_error(
            error_type,
            label,
            "could not be verified: owner uid is outside Darwin uid_t",
        )
    api = _darwin_acl_api(error_type, label)
    initial_property: Optional[Tuple[int, ...]] = None
    for attempt in range(2):
        try:
            before = os.fstat(fd)
        except OSError as error:
            _raise_access_policy_error(
                error_type,
                label,
                f"could not be verified: descriptor is unreadable: {error}",
            )
        if initial_property is None:
            initial_property = _access_policy_property(before)
        unsafe_detail = _read_darwin_fd_acl_policy(
            fd,
            uid,
            label,
            api,
            error_type,
        )
        try:
            after = os.fstat(fd)
        except OSError as error:
            _raise_access_policy_error(
                error_type,
                label,
                f"could not be verified: descriptor is unreadable: {error}",
            )
        if _access_policy_sample(before) != _access_policy_sample(after):
            if attempt == 0:
                continue
            _raise_access_policy_error(
                error_type,
                label,
                "could not be verified: descriptor changed during validation",
            )
        if _access_policy_property(after) != initial_property:
            _raise_access_policy_error(
                error_type,
                label,
                "could not be verified: descriptor access policy changed during validation",
            )
        if after.st_uid != uid:
            _raise_access_policy_error(
                error_type,
                label,
                f"mismatched expected owner uid {uid}",
            )
        if stat.S_ISREG(after.st_mode) and after.st_nlink != 1:
            _raise_access_policy_error(
                error_type,
                label,
                "has unsafe regular-file link count",
            )
        if unsafe_detail is not None:
            _raise_access_policy_error(error_type, label, unsafe_detail)
        return binding
    raise AssertionError("unreachable")


def _directory_metadata_is_safe(
    metadata: os.stat_result,
    uid: int,
    exact_mode: Optional[int],
) -> bool:
    mode = stat.S_IMODE(metadata.st_mode)
    return (
        stat.S_ISDIR(metadata.st_mode)
        and metadata.st_uid == uid
        and not mode & 0o022
        and (exact_mode is None or mode == exact_mode)
    )


@contextmanager
def _open_bound_owned_directory(
    path: Path,
    uid: int,
    *,
    exact_mode: Optional[int] = None,
    parent_fd: Optional[int] = None,
    name: Optional[str] = None,
) -> Iterator[Tuple[os.stat_result, int]]:
    if (parent_fd is None) != (name is None):
        raise ControllerError("bound directory parent and name must be supplied together")

    def named_metadata() -> os.stat_result:
        if parent_fd is None:
            return path.lstat()
        return os.stat(name or "", dir_fd=parent_fd, follow_symlinks=False)

    try:
        named_before = named_metadata()
    except OSError as error:
        raise ControllerError(f"directory is missing or unreadable: {path}: {error}") from error
    if stat.S_ISLNK(named_before.st_mode) or not stat.S_ISDIR(named_before.st_mode):
        raise ControllerError(f"refusing non-directory or symlink path: {path}")
    mode = stat.S_IMODE(named_before.st_mode)
    if named_before.st_uid != uid or mode & 0o022:
        raise ControllerError(f"directory access policy is unsafe: {path}")
    if exact_mode is not None and mode != exact_mode:
        raise ControllerError(f"directory mode must be {exact_mode:04o}: {path}")
    flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        if parent_fd is None:
            fd = os.open(path, flags)
        else:
            fd = os.open(name or "", flags, dir_fd=parent_fd)
    except OSError as error:
        raise ControllerError(f"directory is missing or unreadable: {path}: {error}") from error
    binding_ready = False
    try:
        opened_before = os.fstat(fd)
        if (
            not _directory_metadata_is_safe(opened_before, uid, exact_mode)
            or _metadata_identity(opened_before) != _metadata_identity(named_before)
        ):
            raise ControllerError(f"directory identity or access policy is unsafe: {path}")
        access_policy = _validate_fd_access_policy(fd, uid, f"directory {path}")
        binding_ready = True
        try:
            yield opened_before, fd
        finally:
            if binding_ready:
                try:
                    opened_after = os.fstat(fd)
                    named_after = named_metadata()
                except OSError as error:
                    raise ControllerError(
                        f"directory binding is unreadable after use: {path}: {error}"
                    ) from error
                if (
                    not _directory_metadata_is_safe(opened_after, uid, exact_mode)
                    or _metadata_identity(opened_before) != _metadata_identity(opened_after)
                    or _metadata_identity(opened_before) != _metadata_identity(named_after)
                ):
                    raise ControllerError(
                        f"directory identity or access policy changed: {path}"
                    )
                if (
                    _validate_fd_access_policy(fd, uid, f"directory {path}")
                    != access_policy
                ):
                    raise ControllerError(
                        f"directory extended ACL policy binding changed: {path}"
                    )
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


def _validate_owned_directory(
    path: Path,
    uid: int,
    *,
    exact_mode: Optional[int] = None,
) -> os.stat_result:
    with _open_bound_owned_directory(path, uid, exact_mode=exact_mode) as (metadata, _fd):
        return metadata


def _read_fd_twice(fd: int, limit: int, label: str) -> bytes:
    def read_once() -> bytes:
        os.lseek(fd, 0, os.SEEK_SET)
        chunks: List[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, min(65536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > limit:
                raise ControllerError(f"{label} exceeds {limit} bytes")
        return b"".join(chunks)

    first = read_once()
    second = read_once()
    if first != second:
        raise ControllerError(f"{label} content changed during bounded read")
    return first


@contextmanager
def _open_bound_current_pointer(
    overlay_fd: int,
    current_path: Path,
    uid: int,
) -> Iterator[str]:
    def named_metadata() -> os.stat_result:
        return os.stat("current", dir_fd=overlay_fd, follow_symlinks=False)

    try:
        before = named_metadata()
        target_before = os.readlink("current", dir_fd=overlay_fd)
    except OSError as error:
        raise ControllerError(f"private current pointer is unreadable: {error}") from error
    if not stat.S_ISLNK(before.st_mode) or before.st_uid != uid:
        raise ControllerError("private current pointer must be a user-owned symlink")
    fd: Optional[int] = None
    access_policy: Optional[Tuple[int, str]] = None
    if sys.platform == "darwin":
        flags = os.O_RDONLY | DARWIN_O_SYMLINK
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            fd = os.open("current", flags, dir_fd=overlay_fd)
        except OSError as error:
            raise ControllerError(
                f"private current pointer descriptor is unreadable: {error}"
            ) from error
    try:
        if fd is not None:
            opened = os.fstat(fd)
            if (
                not stat.S_ISLNK(opened.st_mode)
                or opened.st_uid != uid
                or _metadata_identity(opened) != _metadata_identity(before)
            ):
                raise ControllerError("private current pointer binding is unsafe")
            access_policy = _validate_fd_access_policy(
                fd,
                uid,
                "private current pointer",
            )
        try:
            yield target_before
        finally:
            try:
                after = named_metadata()
                target_after = os.readlink("current", dir_fd=overlay_fd)
            except OSError as error:
                raise ControllerError(
                    "private current pointer changed during inventory read"
                ) from error
            if (
                _metadata_identity(before) != _metadata_identity(after)
                or target_before != target_after
            ):
                raise ControllerError(
                    "private current pointer changed during inventory read"
                )
            if fd is not None:
                opened_after = os.fstat(fd)
                if _metadata_identity(before) != _metadata_identity(opened_after):
                    raise ControllerError(
                        "private current pointer descriptor binding changed"
                    )
                if (
                    _validate_fd_access_policy(
                        fd,
                        uid,
                        "private current pointer",
                    )
                    != access_policy
                ):
                    raise ControllerError(
                        "private current pointer extended ACL policy binding changed"
                    )
    finally:
        if fd is not None:
            os.close(fd)


def _load_current_inventory(home: Path, uid: int) -> InventorySnapshot:
    overlay_root = home / "personal-sync" / "overlays" / PRIVATE_OWNER
    current = overlay_root / "current"
    personal_sync = home / "personal-sync"
    overlays = personal_sync / "overlays"
    releases = overlay_root / "releases"
    with ExitStack() as stack:
        _home_metadata, home_fd = stack.enter_context(
            _open_bound_owned_directory(home, uid)
        )
        _personal_sync_metadata, personal_sync_fd = stack.enter_context(
            _open_bound_owned_directory(
                personal_sync,
                uid,
                parent_fd=home_fd,
                name="personal-sync",
            )
        )
        _overlays_metadata, overlays_fd = stack.enter_context(
            _open_bound_owned_directory(
                overlays,
                uid,
                parent_fd=personal_sync_fd,
                name="overlays",
            )
        )
        _overlay_metadata, overlay_fd = stack.enter_context(
            _open_bound_owned_directory(
                overlay_root,
                uid,
                parent_fd=overlays_fd,
                name=PRIVATE_OWNER,
            )
        )
        target_before = stack.enter_context(
            _open_bound_current_pointer(overlay_fd, current, uid)
        )
        target_path = PurePosixPath(target_before)
        if (
            target_path.is_absolute()
            or len(target_path.parts) != 2
            or target_path.parts[0] != "releases"
            or FULL_SHA_RE.fullmatch(target_path.parts[1]) is None
        ):
            raise ControllerError("private current pointer target is not an exact release")
        release_sha = target_path.parts[1]
        release_root = releases / release_sha
        personal_codex = release_root / "personal_codex"
        _releases_metadata, releases_fd = stack.enter_context(
            _open_bound_owned_directory(
                releases,
                uid,
                parent_fd=overlay_fd,
                name="releases",
            )
        )
        _release_metadata, release_fd = stack.enter_context(
            _open_bound_owned_directory(
                release_root,
                uid,
                parent_fd=releases_fd,
                name=release_sha,
            )
        )
        _personal_codex_metadata, personal_codex_fd = stack.enter_context(
            _open_bound_owned_directory(
                personal_codex,
                uid,
                parent_fd=release_fd,
                name="personal_codex",
            )
        )
        flags = os.O_RDONLY
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            fd = os.open(
                "private-sync-hosts.json",
                flags,
                dir_fd=personal_codex_fd,
            )
        except OSError as error:
            raise ControllerError(f"private host inventory is unreadable: {error}") from error
        try:
            metadata_before = os.fstat(fd)
            if (
                not stat.S_ISREG(metadata_before.st_mode)
                or metadata_before.st_uid != uid
                or metadata_before.st_nlink != 1
                or stat.S_IMODE(metadata_before.st_mode) & 0o022
            ):
                raise ControllerError("private host inventory access policy is unsafe")
            access_policy = _validate_fd_access_policy(
                fd,
                uid,
                "private host inventory",
            )
            payload = _read_fd_twice(fd, MAX_INVENTORY_BYTES, "private host inventory")
            metadata_after = os.fstat(fd)
            if _metadata_identity(metadata_before) != _metadata_identity(metadata_after):
                raise ControllerError(
                    "private host inventory identity or access policy changed"
                )
            if (
                _validate_fd_access_policy(
                    fd,
                    uid,
                    "private host inventory",
                )
                != access_policy
            ):
                raise ControllerError(
                    "private host inventory extended ACL policy binding changed"
                )
            try:
                named_after = os.stat(
                    "private-sync-hosts.json",
                    dir_fd=personal_codex_fd,
                    follow_symlinks=False,
                )
            except OSError as error:
                raise ControllerError("private host inventory disappeared after read") from error
            if _metadata_identity(named_after) != _metadata_identity(metadata_after):
                raise ControllerError("private host inventory was replaced during read")
        finally:
            os.close(fd)
    return InventorySnapshot(
        inventory=_parse_inventory(payload),
        release_sha=release_sha,
        content_sha256=hashlib.sha256(payload).hexdigest(),
        current_target=target_before,
    )


def _durable_sync(fd: int) -> None:
    try:
        if sys.platform == "darwin":
            full_fsync = getattr(fcntl, "F_FULLFSYNC", None)
            if type(full_fsync) is not int:
                raise StatePublicationError(
                    "durable sync requires Darwin F_FULLFSYNC"
                )
            fcntl.fcntl(fd, full_fsync)
        else:
            os.fsync(fd)
    except StatePublicationError:
        raise
    except OSError as error:
        raise StatePublicationError(f"durable sync failed: {error}") from error


def _revalidate_open_state_directory(
    path: Path,
    fd: int,
    uid: int,
) -> Tuple[int, str]:
    try:
        opened = os.fstat(fd)
        named = path.lstat()
    except OSError as error:
        raise StatePublicationError(
            f"state directory binding is unreadable: {error}"
        ) from error
    if (
        not _directory_metadata_is_safe(opened, uid, 0o700)
        or not _directory_metadata_is_safe(named, uid, 0o700)
        or _metadata_identity(opened) != _metadata_identity(named)
    ):
        raise StatePublicationError(
            "state directory identity or access policy changed"
        )
    return _validate_fd_access_policy(
        fd,
        uid,
        "state directory",
        error_type=StatePublicationError,
    )


@contextmanager
def _open_home_directory_descriptor(
    home: Path,
    uid: int,
) -> Iterator[Tuple[int, Callable[[], None]]]:
    directory_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        directory_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        directory_flags |= os.O_CLOEXEC
    try:
        named_before = home.lstat()
        home_fd = os.open(home, directory_flags)
    except OSError as error:
        raise StatePublicationError(f"failed to open state parent: {error}") from error
    try:
        opened_before = os.fstat(home_fd)
        home_identity = _metadata_identity(opened_before)
        if (
            not _directory_metadata_is_safe(opened_before, uid, None)
            or not _directory_metadata_is_safe(named_before, uid, None)
            or _metadata_identity(named_before) != home_identity
        ):
            raise StatePublicationError(
                "state directory parent identity or access policy is unsafe"
            )
        home_access_policy = _validate_fd_access_policy(
            home_fd,
            uid,
            "state directory parent",
            error_type=StatePublicationError,
        )

        def revalidate_home() -> None:
            try:
                opened = os.fstat(home_fd)
                named = home.lstat()
            except OSError as error:
                raise StatePublicationError(
                    f"state directory parent binding is unreadable: {error}"
                ) from error
            if (
                not _directory_metadata_is_safe(opened, uid, None)
                or not _directory_metadata_is_safe(named, uid, None)
                or _metadata_identity(opened) != home_identity
                or _metadata_identity(named) != home_identity
                or _validate_fd_access_policy(
                    home_fd,
                    uid,
                    "state directory parent",
                    error_type=StatePublicationError,
                )
                != home_access_policy
            ):
                raise StatePublicationError(
                    "state directory parent identity or access policy changed"
                )

        revalidate_home()
        yield home_fd, revalidate_home
    finally:
        try:
            os.close(home_fd)
        except OSError:
            pass


def _revalidate_with_home_sandwich(
    revalidate_home: Callable[[], None],
    revalidate_inner: Callable[[], None],
) -> None:
    revalidate_home()
    primary: Optional[BaseException] = None
    try:
        revalidate_inner()
    except BaseException as error:
        primary = error
    post_error: Optional[BaseException] = None
    try:
        revalidate_home()
    except BaseException as error:
        post_error = error
    if primary is not None:
        if post_error is not None:
            raise primary from post_error
        raise primary
    if post_error is not None:
        raise post_error


@contextmanager
def _open_state_directory_descriptor(
    home: Path,
    uid: int,
    *,
    create: bool,
) -> Iterator[
    Tuple[Path, int, Tuple[int, str], Callable[[], None]]
]:
    directory_flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        directory_flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        directory_flags |= os.O_CLOEXEC
    state_fd: Optional[int] = None
    with _open_home_directory_descriptor(home, uid) as (
        home_fd,
        revalidate_home,
    ):
        if create:
            try:
                os.mkdir(STATE_DIRECTORY_NAME, 0o700, dir_fd=home_fd)
            except FileExistsError:
                pass
            except OSError as error:
                raise StatePublicationError(
                    f"failed to create state directory: {error}"
                ) from error
        try:
            state_fd = os.open(
                STATE_DIRECTORY_NAME,
                directory_flags,
                dir_fd=home_fd,
            )
        except OSError as error:
            raise StatePublicationError(
                f"failed to open state directory: {error}"
            ) from error
        path = home / STATE_DIRECTORY_NAME
        access_policy = _revalidate_open_state_directory(path, state_fd, uid)
        if create:
            # Sync the child first, then its parent on every create=True open.
            # Repeating both after EEXIST repairs a prior interrupted attempt.
            _durable_sync(state_fd)
            _durable_sync(home_fd)
            revalidate_home()
            if _revalidate_open_state_directory(path, state_fd, uid) != access_policy:
                raise StatePublicationError(
                    "state directory extended ACL policy binding changed"
                )
        try:
            yield path, state_fd, access_policy, revalidate_home
        finally:
            if state_fd is not None:
                try:
                    os.close(state_fd)
                except OSError:
                    pass


@contextmanager
def _open_state_directory(
    home: Path,
    uid: int,
    *,
    create: bool,
) -> Iterator[Tuple[Path, int]]:
    with _open_state_directory_descriptor(home, uid, create=create) as (
        path,
        fd,
        access_policy,
        _revalidate_home,
    ):
        try:
            yield path, fd
        except BaseException as body_error:
            try:
                if (
                    _revalidate_open_state_directory(path, fd, uid)
                    != access_policy
                ):
                    raise StatePublicationError(
                        "state directory extended ACL policy binding changed"
                    )
            except BaseException as validation_error:
                if isinstance(
                    body_error,
                    (
                        ProcessCleanupInconclusiveError,
                        _ManagedProcessSignal,
                        KeyboardInterrupt,
                    ),
                ):
                    raise body_error from validation_error
                raise
            raise
        else:
            if (
                _revalidate_open_state_directory(path, fd, uid) != access_policy
            ):
                raise StatePublicationError(
                    "state directory extended ACL policy binding changed"
                )


def _read_bound_state_file(
    directory_fd: int,
    name: str,
    uid: int,
    *,
    missing_ok: bool,
) -> FileSnapshot:
    flags = os.O_RDONLY
    if hasattr(os, "O_NONBLOCK"):
        # A hostile same-account FIFO must fail the regular-file policy check
        # instead of blocking forever while a mutation lock is held.
        flags |= os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        fd = os.open(name, flags, dir_fd=directory_fd)
    except FileNotFoundError:
        if missing_ok:
            return FileSnapshot(False)
        raise ControllerError(f"required state file is missing: {name}")
    except OSError as error:
        raise ControllerError(f"state file is unreadable: {name}: {error}") from error
    try:
        before = os.fstat(fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != uid
            or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o600
        ):
            raise ControllerError(f"state file access policy is unsafe: {name}")
        access_policy = _validate_fd_access_policy(fd, uid, f"state file {name}")
        payload = _read_fd_twice(fd, MAX_STATE_BYTES, f"state file {name}")
        after = os.fstat(fd)
        named = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if (
            _metadata_identity(before) != _metadata_identity(after)
            or _metadata_identity(after) != _metadata_identity(named)
        ):
            raise ControllerError(f"state file was replaced or changed: {name}")
        if (
            _validate_fd_access_policy(fd, uid, f"state file {name}")
            != access_policy
        ):
            raise ControllerError(
                f"state file extended ACL policy binding changed: {name}"
            )
        return FileSnapshot(True, payload, (before.st_dev, before.st_ino))
    finally:
        try:
            os.close(fd)
        except OSError:
            pass


def _file_snapshot_matches(left: FileSnapshot, right: FileSnapshot) -> bool:
    # State CAS protects the prior exact payload and regular-file object
    # identity. Every snapshot read separately enforces user ownership, one
    # link, and exact 0600 access, so access-policy drift also fails closed.
    return (
        left.exists == right.exists
        and left.payload == right.payload
        and left.identity == right.identity
    )


def _revalidate_named_state_fences(
    fences: Sequence[NamedStateFence],
) -> None:
    if not fences:
        raise StatePublicationError("named state fence set is empty")
    for fence in fences:
        if (
            not fence.snapshot.exists
            or fence.snapshot.payload != fence.payload
            or fence.snapshot.identity is None
        ):
            raise StatePublicationError(
                f"{fence.label} expected named state snapshot is invalid"
            )

    primary: Optional[BaseException] = None
    try:
        for fence in fences:
            fence.revalidate()
        for fence in fences:
            try:
                current = _read_bound_state_file(
                    fence.directory_fd,
                    fence.name,
                    fence.uid,
                    missing_ok=True,
                )
            except (ControllerError, OSError) as error:
                raise StatePublicationError(
                    f"{fence.label} named fence is unreadable: {error}"
                ) from error
            if not current.exists:
                raise StatePublicationError(
                    f"{fence.label} named fence is missing"
                )
            if current.payload != fence.payload:
                raise StatePublicationError(
                    f"{fence.label} named fence payload changed"
                )
            if current.identity != fence.snapshot.identity:
                raise StatePublicationError(
                    f"{fence.label} named fence object was replaced"
                )
    except BaseException as error:
        primary = error

    post_error: Optional[BaseException] = None
    try:
        for fence in reversed(fences):
            fence.revalidate()
    except BaseException as error:
        post_error = error
    if primary is not None:
        if post_error is not None:
            raise primary from post_error
        raise primary
    if post_error is not None:
        raise post_error


def _named_state_fence_callback(
    *fences: NamedStateFence,
) -> Callable[[], None]:
    return lambda: _revalidate_named_state_fences(fences)


def _atomic_publish(
    directory_fd: int,
    name: str,
    payload: bytes,
    uid: int,
    expected: FileSnapshot,
) -> FileSnapshot:
    def read_for_publication(*, missing_ok: bool) -> FileSnapshot:
        try:
            return _read_bound_state_file(
                directory_fd,
                name,
                uid,
                missing_ok=missing_ok,
            )
        except StatePublicationError:
            raise
        except (ControllerError, OSError) as error:
            raise StatePublicationError(
                f"state publication binding is unsafe: {name}: {error}"
            ) from error

    if len(payload) > MAX_STATE_BYTES:
        raise StatePublicationError(f"state payload exceeds {MAX_STATE_BYTES} bytes")
    current = read_for_publication(missing_ok=True)
    if not _file_snapshot_matches(current, expected):
        raise StatePublicationError(f"state compare-and-swap failed before publication: {name}")
    temporary = f".{name}.{secrets.token_hex(8)}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        temporary_fd = os.open(temporary, flags, 0o600, dir_fd=directory_fd)
    except OSError as error:
        raise StatePublicationError(f"failed to create temporary state: {error}") from error
    published = False
    try:
        os.fchmod(temporary_fd, 0o600)
        temporary_before = os.fstat(temporary_fd)
        if (
            not stat.S_ISREG(temporary_before.st_mode)
            or temporary_before.st_uid != uid
            or temporary_before.st_nlink != 1
            or stat.S_IMODE(temporary_before.st_mode) != 0o600
        ):
            raise StatePublicationError("temporary state access policy is unsafe")
        temporary_access_policy = _validate_fd_access_policy(
            temporary_fd,
            uid,
            "temporary state",
            error_type=StatePublicationError,
        )
        offset = 0
        while offset < len(payload):
            written = os.write(temporary_fd, payload[offset:])
            if written <= 0:
                raise StatePublicationError("short write while publishing state")
            offset += written
        _durable_sync(temporary_fd)
        temporary_metadata = os.fstat(temporary_fd)
        if (
            not stat.S_ISREG(temporary_metadata.st_mode)
            or temporary_metadata.st_uid != uid
            or temporary_metadata.st_nlink != 1
            or stat.S_IMODE(temporary_metadata.st_mode) != 0o600
        ):
            raise StatePublicationError("temporary state access policy is unsafe")
        if (
            _metadata_identity(temporary_before)
            != _metadata_identity(temporary_metadata)
            or _validate_fd_access_policy(
                temporary_fd,
                uid,
                "temporary state",
                error_type=StatePublicationError,
            )
            != temporary_access_policy
        ):
            raise StatePublicationError(
                "temporary state identity or extended ACL policy changed"
            )
        current = read_for_publication(missing_ok=True)
        if not _file_snapshot_matches(current, expected):
            raise StatePublicationError(f"state compare-and-swap failed at publication: {name}")
        try:
            named_temporary = os.stat(
                temporary,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except OSError as error:
            raise StatePublicationError(
                f"temporary state pathname is unsafe: {error}"
            ) from error
        if (
            _metadata_identity(named_temporary)
            != _metadata_identity(temporary_metadata)
            or named_temporary.st_nlink != 1
        ):
            raise StatePublicationError(
                "temporary state pathname no longer names the validated object"
            )
        temporary_identity = (
            temporary_metadata.st_dev,
            temporary_metadata.st_ino,
        )
        os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        published = True
        _durable_sync(directory_fd)
        final = read_for_publication(missing_ok=False)
        # Publication protects both exact content and the identity of the
        # already validated, durably synced temporary object. A same-payload
        # replacement is not the object this transaction authorized.
        if final.payload != payload or final.identity != temporary_identity:
            raise StatePublicationError(f"published state failed exact revalidation: {name}")
        return final
    except OSError as error:
        raise StatePublicationError(f"failed to publish state {name}: {error}") from error
    finally:
        try:
            os.close(temporary_fd)
        except OSError:
            pass
        if not published:
            try:
                os.unlink(temporary, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
            except OSError:
                pass


def _activation_lock_file_is_safe(
    opened: os.stat_result,
    named: os.stat_result,
    uid: int,
    expected_identity: Optional[Tuple[int, int, int, int, int, int]] = None,
) -> bool:
    identity = _metadata_identity(opened)
    return (
        stat.S_ISREG(opened.st_mode)
        and stat.S_ISREG(named.st_mode)
        and opened.st_uid == uid
        and named.st_uid == uid
        and opened.st_nlink == 1
        and named.st_nlink == 1
        and stat.S_IMODE(opened.st_mode) == 0o600
        and stat.S_IMODE(named.st_mode) == 0o600
        and identity == _metadata_identity(named)
        and (expected_identity is None or identity == expected_identity)
    )


def _revalidate_activation_transaction_inner(
    transaction: ActivationTransaction,
) -> None:
    try:
        opened_directory = os.fstat(transaction.directory_fd)
        named_directory = transaction.directory_path.lstat()
        opened_lock = os.fstat(transaction.lock_fd)
        named_lock = os.stat(
            transaction.lock_name,
            dir_fd=transaction.directory_fd,
            follow_symlinks=False,
        )
    except OSError as error:
        raise StatePublicationError(
            f"activation transaction binding is unreadable: {error}"
        ) from error
    if (
        not stat.S_ISDIR(opened_directory.st_mode)
        or not stat.S_ISDIR(named_directory.st_mode)
        or opened_directory.st_uid != transaction.uid
        or named_directory.st_uid != transaction.uid
        or stat.S_IMODE(opened_directory.st_mode) != 0o700
        or stat.S_IMODE(named_directory.st_mode) != 0o700
        or _metadata_identity(opened_directory) != transaction.directory_identity
        or _metadata_identity(named_directory) != transaction.directory_identity
    ):
        raise StatePublicationError(
            "activation state directory identity or access policy changed"
        )
    if (
        _validate_fd_access_policy(
            transaction.directory_fd,
            transaction.uid,
            "activation state directory",
            error_type=StatePublicationError,
        )
        != transaction.directory_access_policy
    ):
        raise StatePublicationError(
            "activation state directory extended ACL policy binding changed"
        )
    if not _activation_lock_file_is_safe(
        opened_lock,
        named_lock,
        transaction.uid,
        transaction.lock_identity,
    ):
        raise StatePublicationError(
            "activation lock identity or access policy changed during transaction"
        )
    if (
        _validate_fd_access_policy(
            transaction.lock_fd,
            transaction.uid,
            "activation lock",
            error_type=StatePublicationError,
        )
        != transaction.lock_access_policy
    ):
        raise StatePublicationError(
            "activation lock extended ACL policy binding changed during transaction"
        )


def _revalidate_activation_transaction(transaction: ActivationTransaction) -> None:
    _revalidate_with_home_sandwich(
        transaction.revalidate_home,
        lambda: _revalidate_activation_transaction_inner(transaction),
    )


def _commit_activation_publication(transaction: ActivationTransaction) -> None:
    publication = transaction.publication
    if publication is None:
        raise StatePublicationError("activation publication was not staged")
    _revalidate_activation_transaction(transaction)
    pending = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        transaction.uid,
        missing_ok=False,
    )
    receipt = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_FILE_NAME,
        transaction.uid,
        missing_ok=False,
    )
    if (
        not _file_snapshot_matches(pending, publication.pending_snapshot)
        or pending.payload != publication.pending_payload
        or not _file_snapshot_matches(receipt, publication.receipt_snapshot)
        or receipt.payload != publication.receipt_payload
    ):
        raise StatePublicationError(
            "activation pending or receipt state changed before commit"
        )
    _revalidate_activation_transaction(transaction)
    try:
        os.unlink(
            ACTIVATION_PENDING_FILE_NAME,
            dir_fd=transaction.directory_fd,
        )
    except OSError as error:
        raise StatePublicationError(
            f"failed to commit activation publication: {error}"
        ) from error
    # Sentinel removal is the commit point. The receipt and its directory were
    # already fsynced and exactly revalidated while the sentinel was present.
    # Do not perform another fallible state operation after this assignment: a
    # crash may resurrect the sentinel, which only makes validation fail closed.
    transaction.committed = True


@contextmanager
def _activation_lock(
    home: Path,
    uid: int,
    runtime: Runtime,
) -> Iterator[ActivationTransaction]:
    directory_context = _open_state_directory_descriptor(home, uid, create=True)
    directory_path, directory_fd, directory_access_policy, revalidate_home = (
        directory_context.__enter__()
    )
    lock_fd: Optional[int] = None
    lock_acquired = False
    try:
        opened_directory = os.fstat(directory_fd)
        named_directory = directory_path.lstat()
        directory_identity = _metadata_identity(opened_directory)
        if (
            not stat.S_ISDIR(opened_directory.st_mode)
            or not stat.S_ISDIR(named_directory.st_mode)
            or opened_directory.st_uid != uid
            or named_directory.st_uid != uid
            or stat.S_IMODE(opened_directory.st_mode) != 0o700
            or stat.S_IMODE(named_directory.st_mode) != 0o700
            or directory_identity != _metadata_identity(named_directory)
        ):
            raise StatePublicationError(
                "activation state directory identity or access policy is unsafe"
            )
        lock_name = "activation.lock"
        lock_flags = os.O_RDWR
        if hasattr(os, "O_NOFOLLOW"):
            lock_flags |= os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            lock_flags |= os.O_CLOEXEC
        created = False
        try:
            lock_fd = os.open(
                lock_name,
                lock_flags | os.O_CREAT | os.O_EXCL,
                0o600,
                dir_fd=directory_fd,
            )
            created = True
        except FileExistsError:
            try:
                lock_fd = os.open(lock_name, lock_flags, dir_fd=directory_fd)
            except OSError as error:
                raise StatePublicationError(
                    f"failed to open existing activation lock: {error}"
                ) from error
        except OSError as error:
            raise StatePublicationError(
                f"failed to open activation lock: {error}"
            ) from error
        if created:
            os.fchmod(lock_fd, 0o600)
        lock_metadata = os.fstat(lock_fd)
        named_lock = os.stat(
            lock_name,
            dir_fd=directory_fd,
            follow_symlinks=False,
        )
        if not _activation_lock_file_is_safe(lock_metadata, named_lock, uid):
            raise StatePublicationError(
                "activation lock identity or access policy is unsafe"
            )
        lock_access_policy = _validate_fd_access_policy(
            lock_fd,
            uid,
            "activation lock",
            error_type=StatePublicationError,
        )
        lock_identity = _metadata_identity(lock_metadata)
        deadline = runtime.monotonic() + LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                lock_acquired = True
                break
            except BlockingIOError:
                if runtime.monotonic() >= deadline:
                    raise StatePublicationError(
                        "timed out acquiring activation transaction lock"
                    )
                runtime.sleep(0.05)
            except OSError as error:
                raise StatePublicationError(
                    f"failed to acquire activation transaction lock: {error}"
                ) from error
        transaction = ActivationTransaction(
            directory_path=directory_path,
            directory_fd=directory_fd,
            directory_identity=directory_identity,
            directory_access_policy=directory_access_policy,
            lock_name=lock_name,
            lock_fd=lock_fd,
            lock_identity=lock_identity,
            lock_access_policy=lock_access_policy,
            uid=uid,
            revalidate_home=revalidate_home,
        )
        _revalidate_activation_transaction(transaction)
        try:
            yield transaction
        except BaseException as body_error:
            try:
                _revalidate_activation_transaction(transaction)
            except BaseException as validation_error:
                if isinstance(
                    body_error,
                    (
                        ProcessCleanupInconclusiveError,
                        _ManagedProcessSignal,
                        KeyboardInterrupt,
                    ),
                ):
                    raise body_error from validation_error
                raise
            raise
        else:
            if transaction.publication is None:
                _revalidate_activation_transaction(transaction)
            else:
                _commit_activation_publication(transaction)
    finally:
        # Cleanup errors cannot revoke an already committed receipt, so they
        # must not turn a successful sentinel removal into a failed activation.
        if lock_fd is not None:
            if lock_acquired:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_UN)
                except OSError:
                    pass
            try:
                os.close(lock_fd)
            except OSError:
                pass
        directory_context.__exit__(None, None, None)


@contextmanager
def _target_lock(
    home: Path,
    uid: int,
    target_id: str,
    runtime: Runtime,
) -> Iterator[Tuple[int, str, Callable[[], None]]]:
    _validate_host_id(target_id, "lock target")
    with _open_state_directory_descriptor(home, uid, create=True) as (
        path,
        directory_fd,
        _initial_directory_access_policy,
        revalidate_home,
    ):
        lock_name = f"target-{target_id}.lock"
        flags = os.O_RDWR
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        created = False
        try:
            lock_fd = os.open(
                lock_name,
                flags | os.O_CREAT | os.O_EXCL,
                0o600,
                dir_fd=directory_fd,
            )
            created = True
        except FileExistsError:
            try:
                lock_fd = os.open(lock_name, flags, dir_fd=directory_fd)
            except OSError as error:
                raise StatePublicationError(
                    f"failed to open existing target lock: {error}"
                ) from error
        except OSError as error:
            raise StatePublicationError(f"failed to open target lock: {error}") from error
        try:
            if created:
                os.fchmod(lock_fd, 0o600)
            metadata = os.fstat(lock_fd)
            named = os.stat(lock_name, dir_fd=directory_fd, follow_symlinks=False)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != uid
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or _metadata_identity(metadata) != _metadata_identity(named)
            ):
                raise StatePublicationError("target lock identity or access policy is unsafe")
            lock_identity = _metadata_identity(metadata)
            access_policy = _validate_fd_access_policy(
                lock_fd,
                uid,
                "target lock",
                error_type=StatePublicationError,
            )
            deadline = runtime.monotonic() + LOCK_TIMEOUT_SECONDS
            while True:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if runtime.monotonic() >= deadline:
                        raise StatePublicationError("timed out acquiring target state lock")
                    runtime.sleep(0.05)
            directory_access_policy = _revalidate_open_state_directory(
                path,
                directory_fd,
                uid,
            )

            def revalidate_inner() -> None:
                if (
                    _revalidate_open_state_directory(path, directory_fd, uid)
                    != directory_access_policy
                ):
                    raise StatePublicationError(
                        "target state directory extended ACL policy binding changed"
                    )
                try:
                    rebound = os.stat(
                        lock_name,
                        dir_fd=directory_fd,
                        follow_symlinks=False,
                    )
                    opened = os.fstat(lock_fd)
                except OSError as error:
                    raise StatePublicationError(
                        f"target lock binding is unreadable: {error}"
                    ) from error
                if not _activation_lock_file_is_safe(
                    opened,
                    rebound,
                    uid,
                    lock_identity,
                ):
                    raise StatePublicationError(
                        "target lock identity or access policy changed during use"
                    )
                if (
                    _validate_fd_access_policy(
                        lock_fd,
                        uid,
                        "target lock",
                        error_type=StatePublicationError,
                    )
                    != access_policy
                ):
                    raise StatePublicationError(
                        "target lock extended ACL policy binding changed during use"
                    )

            def revalidate() -> None:
                _revalidate_with_home_sandwich(
                    revalidate_home,
                    revalidate_inner,
                )

            revalidate()
            try:
                yield directory_fd, f"target-{target_id}.json", revalidate
            except BaseException as body_error:
                try:
                    revalidate()
                except BaseException as validation_error:
                    if isinstance(
                        body_error,
                        (
                            ProcessCleanupInconclusiveError,
                            _ManagedProcessSignal,
                            KeyboardInterrupt,
                        ),
                    ):
                        raise body_error from validation_error
                    raise
                raise
            else:
                revalidate()
        finally:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(lock_fd)
            except OSError:
                pass


def _operation_state_name(operation: str) -> str:
    if operation not in HOST_MUTATION_OPERATIONS:
        raise ControllerError("operation fence kind is invalid")
    return HOST_MUTATION_STATE_NAME


def _reject_unsupported_operation_files(directory_fd: int) -> None:
    for name in sorted(UNSUPPORTED_OPERATION_FILES):
        try:
            os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError as error:
            raise UnsupportedOperationArtifactError(
                f"unsupported operation artifact is unreadable: {name}: {error}"
            ) from error
        raise UnsupportedOperationArtifactError(
            "unsupported operation artifact requires proving process absence "
            f"and manual cleanup: {name}"
        )


@contextmanager
def _host_mutation_lock(
    home: Path,
    uid: int,
    runtime: Runtime,
) -> Iterator[HostMutationTransaction]:
    state_name = HOST_MUTATION_STATE_NAME
    with _open_state_directory_descriptor(home, uid, create=True) as (
        path,
        directory_fd,
        _directory_access_policy,
        revalidate_home,
    ):
        lock_name = HOST_MUTATION_LOCK_NAME
        flags = os.O_RDWR
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        created = False
        try:
            lock_fd = os.open(
                lock_name,
                flags | os.O_CREAT | os.O_EXCL,
                0o600,
                dir_fd=directory_fd,
            )
            created = True
        except FileExistsError:
            try:
                lock_fd = os.open(lock_name, flags, dir_fd=directory_fd)
            except OSError as error:
                raise StatePublicationError(
                    f"failed to open existing host mutation lock: {error}"
                ) from error
        except OSError as error:
            raise StatePublicationError(
                f"failed to open host mutation lock: {error}"
            ) from error
        try:
            if created:
                os.fchmod(lock_fd, 0o600)
            metadata = os.fstat(lock_fd)
            named = os.stat(lock_name, dir_fd=directory_fd, follow_symlinks=False)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != uid
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or _metadata_identity(metadata) != _metadata_identity(named)
            ):
                raise StatePublicationError(
                    "host mutation lock identity or access policy is unsafe"
                )
            lock_identity = _metadata_identity(metadata)
            access_policy = _validate_fd_access_policy(
                lock_fd,
                uid,
                "host mutation lock",
                error_type=StatePublicationError,
            )
            deadline = runtime.monotonic() + LOCK_TIMEOUT_SECONDS
            while True:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if runtime.monotonic() >= deadline:
                        raise StatePublicationError(
                            "timed out acquiring host mutation lock"
                        )
                    runtime.sleep(0.05)
            directory_access_policy = _revalidate_open_state_directory(
                path,
                directory_fd,
                uid,
            )

            def revalidate_inner() -> None:
                if (
                    _revalidate_open_state_directory(path, directory_fd, uid)
                    != directory_access_policy
                ):
                    raise StatePublicationError(
                        "host mutation state directory extended ACL policy binding changed"
                    )
                _reject_unsupported_operation_files(directory_fd)
                try:
                    rebound = os.stat(
                        lock_name,
                        dir_fd=directory_fd,
                        follow_symlinks=False,
                    )
                    opened = os.fstat(lock_fd)
                except OSError as error:
                    raise StatePublicationError(
                        f"host mutation lock binding is unreadable: {error}"
                    ) from error
                if not _activation_lock_file_is_safe(
                    opened,
                    rebound,
                    uid,
                    lock_identity,
                ):
                    raise StatePublicationError(
                        "host mutation lock identity or access policy changed during use"
                    )
                if (
                    _validate_fd_access_policy(
                        lock_fd,
                        uid,
                        "host mutation lock",
                        error_type=StatePublicationError,
                    )
                    != access_policy
                ):
                    raise StatePublicationError(
                        "host mutation lock extended ACL policy binding changed during use"
                    )

            def revalidate() -> None:
                _revalidate_with_home_sandwich(
                    revalidate_home,
                    revalidate_inner,
                )

            revalidate()
            transaction = HostMutationTransaction(
                directory_fd=directory_fd,
                state_name=state_name,
                revalidate=revalidate,
            )
            try:
                yield transaction
            except BaseException as body_error:
                if not transaction.activation_committed:
                    try:
                        revalidate()
                    except BaseException as validation_error:
                        if isinstance(
                            body_error,
                            (
                                ProcessCleanupInconclusiveError,
                                _ManagedProcessSignal,
                                KeyboardInterrupt,
                            ),
                        ):
                            raise body_error from validation_error
                        raise
                raise
            else:
                if not transaction.activation_committed:
                    revalidate()
        finally:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(lock_fd)
            except OSError:
                pass


@contextmanager
def _status_snapshot_lock(
    home: Path,
    uid: int,
    runtime: Runtime,
) -> Iterator[None]:
    """Hold a read-only, protocol-consistent snapshot of controller state.

    The protected property is the bound HOME, state-directory, and host-lock
    object identity plus their owner/mode/ACL access policy. Directory link
    counts and timestamps are deliberately not bound because ordinary child
    churn can change them without replacing either directory; the regular lock
    must remain single-linked throughout the snapshot.

    This coordinates writers that obey the lock protocol; it does not claim to
    exclude an intentional same-UID or root mutation that bypasses that lock.
    """
    with _open_state_directory_descriptor(home, uid, create=False) as (
        path,
        directory_fd,
        directory_access_policy,
        revalidate_home,
    ):
        lock_name = HOST_MUTATION_LOCK_NAME
        flags = os.O_RDONLY
        if hasattr(os, "O_NONBLOCK"):
            flags |= os.O_NONBLOCK
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            lock_fd = os.open(lock_name, flags, dir_fd=directory_fd)
        except OSError as error:
            raise StatePublicationError(
                f"failed to open existing host mutation lock for status: {error}"
            ) from error
        try:
            try:
                opened = os.fstat(lock_fd)
                named = os.stat(
                    lock_name,
                    dir_fd=directory_fd,
                    follow_symlinks=False,
                )
            except OSError as error:
                raise StatePublicationError(
                    f"host mutation status lock binding is unreadable: {error}"
                ) from error
            if not _activation_lock_file_is_safe(opened, named, uid):
                raise StatePublicationError(
                    "host mutation status lock identity or access policy is unsafe"
                )
            lock_identity = _metadata_identity(opened)
            lock_access_policy = _validate_fd_access_policy(
                lock_fd,
                uid,
                "host mutation status lock",
                error_type=StatePublicationError,
            )
            deadline = runtime.monotonic() + LOCK_TIMEOUT_SECONDS
            while True:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if runtime.monotonic() >= deadline:
                        raise StatePublicationError(
                            "timed out acquiring host mutation status lock"
                        )
                    runtime.sleep(0.05)

            def revalidate_inner() -> None:
                if (
                    _revalidate_open_state_directory(path, directory_fd, uid)
                    != directory_access_policy
                ):
                    raise StatePublicationError(
                        "host mutation status directory extended ACL policy "
                        "binding changed"
                    )
                _reject_unsupported_operation_files(directory_fd)
                try:
                    rebound = os.stat(
                        lock_name,
                        dir_fd=directory_fd,
                        follow_symlinks=False,
                    )
                    current = os.fstat(lock_fd)
                except OSError as error:
                    raise StatePublicationError(
                        f"host mutation status lock binding is unreadable: {error}"
                    ) from error
                if not _activation_lock_file_is_safe(
                    current,
                    rebound,
                    uid,
                    lock_identity,
                ):
                    raise StatePublicationError(
                        "host mutation status lock identity or access policy changed"
                    )
                if (
                    _validate_fd_access_policy(
                        lock_fd,
                        uid,
                        "host mutation status lock",
                        error_type=StatePublicationError,
                    )
                    != lock_access_policy
                ):
                    raise StatePublicationError(
                        "host mutation status lock extended ACL policy binding changed"
                    )

            def revalidate() -> None:
                _revalidate_with_home_sandwich(
                    revalidate_home,
                    revalidate_inner,
                )

            revalidate()
            try:
                yield
            except BaseException as body_error:
                try:
                    revalidate()
                except BaseException as validation_error:
                    if isinstance(
                        body_error,
                        (
                            ProcessCleanupInconclusiveError,
                            _ManagedProcessSignal,
                            KeyboardInterrupt,
                        ),
                    ):
                        raise body_error from validation_error
                    raise
                raise
            else:
                revalidate()
        finally:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(lock_fd)
            except OSError:
                pass


def _entry_digest(entry: HostEntry, source: str) -> str:
    payload = _canonical_json_bytes(
        {"binding": entry.binding_json(), "source": source}
    )
    return hashlib.sha256(payload).hexdigest()


def _scope_digest(controller: HostEntry, target: HostEntry) -> str:
    payload = _canonical_json_bytes(
        {"controller": controller.binding_json(), "target": target.to_json()}
    )
    return hashlib.sha256(payload).hexdigest()


def _resolve_host_id(
    inventory: Inventory,
    runtime: Runtime,
    requested: Optional[str],
) -> str:
    candidates = tuple(
        _validate_host_id(candidate, "runtime host candidate")
        for candidate in runtime.host_candidates()
    )
    if not candidates:
        raise ControllerError("macOS host candidate set is empty")
    candidate_keys = {candidate.casefold() for candidate in candidates}
    if requested is not None:
        host_id = _validate_host_id(requested, "requested host id")
        if host_id.casefold() not in candidate_keys:
            raise ControllerError("requested host id does not match this macOS host")
    else:
        host_id = candidates[0]
    inventory_by_key = {
        inventory_host_id.casefold(): inventory_host_id
        for inventory_host_id in inventory.hosts
    }
    inventory_candidates = tuple(
        dict.fromkeys(
            inventory_by_key[candidate.casefold()]
            for candidate in candidates
            if candidate.casefold() in inventory_by_key
        )
    )
    if len(inventory_candidates) > 1:
        raise ControllerError(
            "role-activation-required: multiple inventory-listed ids match "
            "this macOS host"
        )
    if inventory_candidates:
        return inventory_candidates[0]
    return host_id


def _validate_account(entry: HostEntry, account: Account) -> None:
    if (
        entry.username != account.username
        or entry.uid != account.uid
        or entry.home != str(account.home)
    ):
        raise ControllerError(
            f"inventory account binding does not match host {entry.host_id}"
        )


def _effective_entry(
    snapshot: InventorySnapshot,
    host_id: str,
    account: Account,
    *,
    allow_implicit_standalone: bool,
) -> EffectiveEntry:
    explicit = snapshot.inventory.hosts.get(host_id)
    if explicit is not None:
        _validate_account(explicit, account)
        return EffectiveEntry(explicit, "inventory")
    if not allow_implicit_standalone:
        raise ControllerError(
            "role-activation-required: unlisted hosts are inferred only during activation"
        )
    implicit = HostEntry(
        host_id,
        "gui-standalone",
        account.username,
        account.uid,
        str(account.home),
    )
    return EffectiveEntry(implicit, "implicit-gui-default")


def _codex_home(raw_home: Path, account: Account) -> Path:
    home = Path(os.path.abspath(os.path.expanduser(str(raw_home))))
    expected = account.home / ".codex"
    if home != expected:
        raise ControllerError(f"--home must be the current account's ~/.codex: {expected}")
    return home


def _gui_domain_is_live(runtime: Runtime, uid: int) -> bool:
    result = runtime.run(
        ("/bin/launchctl", "print", f"gui/{uid}"),
        timeout=5.0,
        output_limit=8192,
    )
    return (
        result.returncode == 0
        and not result.timed_out
        and not result.output_overflow
    )


def _validate_activation_interval(role: str, value: Any) -> Optional[int]:
    if role == "headless-managed":
        if value is not None:
            raise ControllerError(
                "headless activation scheduler interval must be null"
            )
        return None
    if type(value) is not int or value < 1 or value > 7 * 24 * 60:
        raise ControllerError("GUI activation scheduler interval is invalid")
    return value


def _activation_payload(
    effective: EffectiveEntry,
    account: Account,
    home: Path,
    machine_identity_sha256: str,
    interval_minutes: Optional[int],
) -> Dict[str, Any]:
    if TREE_SHA256_RE.fullmatch(machine_identity_sha256) is None:
        raise ControllerError("machine identity digest is invalid")
    return {
        "version": VERSION,
        "host_id": effective.entry.host_id,
        "role": effective.entry.role,
        "username": account.username,
        "uid": account.uid,
        "account_home": str(account.home),
        "codex_home": str(home),
        "machine_identity_sha256": machine_identity_sha256,
        "entry_source": effective.source,
        "entry_sha256": _entry_digest(effective.entry, effective.source),
        "entry": effective.entry.to_json(),
        "managed_targets": list(effective.entry.targets),
        "interval_minutes": _validate_activation_interval(
            effective.entry.role,
            interval_minutes,
        ),
    }


def _parse_activation(payload: bytes) -> Dict[str, Any]:
    raw = _bounded_json(payload, "activation receipt")
    if not isinstance(raw, dict):
        raise ControllerError("activation receipt must be an object")
    expected = (
        "version",
        "host_id",
        "role",
        "username",
        "uid",
        "account_home",
        "codex_home",
        "machine_identity_sha256",
        "entry_source",
        "entry_sha256",
        "entry",
        "managed_targets",
        "interval_minutes",
    )
    _require_exact_keys(raw, expected, "activation receipt")
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("activation receipt version must be 1")
    _validate_host_id(raw["host_id"], "activation host id")
    if raw["role"] not in ROLES:
        raise ControllerError("activation receipt role is invalid")
    _validate_username(raw["username"], "activation username")
    if type(raw["uid"]) is not int or raw["uid"] < 0:
        raise ControllerError("activation uid is invalid")
    _validate_home(raw["account_home"], "activation account home")
    _validate_home(raw["codex_home"], "activation codex home")
    if (
        not isinstance(raw["machine_identity_sha256"], str)
        or TREE_SHA256_RE.fullmatch(raw["machine_identity_sha256"]) is None
    ):
        raise ControllerError("activation machine identity digest is invalid")
    if raw["entry_source"] not in ("inventory", "implicit-gui-default"):
        raise ControllerError("activation entry source is invalid")
    if not isinstance(raw["entry_sha256"], str) or TREE_SHA256_RE.fullmatch(raw["entry_sha256"]) is None:
        raise ControllerError("activation entry digest is invalid")
    entry = _parse_host_entry(raw["entry"], 1)
    managed_targets = raw["managed_targets"]
    if not isinstance(managed_targets, list) or len(managed_targets) > MAX_TARGETS:
        raise ControllerError("activation managed targets are invalid")
    parsed_targets = tuple(
        _validate_host_id(target, "activation managed target")
        for target in managed_targets
    )
    if len(set(parsed_targets)) != len(parsed_targets):
        raise ControllerError("activation managed targets repeat")
    if entry.role == "gui-controller":
        entry = replace(entry, targets=parsed_targets)
    elif parsed_targets:
        raise ControllerError("only a controller activation can bind managed targets")
    if entry.host_id != raw["host_id"] or entry.role != raw["role"]:
        raise ControllerError("activation receipt entry binding is inconsistent")
    if _entry_digest(entry, raw["entry_source"]) != raw["entry_sha256"]:
        raise ControllerError("activation receipt entry digest is invalid")
    _validate_activation_interval(entry.role, raw["interval_minutes"])
    return raw


def _parse_activation_pending(payload: bytes) -> Dict[str, Any]:
    raw = _bounded_json(payload, "activation publication sentinel")
    if not isinstance(raw, dict):
        raise ControllerError("activation publication sentinel must be an object")
    _require_exact_keys(
        raw,
        ("version", "status", "receipt_sha256"),
        "activation publication sentinel",
    )
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("activation publication sentinel version is invalid")
    if raw["status"] not in (
        "pending",
        "in-flight",
        "retryable",
        "process-cleanup-inconclusive",
    ):
        raise ControllerError("activation publication sentinel status is invalid")
    if (
        not isinstance(raw["receipt_sha256"], str)
        or TREE_SHA256_RE.fullmatch(raw["receipt_sha256"]) is None
    ):
        raise ControllerError("activation publication sentinel digest is invalid")
    return raw


def _reject_blocking_activation_pending(snapshot: FileSnapshot) -> None:
    if not snapshot.exists:
        return
    assert snapshot.payload is not None
    pending = _parse_activation_pending(snapshot.payload)
    if pending["status"] == "pending":
        raise ActivationProcessFenceError(
            "legacy-pending: activation predates the process ownership fence; "
            "manual recovery requires proving process absence (normally by reboot)"
        )
    if pending["status"] == "in-flight":
        raise ActivationProcessFenceError(
            "process-in-flight: activation is blocked; manual recovery requires "
            "proving process absence (normally by reboot)"
        )
    if pending["status"] == "process-cleanup-inconclusive":
        raise ActivationProcessFenceError(
            "process-cleanup-inconclusive: activation is quarantined; manual "
            "recovery requires proving process absence (normally by reboot)"
        )


def _begin_activation_publication(
    transaction: ActivationTransaction,
    account: Account,
    payload: Dict[str, Any],
) -> None:
    if (
        transaction.uid != account.uid
        or transaction.pending_snapshot is not None
        or transaction.publication is not None
    ):
        raise StatePublicationError("activation transaction publication is invalid")
    receipt_payload = _canonical_json_bytes(payload)
    pending_payload = _canonical_json_bytes(
        {
            "version": VERSION,
            "status": "in-flight",
            "receipt_sha256": hashlib.sha256(receipt_payload).hexdigest(),
        }
    )
    previous_pending = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        account.uid,
        missing_ok=True,
    )
    # Version-1 "pending" sentinels predate the process ownership fence and
    # are ambiguous, so they migrate fail closed. Only an explicit retryable
    # state written after complete cleanup may start another installer.
    _reject_blocking_activation_pending(previous_pending)
    pending_snapshot = _atomic_publish(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        pending_payload,
        account.uid,
        previous_pending,
    )
    transaction.pending_snapshot = pending_snapshot
    transaction.pending_payload = pending_payload
    transaction.receipt_payload = receipt_payload


def _mark_activation_retryable(
    transaction: ActivationTransaction,
    account: Account,
) -> None:
    if (
        transaction.uid != account.uid
        or transaction.pending_snapshot is None
        or transaction.pending_payload is None
        or transaction.receipt_payload is None
        or transaction.publication is not None
    ):
        raise StatePublicationError("activation retryable state is invalid")
    current = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        account.uid,
        missing_ok=False,
    )
    if not _file_snapshot_matches(current, transaction.pending_snapshot):
        raise StatePublicationError(
            "activation publication sentinel changed before retryable transition"
        )
    assert current.payload is not None
    if _parse_activation_pending(current.payload)["status"] != "in-flight":
        raise StatePublicationError(
            "activation publication sentinel is not in-flight"
        )
    retryable_payload = _canonical_json_bytes(
        {
            "version": VERSION,
            "status": "retryable",
            "receipt_sha256": hashlib.sha256(
                transaction.receipt_payload
            ).hexdigest(),
        }
    )
    transaction.pending_snapshot = _atomic_publish(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        retryable_payload,
        account.uid,
        current,
    )
    transaction.pending_payload = retryable_payload


def _quarantine_activation_process_cleanup(
    transaction: ActivationTransaction,
    account: Account,
) -> None:
    if (
        transaction.uid != account.uid
        or transaction.pending_snapshot is None
        or transaction.pending_payload is None
        or transaction.receipt_payload is None
        or transaction.publication is not None
    ):
        raise StatePublicationError("activation cleanup quarantine state is invalid")
    current = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        account.uid,
        missing_ok=False,
    )
    if not _file_snapshot_matches(current, transaction.pending_snapshot):
        raise StatePublicationError(
            "activation publication sentinel changed before cleanup quarantine"
        )
    quarantine_payload = _canonical_json_bytes(
        {
            "version": VERSION,
            "status": "process-cleanup-inconclusive",
            "receipt_sha256": hashlib.sha256(
                transaction.receipt_payload
            ).hexdigest(),
        }
    )
    transaction.pending_snapshot = _atomic_publish(
        transaction.directory_fd,
        ACTIVATION_PENDING_FILE_NAME,
        quarantine_payload,
        account.uid,
        current,
    )
    transaction.pending_payload = quarantine_payload


def _publish_activation(
    transaction: ActivationTransaction,
    account: Account,
    payload: Dict[str, Any],
) -> None:
    receipt_payload = _canonical_json_bytes(payload)
    if (
        transaction.uid != account.uid
        or transaction.pending_snapshot is None
        or transaction.pending_payload is None
        or transaction.receipt_payload != receipt_payload
        or transaction.publication is not None
    ):
        raise StatePublicationError("activation transaction publication is invalid")
    previous_receipt = _read_bound_state_file(
        transaction.directory_fd,
        ACTIVATION_FILE_NAME,
        account.uid,
        missing_ok=True,
    )
    receipt_snapshot = _atomic_publish(
        transaction.directory_fd,
        ACTIVATION_FILE_NAME,
        receipt_payload,
        account.uid,
        previous_receipt,
    )
    transaction.publication = ActivationPublication(
        pending_snapshot=transaction.pending_snapshot,
        pending_payload=transaction.pending_payload,
        receipt_snapshot=receipt_snapshot,
        receipt_payload=receipt_payload,
    )


def _validated_activation_receipt(
    home: Path,
    account: Account,
    snapshot: InventorySnapshot,
    receipt_file: FileSnapshot,
    *,
    requested_host_id: Optional[str],
    runtime: Runtime,
) -> EffectiveEntry:
    if not receipt_file.exists:
        raise ControllerError(
            f"required state file is missing: {ACTIVATION_FILE_NAME}"
        )
    assert receipt_file.payload is not None
    receipt = _parse_activation(receipt_file.payload)
    host_id = receipt["host_id"]
    resolved_host_id = _resolve_host_id(
        snapshot.inventory,
        runtime,
        requested_host_id if requested_host_id is not None else host_id,
    )
    if resolved_host_id.casefold() != host_id.casefold():
        raise ControllerError("activation receipt host id does not match this host")
    effective = _effective_entry(
        snapshot,
        host_id,
        account,
        allow_implicit_standalone=(
            receipt["entry_source"] == "implicit-gui-default"
        ),
    )
    expected = _activation_payload(
        effective,
        account,
        home,
        runtime.machine_identity_sha256(),
        receipt["interval_minutes"],
    )
    if receipt != expected:
        raise ControllerError("role-activation-required: current host scope changed")
    return replace(
        effective,
        interval_minutes=receipt["interval_minutes"],
    )


def _validate_activation(
    home: Path,
    account: Account,
    snapshot: InventorySnapshot,
    *,
    requested_host_id: Optional[str] = None,
    runtime: Optional[Runtime] = None,
) -> EffectiveEntry:
    if runtime is None:
        raise ControllerError("activation validation requires machine identity runtime")
    with _open_state_directory(home, account.uid, create=False) as (
        _path,
        preflight_directory_fd,
    ):
        preflight_pending = _read_bound_state_file(
            preflight_directory_fd,
            ACTIVATION_PENDING_FILE_NAME,
            account.uid,
            missing_ok=True,
        )
        if preflight_pending.exists:
            _reject_blocking_activation_pending(preflight_pending)
            raise ControllerError(
                "role-activation-required: activation publication is pending"
            )
    with _activation_lock(home, account.uid, runtime) as transaction:
        pending = _read_bound_state_file(
            transaction.directory_fd,
            ACTIVATION_PENDING_FILE_NAME,
            account.uid,
            missing_ok=True,
        )
        if pending.exists:
            _reject_blocking_activation_pending(pending)
            raise ControllerError(
                "role-activation-required: activation publication is pending"
            )
        receipt_file = _read_bound_state_file(
            transaction.directory_fd,
            ACTIVATION_FILE_NAME,
            account.uid,
            missing_ok=False,
        )
        return _validated_activation_receipt(
            home,
            account,
            snapshot,
            receipt_file,
            requested_host_id=requested_host_id,
            runtime=runtime,
        )


def _preflight_activation_scope(
    home: Path,
    account: Account,
    snapshot: InventorySnapshot,
    *,
    requested_host_id: Optional[str] = None,
) -> EffectiveEntry:
    """Resolve receipt scope without starting a child process.

    This filesystem-only preflight selects the operation fence whose blocking
    state is checked before full machine validation. A fresh in-flight state is
    published later, immediately before the mutating local sync.
    """
    with _open_state_directory(home, account.uid, create=False) as (
        _path,
        directory_fd,
    ):
        pending = _read_bound_state_file(
            directory_fd,
            ACTIVATION_PENDING_FILE_NAME,
            account.uid,
            missing_ok=True,
        )
        if pending.exists:
            _reject_blocking_activation_pending(pending)
            raise ControllerError(
                "role-activation-required: activation publication is pending"
            )
        receipt_file = _read_bound_state_file(
            directory_fd,
            ACTIVATION_FILE_NAME,
            account.uid,
            missing_ok=False,
        )
    assert receipt_file.payload is not None
    receipt = _parse_activation(receipt_file.payload)
    host_id = receipt["host_id"]
    if requested_host_id is not None:
        requested = _validate_host_id(
            requested_host_id,
            "requested host id",
        )
        if requested.casefold() != host_id.casefold():
            raise ControllerError(
                "activation receipt host id does not match requested host"
            )
    if (
        receipt["username"] != account.username
        or receipt["uid"] != account.uid
        or receipt["account_home"] != str(account.home)
        or receipt["codex_home"] != str(home)
    ):
        raise ControllerError("activation receipt account binding is invalid")
    effective = _effective_entry(
        snapshot,
        host_id,
        account,
        allow_implicit_standalone=(
            receipt["entry_source"] == "implicit-gui-default"
        ),
    )
    if (
        receipt["role"] != effective.entry.role
        or receipt["entry_sha256"]
        != _entry_digest(effective.entry, effective.source)
        or receipt["managed_targets"] != list(effective.entry.targets)
    ):
        raise ControllerError("role-activation-required: current host scope changed")
    return replace(
        effective,
        interval_minutes=receipt["interval_minutes"],
    )


def _runner_named_metadata(
    path: Path,
    parent_fd: Optional[int],
    name: Optional[str],
) -> os.stat_result:
    if parent_fd is None:
        return path.lstat()
    return os.stat(name or "", dir_fd=parent_fd, follow_symlinks=False)


def _bind_runner_directory(
    path: Path,
    uid: int,
    opened_fds: List[int],
    *,
    parent_fd: Optional[int] = None,
    name: Optional[str] = None,
) -> _RunnerDirectoryBinding:
    if (parent_fd is None) != (name is None):
        raise ControllerError("runner directory parent and name must be supplied together")
    try:
        named = _runner_named_metadata(path, parent_fd, name)
    except OSError as error:
        raise ControllerError(
            f"canonical runner directory is missing or unreadable: {path}: {error}"
        ) from error
    if not _directory_metadata_is_safe(named, uid, None):
        raise ControllerError(
            f"canonical runner directory access policy is unsafe: {path}"
        )
    flags = os.O_RDONLY
    if hasattr(os, "O_DIRECTORY"):
        flags |= os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        if parent_fd is None:
            fd = os.open(path, flags)
        else:
            fd = os.open(name or "", flags, dir_fd=parent_fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner directory is missing or unreadable: {path}: {error}"
        ) from error
    opened_fds.append(fd)
    opened = os.fstat(fd)
    identity = _metadata_identity(opened)
    if (
        not _directory_metadata_is_safe(opened, uid, None)
        or identity != _metadata_identity(named)
    ):
        raise ControllerError(
            f"canonical runner directory identity or access policy is unsafe: {path}"
        )
    access_policy = _validate_fd_access_policy(
        fd,
        uid,
        f"canonical runner directory {path}",
    )
    return _RunnerDirectoryBinding(
        path=path,
        fd=fd,
        uid=uid,
        identity=identity,
        access_policy=access_policy,
        parent_fd=parent_fd,
        name=name,
    )


def _bind_absolute_runner_directory_chain(
    target: Path,
    uid: int,
    opened_fds: List[int],
    *,
    require_user_owned: Sequence[Path] = (),
) -> Tuple[_RunnerDirectoryBinding, ...]:
    if not target.is_absolute() or not target.parts or target.parts[0] != os.sep:
        raise ControllerError("canonical runner ancestor chain must be absolute")
    required = frozenset(require_user_owned)
    bindings: List[_RunnerDirectoryBinding] = []
    current_path = Path(os.sep)
    root_metadata = current_path.lstat()
    if root_metadata.st_uid not in (0, uid):
        raise ControllerError("canonical runner root owner is not trusted")
    root = _bind_runner_directory(
        current_path,
        root_metadata.st_uid,
        opened_fds,
    )
    bindings.append(root)
    parent = root
    for component in target.parts[1:]:
        current_path /= component
        try:
            named = os.stat(
                component,
                dir_fd=parent.fd,
                follow_symlinks=False,
            )
        except OSError as error:
            raise ControllerError(
                "canonical runner absolute ancestor is missing or unreadable: "
                f"{current_path}: {error}"
            ) from error
        owner = named.st_uid
        if owner not in (0, uid):
            raise ControllerError(
                f"canonical runner absolute ancestor owner is not trusted: {current_path}"
            )
        if current_path in required and owner != uid:
            raise ControllerError(
                f"canonical runner account path must be user-owned: {current_path}"
            )
        parent = _bind_runner_directory(
            current_path,
            owner,
            opened_fds,
            parent_fd=parent.fd,
            name=component,
        )
        bindings.append(parent)
    return tuple(bindings)


def _runner_file_metadata_is_safe(
    metadata: os.stat_result,
    uid: int,
    exact_mode: Optional[int],
    require_executable: bool,
) -> bool:
    mode = stat.S_IMODE(metadata.st_mode)
    return (
        stat.S_ISREG(metadata.st_mode)
        and metadata.st_uid == uid
        and metadata.st_nlink == 1
        and not mode & 0o022
        and (exact_mode is None or mode == exact_mode)
        and (not require_executable or bool(mode & 0o111))
    )


def _validate_darwin_canonical_python_target(
    entry_target: str,
    resolved: Path,
) -> None:
    """Validate the declared CLT Python trust-root layout and version."""
    if Path(entry_target).is_absolute():
        raise ControllerError(
            "Darwin canonical Python entry target must be relative"
        )
    try:
        relative = resolved.relative_to(DARWIN_CANONICAL_PYTHON_VERSIONS)
    except ValueError as error:
        raise ControllerError(
            "Darwin canonical Python target escapes the Command Line Tools trust root"
        ) from error
    if len(relative.parts) != 3 or relative.parts[1] != "bin":
        raise ControllerError("Darwin canonical Python target layout is invalid")
    version_text = relative.parts[0]
    version_parts = version_text.split(".")
    if (
        len(version_parts) != 2
        or any(not part.isdigit() for part in version_parts)
        or relative.parts[2] != f"python{version_text}"
    ):
        raise ControllerError("Darwin canonical Python target version is invalid")
    version = (int(version_parts[0]), int(version_parts[1]))
    if version < MINIMUM_CANONICAL_PYTHON:
        raise ControllerError(
            "Darwin canonical Python target is older than the minimum supported version"
        )


def _resolved_current_python_executable() -> Path:
    """Return the current process's physical Python executable."""
    try:
        return Path(sys.executable).resolve(strict=True)
    except (OSError, RuntimeError) as error:
        raise ControllerError(
            f"current Python interpreter target is unreadable: {error}"
        ) from error


def _bind_runner_file(
    path: Path,
    parent_fd: int,
    name: str,
    uid: int,
    opened_fds: List[int],
    *,
    limit: int,
    exact_mode: Optional[int] = None,
    require_executable: bool = False,
) -> _RunnerFileBinding:
    try:
        named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except OSError as error:
        raise ControllerError(
            f"canonical runner attestation file is missing or unreadable: {path}: {error}"
        ) from error
    if not _runner_file_metadata_is_safe(
        named,
        uid,
        exact_mode,
        require_executable,
    ):
        raise ControllerError(
            f"canonical runner attestation file access policy is unsafe: {path}"
        )
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        fd = os.open(name, flags, dir_fd=parent_fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner attestation file is missing or unreadable: {path}: {error}"
        ) from error
    opened_fds.append(fd)
    opened = os.fstat(fd)
    identity = _metadata_identity(opened)
    if (
        not _runner_file_metadata_is_safe(
            opened,
            uid,
            exact_mode,
            require_executable,
        )
        or identity != _metadata_identity(named)
    ):
        raise ControllerError(
            f"canonical runner attestation file identity is unsafe: {path}"
        )
    access_policy = _validate_fd_access_policy(
        fd,
        uid,
        f"canonical runner attestation file {path}",
    )
    payload = _read_fd_twice(fd, limit, f"canonical runner attestation file {path}")
    return _RunnerFileBinding(
        path=path,
        fd=fd,
        uid=uid,
        identity=identity,
        access_policy=access_policy,
        payload=payload,
        payload_sha256=hashlib.sha256(payload).hexdigest(),
        parent_fd=parent_fd,
        name=name,
        exact_mode=exact_mode,
        require_executable=require_executable,
    )


def _bind_runner_symlink(
    path: Path,
    parent_fd: int,
    name: str,
    uid: int,
    opened_fds: List[int],
    *,
    expected_target: Optional[str] = None,
) -> _RunnerSymlinkBinding:
    try:
        named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        target = os.readlink(name, dir_fd=parent_fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner symlink is missing or unreadable: {path}: {error}"
        ) from error
    if (
        not stat.S_ISLNK(named.st_mode)
        or named.st_uid != uid
        or (expected_target is not None and target != expected_target)
    ):
        raise ControllerError(f"canonical runner symlink binding is unsafe: {path}")
    fd: Optional[int] = None
    access_policy: Optional[Tuple[int, str]] = None
    if sys.platform == "darwin":
        flags = os.O_RDONLY | DARWIN_O_SYMLINK
        if hasattr(os, "O_CLOEXEC"):
            flags |= os.O_CLOEXEC
        try:
            fd = os.open(name, flags, dir_fd=parent_fd)
        except OSError as error:
            raise ControllerError(
                f"canonical runner symlink descriptor is unreadable: {path}: {error}"
            ) from error
        opened_fds.append(fd)
        opened = os.fstat(fd)
        if (
            not stat.S_ISLNK(opened.st_mode)
            or opened.st_uid != uid
            or _metadata_identity(opened) != _metadata_identity(named)
        ):
            raise ControllerError(
                f"canonical runner symlink descriptor binding is unsafe: {path}"
            )
        access_policy = _validate_fd_access_policy(
            fd,
            uid,
            f"canonical runner symlink {path}",
        )
    return _RunnerSymlinkBinding(
        path=path,
        parent_fd=parent_fd,
        name=name,
        uid=uid,
        identity=_metadata_identity(named),
        target=target,
        fd=fd,
        access_policy=access_policy,
    )


def _revalidate_runner_directory(
    binding: _RunnerDirectoryBinding,
    *,
    held_only: bool,
) -> None:
    try:
        opened = os.fstat(binding.fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner directory descriptor is unreadable: {binding.path}: {error}"
        ) from error
    if (
        not _directory_metadata_is_safe(opened, binding.uid, None)
        or _metadata_identity(opened) != binding.identity
        or _validate_fd_access_policy(
            binding.fd,
            binding.uid,
            f"canonical runner directory {binding.path}",
        )
        != binding.access_policy
    ):
        raise ControllerError(
            f"canonical runner directory identity or access policy changed: {binding.path}"
        )
    if held_only:
        return
    try:
        named = _runner_named_metadata(
            binding.path,
            binding.parent_fd,
            binding.name,
        )
    except OSError as error:
        raise ControllerError(
            f"canonical runner directory binding is unreadable: {binding.path}: {error}"
        ) from error
    if (
        not _directory_metadata_is_safe(named, binding.uid, None)
        or _metadata_identity(named) != binding.identity
    ):
        raise ControllerError(
            f"canonical runner directory object was replaced: {binding.path}"
        )


def _revalidate_runner_file(
    binding: _RunnerFileBinding,
    *,
    held_only: bool,
) -> None:
    try:
        opened = os.fstat(binding.fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner attestation descriptor is unreadable: {binding.path}: {error}"
        ) from error
    if (
        not _runner_file_metadata_is_safe(
            opened,
            binding.uid,
            binding.exact_mode,
            binding.require_executable,
        )
        or _metadata_identity(opened) != binding.identity
        or _validate_fd_access_policy(
            binding.fd,
            binding.uid,
            f"canonical runner attestation file {binding.path}",
        )
        != binding.access_policy
    ):
        raise ControllerError(
            f"canonical runner attestation identity or access policy changed: {binding.path}"
        )
    payload = _read_fd_twice(
        binding.fd,
        max(len(binding.payload), 1),
        f"canonical runner attestation file {binding.path}",
    )
    if (
        len(payload) != len(binding.payload)
        or not secrets.compare_digest(
            hashlib.sha256(payload).hexdigest(),
            binding.payload_sha256,
        )
    ):
        raise ControllerError(
            f"canonical runner attestation content changed: {binding.path}"
        )
    if held_only:
        return
    try:
        named = os.stat(
            binding.name,
            dir_fd=binding.parent_fd,
            follow_symlinks=False,
        )
    except OSError as error:
        raise ControllerError(
            f"canonical runner attestation named binding is unreadable: {binding.path}: {error}"
        ) from error
    if (
        not _runner_file_metadata_is_safe(
            named,
            binding.uid,
            binding.exact_mode,
            binding.require_executable,
        )
        or _metadata_identity(named) != binding.identity
    ):
        raise ControllerError(
            f"canonical runner attestation object was replaced: {binding.path}"
        )


def _revalidate_runner_symlink(binding: _RunnerSymlinkBinding) -> None:
    try:
        named = os.stat(
            binding.name,
            dir_fd=binding.parent_fd,
            follow_symlinks=False,
        )
        target = os.readlink(binding.name, dir_fd=binding.parent_fd)
    except OSError as error:
        raise ControllerError(
            f"canonical runner symlink binding is unreadable: {binding.path}: {error}"
        ) from error
    if (
        not stat.S_ISLNK(named.st_mode)
        or named.st_uid != binding.uid
        or _metadata_identity(named) != binding.identity
        or target != binding.target
    ):
        raise ControllerError(
            f"canonical runner symlink identity or target changed: {binding.path}"
        )
    if binding.fd is not None:
        opened = os.fstat(binding.fd)
        if (
            _metadata_identity(opened) != binding.identity
            or _validate_fd_access_policy(
                binding.fd,
                binding.uid,
                f"canonical runner symlink {binding.path}",
            )
            != binding.access_policy
        ):
            raise ControllerError(
                f"canonical runner symlink access policy changed: {binding.path}"
            )


def _parse_exact_release_target(target: str, label: str) -> str:
    path = PurePosixPath(target)
    if (
        path.is_absolute()
        or len(path.parts) != 2
        or path.parts[0] != "releases"
        or FULL_SHA_RE.fullmatch(path.parts[1]) is None
    ):
        raise ControllerError(f"{label} is not an exact release target")
    return path.parts[1]


def _parse_private_runner_manifest(payload: bytes) -> Tuple[str, str]:
    raw = _bounded_json(payload, "private installed sync manifest")
    if not isinstance(raw, dict):
        raise ControllerError("private installed sync manifest must be an object")
    _require_exact_keys(
        raw,
        ("version", "owner", "base_release", "links", "removed_links", "reference_only"),
        "private installed sync manifest",
    )
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("private installed sync manifest version must be 1")
    if raw["owner"] != PRIVATE_OWNER:
        raise ControllerError("private installed sync manifest owner is invalid")
    base_release = raw["base_release"]
    if not isinstance(base_release, dict):
        raise ControllerError("private installed sync manifest base_release is invalid")
    _require_exact_keys(
        base_release,
        ("repo", "sha"),
        "private installed sync manifest base_release",
    )
    repo = base_release["repo"]
    sha = base_release["sha"]
    if repo != PUBLIC_REPO:
        raise ControllerError("private installed sync manifest base repo is invalid")
    if not isinstance(sha, str) or FULL_SHA_RE.fullmatch(sha) is None:
        raise ControllerError("private installed sync manifest base sha is invalid")
    references = raw["reference_only"]
    if not isinstance(references, list) or any(
        not isinstance(reference, str) for reference in references
    ):
        raise ControllerError("private installed sync manifest reference_only is invalid")
    for required in (PRIVATE_SOURCE_LOCK_PATH, GENERATED_SOURCE_LOCK_PATH):
        if references.count(required) != 1:
            raise ControllerError(
                f"private installed sync manifest must bind exactly one {required}"
            )
    return repo, sha


def _parse_private_source_lock(
    payload: bytes,
    *,
    base_repo: str,
    base_sha: str,
    generated_payload: bytes,
) -> Tuple[str, str]:
    raw = _bounded_json(payload, "private overlay source lock")
    if not isinstance(raw, dict):
        raise ControllerError("private overlay source lock must be an object")
    _require_exact_keys(
        raw,
        ("version", "sources", "toolbox_generated_provenance"),
        "private overlay source lock",
    )
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("private overlay source lock version must be 1")
    sources = raw["sources"]
    if not isinstance(sources, list) or not sources or len(sources) > 64:
        raise ControllerError("private overlay source lock sources are invalid")
    toolbox_sources: List[Mapping[str, Any]] = []
    for source in sources:
        if not isinstance(source, dict):
            raise ControllerError("private overlay source lock source is invalid")
        _require_exact_keys(
            source,
            ("name", "repository", "sha", "tree"),
            "private overlay source lock source",
        )
        if source["name"] == "codex-toolbox" or source["repository"] == base_repo:
            toolbox_sources.append(source)
    if len(toolbox_sources) != 1:
        raise ControllerError(
            "private overlay source lock must contain one exact codex-toolbox source"
        )
    toolbox = toolbox_sources[0]
    if (
        toolbox["name"] != "codex-toolbox"
        or toolbox["repository"] != base_repo
        or toolbox["sha"] != base_sha
        or not isinstance(toolbox["tree"], str)
        or FULL_SHA_RE.fullmatch(toolbox["tree"]) is None
    ):
        raise ControllerError(
            "private overlay source lock toolbox source does not match base release"
        )
    provenance = raw["toolbox_generated_provenance"]
    if not isinstance(provenance, dict):
        raise ControllerError("private overlay generated provenance is invalid")
    _require_exact_keys(
        provenance,
        ("repository", "sha", "receipt_sha256"),
        "private overlay generated provenance",
    )
    repository = provenance["repository"]
    sha = provenance["sha"]
    receipt = provenance["receipt_sha256"]
    if (
        repository != CANONICAL_SOURCE_REPO
        or not isinstance(sha, str)
        or FULL_SHA_RE.fullmatch(sha) is None
        or not isinstance(receipt, str)
        or TREE_SHA256_RE.fullmatch(receipt) is None
        or not secrets.compare_digest(
            receipt,
            hashlib.sha256(generated_payload).hexdigest(),
        )
    ):
        raise ControllerError(
            "private overlay generated provenance does not bind the generated source lock"
        )
    return repository, sha


def _parse_generated_runner_lock(
    payload: bytes,
    *,
    canonical_repository: str,
    canonical_sha: str,
) -> str:
    raw = _bounded_json(payload, "generated sync source lock")
    if not isinstance(raw, dict):
        raise ControllerError("generated sync source lock must be an object")
    _require_exact_keys(
        raw,
        (
            "canonical_commit",
            "canonical_repository",
            "file_set_digest",
            "files",
            "generator_contract_version",
            "hash_algorithm",
            "mapping_digest",
            "mirror",
            "mirror_repository",
            "receipt_version",
            "rules_contract_version",
            "tree_digest",
        ),
        "generated sync source lock",
    )
    if (
        raw["canonical_repository"] != canonical_repository
        or raw["canonical_commit"] != canonical_sha
        or raw["hash_algorithm"] != "sha256"
        or type(raw["receipt_version"]) is not int
        or raw["receipt_version"] != VERSION
    ):
        raise ControllerError("generated sync source lock provenance is invalid")
    files = raw["files"]
    if not isinstance(files, list) or not files or len(files) > 64:
        raise ControllerError("generated sync source lock files are invalid")
    engines: List[Mapping[str, Any]] = []
    for entry in files:
        if not isinstance(entry, dict):
            raise ControllerError("generated sync source lock file entry is invalid")
        _require_exact_keys(
            entry,
            ("mode", "sha256", "source_name", "source_path", "target_path"),
            "generated sync source lock file entry",
        )
        if (
            entry["source_name"] == "engine"
            or entry["source_path"] == CANONICAL_RUNNER_SOURCE
            or entry["target_path"] == CANONICAL_RUNNER_SOURCE
        ):
            engines.append(entry)
    if len(engines) != 1:
        raise ControllerError(
            "generated sync source lock must contain one exact canonical engine"
        )
    engine = engines[0]
    digest = engine["sha256"]
    if (
        engine["source_name"] != "engine"
        or engine["source_path"] != CANONICAL_RUNNER_SOURCE
        or engine["target_path"] != CANONICAL_RUNNER_SOURCE
        or engine["mode"] != CANONICAL_RUNNER_MODE
        or not isinstance(digest, str)
        or TREE_SHA256_RE.fullmatch(digest) is None
    ):
        raise ControllerError("generated sync source lock canonical engine is invalid")
    return digest


def _validate_public_runner_manifest(payload: bytes) -> None:
    raw = _bounded_json(payload, "public installed sync manifest")
    if not isinstance(raw, dict):
        raise ControllerError("public installed sync manifest must be an object")
    if type(raw.get("version")) is not int or raw["version"] != VERSION:
        raise ControllerError("public installed sync manifest version must be 1")
    if raw.get("owner", "public") != "public":
        raise ControllerError("public installed sync manifest owner is invalid")
    links = raw.get("links")
    if not isinstance(links, list):
        raise ControllerError("public installed sync manifest links are invalid")
    exact = {
        "source": CANONICAL_RUNNER_SOURCE,
        "target": CANONICAL_RUNNER_TARGET,
        "kind": "file",
    }
    collisions = [
        link
        for link in links
        if isinstance(link, dict)
        and (
            link.get("source") == CANONICAL_RUNNER_SOURCE
            or link.get("target") == CANONICAL_RUNNER_TARGET
        )
    ]
    if collisions != [exact]:
        raise ControllerError(
            "public installed sync manifest must contain one exact canonical runner link"
        )


def _revalidate_canonical_runner_binding(
    binding: CanonicalRunnerBinding,
    *,
    held_only: bool,
) -> None:
    # Protected properties are object identity, exact content hash, and the
    # selected owner/group/mode/link/ACL access policy. Directory timestamps and
    # link counts are deliberately ignored so benign child-entry churn remains
    # safe.
    for directory in binding.directories:
        _revalidate_runner_directory(directory, held_only=held_only)
    for file_binding in binding.files:
        _revalidate_runner_file(file_binding, held_only=held_only)
    if not held_only:
        for symlink in binding.symlinks:
            _revalidate_runner_symlink(symlink)
        if binding.interpreter_entry is not None:
            try:
                resolved_interpreter = os.stat(
                    binding.interpreter_entry.name,
                    dir_fd=binding.interpreter_entry.parent_fd,
                    follow_symlinks=True,
                )
            except OSError as error:
                raise ControllerError(
                    f"canonical interpreter entry is unreadable: {error}"
                ) from error
            interpreter = os.fstat(binding.interpreter_file.fd)
            if (
                not stat.S_ISREG(resolved_interpreter.st_mode)
                or (resolved_interpreter.st_dev, resolved_interpreter.st_ino)
                != (interpreter.st_dev, interpreter.st_ino)
            ):
                raise ControllerError(
                    "canonical interpreter entry does not resolve to the attested object"
                )
        if binding.live_runner is not None:
            try:
                resolved = os.stat(
                    binding.live_runner.name,
                    dir_fd=binding.live_runner.parent_fd,
                    follow_symlinks=True,
                )
            except OSError as error:
                raise ControllerError(
                    f"canonical live runner target is unreadable: {error}"
                ) from error
            runner = os.fstat(binding.runner_file.fd)
            if (
                not stat.S_ISREG(resolved.st_mode)
                or (resolved.st_dev, resolved.st_ino)
                != (runner.st_dev, runner.st_ino)
            ):
                raise ControllerError(
                    "canonical live runner does not resolve to the attested object"
                )
    # Make both pathname arguments the final fallible validation. The native
    # interpreter is argv[0]; after fixed isolation flags it opens the attested
    # physical runner path.
    _revalidate_runner_file(binding.interpreter_file, held_only=held_only)
    _revalidate_runner_file(binding.runner_file, held_only=held_only)


@contextmanager
def _canonical_runner_binding(
    home: Path,
    uid: int,
    *,
    require_live_state: bool,
) -> Iterator[CanonicalRunnerBinding]:
    if tuple(sys.version_info[:2]) < MINIMUM_CANONICAL_PYTHON:
        raise ControllerError(
            "canonical runner controller requires Python "
            f"{MINIMUM_CANONICAL_PYTHON[0]}.{MINIMUM_CANONICAL_PYTHON[1]} or newer"
        )
    opened_fds: List[int] = []
    directories: List[_RunnerDirectoryBinding] = []
    files: List[_RunnerFileBinding] = []
    symlinks: List[_RunnerSymlinkBinding] = []
    try:
        home_chain = _bind_absolute_runner_directory_chain(
            home,
            uid,
            opened_fds,
            require_user_owned=(home.parent, home),
        )
        directories.extend(home_chain)
        home_binding = home_chain[-1]
        personal_sync_path = home / "personal-sync"
        personal_sync = _bind_runner_directory(
            personal_sync_path,
            uid,
            opened_fds,
            parent_fd=home_binding.fd,
            name="personal-sync",
        )
        directories.append(personal_sync)
        overlays_path = personal_sync_path / "overlays"
        overlays = _bind_runner_directory(
            overlays_path,
            uid,
            opened_fds,
            parent_fd=personal_sync.fd,
            name="overlays",
        )
        directories.append(overlays)
        private_path = overlays_path / PRIVATE_OWNER
        private_overlay = _bind_runner_directory(
            private_path,
            uid,
            opened_fds,
            parent_fd=overlays.fd,
            name=PRIVATE_OWNER,
        )
        directories.append(private_overlay)
        private_current = _bind_runner_symlink(
            private_path / "current",
            private_overlay.fd,
            "current",
            uid,
            opened_fds,
        )
        symlinks.append(private_current)
        private_sha = _parse_exact_release_target(
            private_current.target,
            "private current pointer",
        )
        private_releases_path = private_path / "releases"
        private_releases = _bind_runner_directory(
            private_releases_path,
            uid,
            opened_fds,
            parent_fd=private_overlay.fd,
            name="releases",
        )
        directories.append(private_releases)
        private_release_path = private_releases_path / private_sha
        private_release = _bind_runner_directory(
            private_release_path,
            uid,
            opened_fds,
            parent_fd=private_releases.fd,
            name=private_sha,
        )
        directories.append(private_release)
        private_personal_path = private_release_path / "personal_codex"
        private_personal = _bind_runner_directory(
            private_personal_path,
            uid,
            opened_fds,
            parent_fd=private_release.fd,
            name="personal_codex",
        )
        directories.append(private_personal)
        private_manifest = _bind_runner_file(
            private_personal_path / "sync-manifest.json",
            private_personal.fd,
            "sync-manifest.json",
            uid,
            opened_fds,
            limit=MAX_RUNNER_ATTESTATION_BYTES,
        )
        files.append(private_manifest)
        base_repo, base_sha = _parse_private_runner_manifest(private_manifest.payload)
        private_source_lock = _bind_runner_file(
            private_release_path / PRIVATE_SOURCE_LOCK_PATH,
            private_release.fd,
            PRIVATE_SOURCE_LOCK_PATH,
            uid,
            opened_fds,
            limit=MAX_RUNNER_ATTESTATION_BYTES,
        )
        files.append(private_source_lock)
        generated_source_lock = _bind_runner_file(
            private_release_path / GENERATED_SOURCE_LOCK_PATH,
            private_release.fd,
            GENERATED_SOURCE_LOCK_PATH,
            uid,
            opened_fds,
            limit=MAX_RUNNER_ATTESTATION_BYTES,
        )
        files.append(generated_source_lock)
        canonical_repo, canonical_sha = _parse_private_source_lock(
            private_source_lock.payload,
            base_repo=base_repo,
            base_sha=base_sha,
            generated_payload=generated_source_lock.payload,
        )
        expected_runner_sha256 = _parse_generated_runner_lock(
            generated_source_lock.payload,
            canonical_repository=canonical_repo,
            canonical_sha=canonical_sha,
        )

        public_releases_path = personal_sync_path / "releases"
        public_releases = _bind_runner_directory(
            public_releases_path,
            uid,
            opened_fds,
            parent_fd=personal_sync.fd,
            name="releases",
        )
        directories.append(public_releases)
        public_release_path = public_releases_path / base_sha
        public_release = _bind_runner_directory(
            public_release_path,
            uid,
            opened_fds,
            parent_fd=public_releases.fd,
            name=base_sha,
        )
        directories.append(public_release)
        scripts_path = public_release_path / "scripts"
        scripts = _bind_runner_directory(
            scripts_path,
            uid,
            opened_fds,
            parent_fd=public_release.fd,
            name="scripts",
        )
        directories.append(scripts)
        runner = _bind_runner_file(
            scripts_path / "codex_personal_sync.py",
            scripts.fd,
            "codex_personal_sync.py",
            uid,
            opened_fds,
            limit=MAX_CANONICAL_RUNNER_BYTES,
            exact_mode=0o755,
        )
        files.append(runner)
        if not secrets.compare_digest(
            runner.payload_sha256,
            expected_runner_sha256,
        ):
            raise ControllerError(
                "canonical physical runner hash does not match the generated source lock"
            )

        interpreter_entry: Optional[_RunnerSymlinkBinding] = None
        if sys.platform == "darwin":
            # The fixed Command Line Tools Python is a declared macOS trust
            # root. Binding its entry, resolved payload, and filesystem chain
            # does not attest publisher or code-signing provenance.
            raw_interpreter_path = DARWIN_CANONICAL_PYTHON
        else:
            raw_interpreter_path = _resolved_current_python_executable()
        if not raw_interpreter_path.is_absolute() or not raw_interpreter_path.name:
            raise ControllerError("current Python interpreter path is not absolute")
        interpreter_entry_chain = _bind_absolute_runner_directory_chain(
            raw_interpreter_path.parent,
            uid,
            opened_fds,
        )
        directories.extend(interpreter_entry_chain)
        interpreter_entry_parent = interpreter_entry_chain[-1]
        interpreter_label = (
            "Darwin Command Line Tools Python"
            if sys.platform == "darwin"
            else "current Python interpreter"
        )
        try:
            interpreter_entry_metadata = os.stat(
                raw_interpreter_path.name,
                dir_fd=interpreter_entry_parent.fd,
                follow_symlinks=False,
            )
        except OSError as error:
            raise ControllerError(
                f"{interpreter_label} entry is missing or unreadable: {error}"
            ) from error
        if interpreter_entry_metadata.st_uid not in (0, uid):
            raise ControllerError(f"{interpreter_label} owner is not trusted")
        if sys.platform == "darwin" and not stat.S_ISLNK(
            interpreter_entry_metadata.st_mode
        ):
            raise ControllerError(
                "Darwin canonical Python entry is not the expected symlink"
            )
        if stat.S_ISLNK(interpreter_entry_metadata.st_mode):
            interpreter_entry = _bind_runner_symlink(
                raw_interpreter_path,
                interpreter_entry_parent.fd,
                raw_interpreter_path.name,
                interpreter_entry_metadata.st_uid,
                opened_fds,
            )
            symlinks.append(interpreter_entry)
            try:
                interpreter_path = raw_interpreter_path.resolve(strict=True)
            except (OSError, RuntimeError) as error:
                raise ControllerError(
                    f"{interpreter_label} target is unreadable: {error}"
                ) from error
            if sys.platform == "darwin":
                _validate_darwin_canonical_python_target(
                    interpreter_entry.target,
                    interpreter_path,
                )
            interpreter_chain = _bind_absolute_runner_directory_chain(
                interpreter_path.parent,
                uid,
                opened_fds,
            )
            directories.extend(interpreter_chain)
            interpreter_parent = interpreter_chain[-1]
        elif stat.S_ISREG(interpreter_entry_metadata.st_mode):
            interpreter_path = raw_interpreter_path
            interpreter_parent = interpreter_entry_parent
        else:
            raise ControllerError(
                f"{interpreter_label} entry is neither a regular file nor symlink"
            )
        interpreter_metadata = os.stat(
            interpreter_path.name,
            dir_fd=interpreter_parent.fd,
            follow_symlinks=False,
        )
        if interpreter_metadata.st_uid not in (0, uid):
            raise ControllerError(
                f"{interpreter_label} target owner is not trusted"
            )
        interpreter = _bind_runner_file(
            interpreter_path,
            interpreter_parent.fd,
            interpreter_path.name,
            interpreter_metadata.st_uid,
            opened_fds,
            limit=MAX_CANONICAL_INTERPRETER_BYTES,
            require_executable=True,
        )
        files.append(interpreter)

        live_runner: Optional[_RunnerSymlinkBinding] = None
        if require_live_state:
            public_current = _bind_runner_symlink(
                personal_sync_path / "current",
                personal_sync.fd,
                "current",
                uid,
                opened_fds,
                expected_target=f"releases/{base_sha}",
            )
            symlinks.append(public_current)
            public_personal_path = public_release_path / "personal_codex"
            public_personal = _bind_runner_directory(
                public_personal_path,
                uid,
                opened_fds,
                parent_fd=public_release.fd,
                name="personal_codex",
            )
            directories.append(public_personal)
            public_manifest = _bind_runner_file(
                public_personal_path / "sync-manifest.json",
                public_personal.fd,
                "sync-manifest.json",
                uid,
                opened_fds,
                limit=MAX_RUNNER_ATTESTATION_BYTES,
            )
            files.append(public_manifest)
            _validate_public_runner_manifest(public_manifest.payload)
            bin_path = home / "bin"
            bin_directory = _bind_runner_directory(
                bin_path,
                uid,
                opened_fds,
                parent_fd=home_binding.fd,
                name="bin",
            )
            directories.append(bin_directory)
            live_runner = _bind_runner_symlink(
                bin_path / "codex-personal-sync",
                bin_directory.fd,
                "codex-personal-sync",
                uid,
                opened_fds,
                expected_target=CANONICAL_RUNNER_LIVE_TARGET,
            )
            symlinks.append(live_runner)

        binding = CanonicalRunnerBinding(
            executable=str(runner.path),
            private_release_sha=private_sha,
            public_release_sha=base_sha,
            directories=tuple(directories),
            files=tuple(files),
            symlinks=tuple(symlinks),
            interpreter_file=interpreter,
            interpreter_entry=interpreter_entry,
            runner_file=runner,
            live_runner=live_runner,
        )
        binding.revalidate()
        yield binding
    finally:
        for fd in reversed(opened_fds):
            try:
                os.close(fd)
            except OSError:
                pass


def _select_canonical_primary_error(
    errors: Sequence[BaseException],
) -> BaseException:
    if not errors:
        raise AssertionError("canonical error selection requires at least one error")
    cleanup = next(
        (
            error
            for error in errors
            if isinstance(error, ProcessCleanupInconclusiveError)
        ),
        None,
    )
    if cleanup is not None:
        return cleanup
    control_flow = next(
        (
            error
            for error in errors
            if isinstance(error, (_ManagedProcessSignal, KeyboardInterrupt))
        ),
        None,
    )
    if control_flow is not None:
        return control_flow
    return next(
        (error for error in errors if isinstance(error, StatePublicationError)),
        errors[0],
    )


def _revalidate_canonical_gate(
    binding: CanonicalRunnerBinding,
    caller_fence: Optional[Callable[[], None]],
    *,
    held_only: bool,
) -> None:
    revalidate = binding.revalidate_held if held_only else binding.revalidate
    checks: Tuple[Callable[[], None], ...]
    if caller_fence is None:
        checks = (revalidate, revalidate)
    else:
        checks = (caller_fence, revalidate, caller_fence, revalidate)
    errors: List[BaseException] = []
    for check in checks:
        try:
            check()
        except BaseException as error:
            errors.append(error)
    if not errors:
        return
    # A cleanup uncertainty or durable caller-fence failure must not be
    # downgraded to an ordinary runner-validation error merely because the
    # latter happened first during the full C,R,C,R sandwich.
    primary = _select_canonical_primary_error(errors)
    secondary = next((error for error in errors if error is not primary), None)
    if secondary is not None:
        raise primary from secondary
    raise primary


def _run_canonical_command(
    runtime: Runtime,
    home: Path,
    args: Sequence[str],
    *,
    before_spawn: Optional[Callable[[], None]] = None,
    mutates_release: bool = False,
) -> CommandResult:
    if not args or any(not isinstance(value, str) or not value for value in args):
        raise ControllerError("canonical runner arguments must be non-empty strings")
    account = runtime.account()
    with _canonical_runner_binding(
        home,
        account.uid,
        require_live_state=not mutates_release,
    ) as binding:
        def gate() -> None:
            _revalidate_canonical_gate(
                binding,
                before_spawn,
                held_only=False,
            )

        primary: Optional[BaseException] = None
        try:
            # This pathname-to-Popen gate constrains cooperative/non-owner
            # replacement. It cannot exclude same-UID or root replacement in
            # the residual interval after the final named-object check. Python
            # isolated/no-site flags prevent inherited PYTHONPATH, user-site,
            # and sitecustomize code from running before the attested script.
            result = runtime.run(
                (
                    str(binding.interpreter_file.path),
                    *CANONICAL_PYTHON_FLAGS,
                    binding.executable,
                    *args,
                ),
                timeout=COMMAND_TIMEOUT_SECONDS,
                output_limit=MAX_COMMAND_OUTPUT_BYTES,
                before_spawn=gate,
            )
        except BaseException as error:
            primary = error
        post_error: Optional[BaseException] = None
        try:
            _revalidate_canonical_gate(
                binding,
                before_spawn,
                held_only=mutates_release,
            )
        except BaseException as error:
            post_error = error
        if primary is not None:
            if post_error is not None:
                selected = _select_canonical_primary_error((primary, post_error))
                secondary = post_error if selected is primary else primary
                raise selected.with_traceback(selected.__traceback__) from secondary
            raise primary.with_traceback(primary.__traceback__)
        if post_error is not None:
            raise post_error
        return result


def _validate_new_canonical_binding(
    runtime: Runtime,
    home: Path,
    before_spawn: Optional[Callable[[], None]],
) -> None:
    account = runtime.account()
    with _canonical_runner_binding(
        home,
        account.uid,
        require_live_state=True,
    ) as binding:
        _revalidate_canonical_gate(
            binding,
            before_spawn,
            held_only=False,
        )


def _private_runner(home: Path) -> str:
    return str(home / "bin" / "codex-private-macos-sync")


def _require_success(result: CommandResult, label: str) -> None:
    if result.timed_out:
        raise ControllerError(f"{label} timed out")
    if result.output_overflow:
        raise ControllerError(f"{label} exceeded its output bound")
    if result.returncode != 0:
        raise ControllerError(f"{label} failed with exit {result.returncode}")


def _resolve_activation_candidate(
    runtime: Runtime,
    snapshot: InventorySnapshot,
    account: Account,
    requested_host_id: Optional[str],
) -> EffectiveEntry:
    host_id = _resolve_host_id(snapshot.inventory, runtime, requested_host_id)
    explicit = snapshot.inventory.hosts.get(host_id)
    if explicit is None:
        if not _gui_domain_is_live(runtime, account.uid):
            raise ControllerError(
                "role-activation-required: unlisted headless macOS hosts are not "
                "auto-activated"
            )
        return _effective_entry(
            snapshot,
            host_id,
            account,
            allow_implicit_standalone=True,
        )
    effective = _effective_entry(
        snapshot,
        host_id,
        account,
        allow_implicit_standalone=False,
    )
    if effective.entry.role in (
        "gui-controller",
        "gui-standalone",
    ) and not _gui_domain_is_live(runtime, account.uid):
        raise ControllerError(
            f"gui-session-required: explicit role {effective.entry.role} "
            "requires a live Aqua domain"
        )
    return effective


def activate(
    runtime: Runtime,
    raw_home: Path,
    *,
    requested_host_id: Optional[str],
    interval_minutes: int,
) -> EffectiveEntry:
    account = runtime.account()
    home = _codex_home(raw_home, account)
    with _open_home_directory_descriptor(home, account.uid) as (
        _home_fd,
        revalidate_home,
    ):
        _verify_private_runner(
            runtime,
            home,
            before_spawn=revalidate_home,
        )
    with _host_mutation_lock(home, account.uid, runtime) as host_transaction:
        snapshot = _load_current_inventory(home, account.uid)
        effective = _resolve_activation_candidate(
            runtime,
            snapshot,
            account,
            requested_host_id,
        )
        controller_id = effective.entry.controller or effective.entry.host_id
        scope_sha256 = _operation_scope_digest(
            "activation",
            effective.entry,
            effective.entry,
        )
        directory_fd = host_transaction.directory_fd
        state_name = host_transaction.state_name
        revalidate_host = host_transaction.revalidate
        _snapshot, state_value = _read_operation_state(
            directory_fd,
            state_name,
            account.uid,
            "activation",
            effective.entry.host_id,
            controller_id,
            scope_sha256,
        )
        _reject_blocking_operation_state(state_value)
        with _activation_lock(home, account.uid, runtime) as activation_transaction:
            current_snapshot = _load_current_inventory(home, account.uid)
            current_effective = _resolve_activation_candidate(
                runtime,
                current_snapshot,
                account,
                requested_host_id,
            )
            if (
                current_snapshot.fingerprint() != snapshot.fingerprint()
                or current_effective != effective
            ):
                raise ControllerError(
                    "role-activation-required: activation scope changed while "
                    "acquiring locks"
                )
            activation_payload = _activation_payload(
                effective,
                account,
                home,
                runtime.machine_identity_sha256(),
                (
                    interval_minutes
                    if effective.entry.role in ("gui-controller", "gui-standalone")
                    else None
                ),
            )
            with _operation_attempt(
                directory_fd,
                state_name,
                account.uid,
                "activation",
                effective.entry.host_id,
                controller_id,
                scope_sha256,
                revalidate_host,
            ) as host_fence:

                def revalidate_before_pending() -> None:
                    _revalidate_named_state_fences((host_fence,))
                    _revalidate_activation_transaction(activation_transaction)

                # Reject known orphan or legacy blockers before creating a new
                # activation sentinel, then repeat the bounded audit after the
                # sentinel is durable to close the pre-installer race.
                _audit_activation_state_directory(
                    activation_transaction.directory_fd,
                    account.uid,
                    revalidate_before_pending,
                )
                _begin_activation_publication(
                    activation_transaction,
                    account,
                    activation_payload,
                )
                assert activation_transaction.pending_snapshot is not None
                assert activation_transaction.pending_payload is not None
                activation_fence = NamedStateFence(
                    directory_fd=activation_transaction.directory_fd,
                    name=ACTIVATION_PENDING_FILE_NAME,
                    uid=account.uid,
                    snapshot=activation_transaction.pending_snapshot,
                    payload=activation_transaction.pending_payload,
                    revalidate=lambda: _revalidate_activation_transaction(
                        activation_transaction
                    ),
                    label="activation pending",
                )
                revalidate_spawn = _named_state_fence_callback(
                    host_fence,
                    activation_fence,
                )
                _audit_activation_state_directory(
                    activation_transaction.directory_fd,
                    account.uid,
                    revalidate_spawn,
                )
                _rebind_activation_target_states(
                    runtime,
                    home,
                    account,
                    effective,
                    current_snapshot,
                    (host_fence, activation_fence),
                )
                _audit_activation_state_directory(
                    activation_transaction.directory_fd,
                    account.uid,
                    revalidate_spawn,
                )
                if effective.entry.role in ("gui-controller", "gui-standalone"):
                    args = (
                        "install-scheduler",
                        "--repo",
                        PRIVATE_REPO,
                        "--mode",
                        "private",
                        "--base-repo",
                        PUBLIC_REPO,
                        "--owner",
                        PRIVATE_OWNER,
                        "--home",
                        str(home),
                        "--interval-minutes",
                        str(interval_minutes),
                        "--platform",
                        "macos",
                        "--runner",
                        _private_runner(home),
                    )
                    try:
                        enabled = _run_canonical_command(
                            runtime,
                            home,
                            args,
                            before_spawn=revalidate_spawn,
                        )
                    except ProcessCleanupInconclusiveError as cleanup_error:
                        try:
                            _quarantine_activation_process_cleanup(
                                activation_transaction,
                                account,
                            )
                        except BaseException as publication_error:
                            raise ProcessCleanupInconclusiveError(
                                "activation process cleanup was inconclusive "
                                "and durable quarantine publication failed: "
                                f"{publication_error}"
                            ) from publication_error
                        raise cleanup_error
                    except StatePublicationError:
                        # The named blocking sentinel no longer matches the
                        # object we published. It cannot be safely downgraded.
                        raise
                    except BaseException:
                        _mark_activation_retryable(
                            activation_transaction,
                            account,
                        )
                        raise
                    if (
                        enabled.timed_out
                        or enabled.output_overflow
                        or enabled.returncode != 0
                    ):
                        _mark_activation_retryable(
                            activation_transaction,
                            account,
                        )
                        _require_success(enabled, "Aqua scheduler activation")
                try:
                    scheduler = _scheduler_health(
                        runtime,
                        home,
                        effective.entry.role,
                        expected_interval_minutes=activation_payload[
                            "interval_minutes"
                        ],
                        before_spawn=revalidate_spawn,
                    )
                except ProcessCleanupInconclusiveError as cleanup_error:
                    try:
                        _quarantine_activation_process_cleanup(
                            activation_transaction,
                            account,
                        )
                    except BaseException as publication_error:
                        raise ProcessCleanupInconclusiveError(
                            "activation process cleanup was inconclusive and "
                            "durable quarantine publication failed: "
                            f"{publication_error}"
                        ) from publication_error
                    raise cleanup_error
                if not scheduler["healthy"]:
                    raise ControllerError(
                        "scheduler activation could not be proved committed: "
                        f"{scheduler['reason']}"
                    )
                try:
                    _verify_private_runner(
                        runtime,
                        home,
                        before_spawn=revalidate_spawn,
                    )
                except ProcessCleanupInconclusiveError as cleanup_error:
                    try:
                        _quarantine_activation_process_cleanup(
                            activation_transaction,
                            account,
                        )
                    except BaseException as publication_error:
                        raise ProcessCleanupInconclusiveError(
                            "activation process cleanup was inconclusive and "
                            "durable quarantine publication failed: "
                            f"{publication_error}"
                        ) from publication_error
                    raise cleanup_error
                except StatePublicationError:
                    raise
                _audit_activation_state_directory(
                    activation_transaction.directory_fd,
                    account.uid,
                    revalidate_spawn,
                )
                revalidate_spawn()
                try:
                    _publish_activation(
                        activation_transaction,
                        account,
                        activation_payload,
                    )
                except StatePublicationError:
                    _mark_activation_retryable(
                        activation_transaction,
                        account,
                    )
                    raise
        if not activation_transaction.committed:
            raise RuntimeError("activation transaction did not reach its commit point")
        # No fallible state operation may run after sentinel removal. The host
        # fence was already cleared while both locks remained held; this flag
        # makes the outer host-lock finalizer perform only best-effort cleanup.
        host_transaction.activation_committed = True
        return replace(
            effective,
            interval_minutes=activation_payload["interval_minutes"],
        )


def _identity_tree(raw: Any, owner: str) -> Dict[str, str]:
    if not isinstance(raw, dict):
        raise ControllerError(f"release identity {owner} must be an object")
    _require_exact_keys(raw, ("sha", "tree_sha256"), f"release identity {owner}")
    sha = raw["sha"]
    tree = raw["tree_sha256"]
    if not isinstance(sha, str) or FULL_SHA_RE.fullmatch(sha) is None:
        raise ControllerError(f"release identity {owner} sha is invalid")
    if not isinstance(tree, str) or TREE_SHA256_RE.fullmatch(tree) is None:
        raise ControllerError(f"release identity {owner} tree digest is invalid")
    return {"sha": sha, "tree_sha256": tree}


def _parse_release_identities(payload: bytes) -> Dict[str, Dict[str, str]]:
    raw = _bounded_json(payload, "release identities")
    if not isinstance(raw, dict):
        raise ControllerError("release identities must be an object")
    _require_exact_keys(raw, ("version", "mode", "release_trees"), "release identities")
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("release identities version must be 1")
    if raw["mode"] != "private":
        raise ControllerError("release identities mode must be private")
    trees = raw["release_trees"]
    if not isinstance(trees, dict):
        raise ControllerError("release identity trees must be an object")
    _require_exact_keys(trees, ("public", "private"), "release identity trees")
    return {
        "public": _identity_tree(trees["public"], "public"),
        "private": _identity_tree(trees["private"], "private"),
    }


def _read_release_identities(
    runtime: Runtime,
    home: Path,
    *,
    before_spawn: Optional[Callable[[], None]] = None,
) -> Dict[str, Dict[str, str]]:
    result = _run_canonical_command(
        runtime,
        home,
        (
            "release-identities",
            "--mode",
            "private",
            "--owner",
            PRIVATE_OWNER,
            "--home",
            str(home),
            "--json",
        ),
        before_spawn=before_spawn,
    )
    _require_success(result, "release identity query")
    return _parse_release_identities(result.stdout)


def _run_local_sync(
    runtime: Runtime,
    home: Path,
    *,
    before_spawn: Optional[Callable[[], None]] = None,
) -> None:
    result = _run_canonical_command(
        runtime,
        home,
        (
            "run-scheduled",
            "--mode",
            "private",
            "--repo",
            PRIVATE_REPO,
            "--base-repo",
            PUBLIC_REPO,
            "--owner",
            PRIVATE_OWNER,
            "--home",
            str(home),
        ),
        before_spawn=before_spawn,
        mutates_release=True,
    )
    _require_success(result, "local private scheduled sync")
    _validate_new_canonical_binding(runtime, home, before_spawn)


def _run_required_command(
    runtime: Runtime,
    home: Path,
    args: Sequence[str],
    label: str,
    *,
    before_spawn: Optional[Callable[[], None]] = None,
) -> None:
    result = _run_canonical_command(
        runtime,
        home,
        args,
        before_spawn=before_spawn,
    )
    _require_success(result, label)


def _verify_private_runner(
    runtime: Runtime,
    home: Path,
    *,
    before_spawn: Optional[Callable[[], None]] = None,
) -> None:
    _run_required_command(
        runtime,
        home,
        (
            "verify-overlay",
            "--home",
            str(home),
            "--owner",
            PRIVATE_OWNER,
        ),
        "private runner verification",
        before_spawn=before_spawn,
    )


def _strict_local_verification(
    runtime: Runtime,
    home: Path,
    *,
    before_spawn: Optional[Callable[[], None]] = None,
) -> None:
    commands = (
        (
            "status",
            "--home",
            str(home),
            "--owner",
            "public",
            "--strict",
        ),
        (
            "status",
            "--home",
            str(home),
            "--owner",
            PRIVATE_OWNER,
            "--strict",
        ),
    )
    for index, argv in enumerate(commands, 1):
        _run_required_command(
            runtime,
            home,
            argv,
            f"strict local verification #{index}",
            before_spawn=before_spawn,
        )
    _verify_private_runner(
        runtime,
        home,
        before_spawn=before_spawn,
    )


def _identity_pair_equal(left: Any, right: Any) -> bool:
    return isinstance(left, dict) and left == right


def _empty_target_state(controller_id: str, target_id: str, scope_sha256: str) -> Dict[str, Any]:
    return {
        "version": VERSION,
        "controller_id": controller_id,
        "target_id": target_id,
        "scope_sha256": scope_sha256,
        "desired": None,
        "confirmed": None,
        "pending": False,
        "generation": 0,
        "last_error": None,
    }


def _validate_optional_pair(value: Any, label: str) -> Optional[Dict[str, Dict[str, str]]]:
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ControllerError(f"{label} must be null or an identity pair")
    _require_exact_keys(value, ("public", "private"), label)
    return {
        "public": _identity_tree(value["public"], f"{label} public"),
        "private": _identity_tree(value["private"], f"{label} private"),
    }


def _parse_target_state(
    payload: bytes,
    controller_id: Optional[str] = None,
    target_id: Optional[str] = None,
) -> Dict[str, Any]:
    raw = _bounded_json(payload, "target state")
    if not isinstance(raw, dict):
        raise ControllerError("target state must be an object")
    expected = (
        "version",
        "controller_id",
        "target_id",
        "scope_sha256",
        "desired",
        "confirmed",
        "pending",
        "generation",
        "last_error",
    )
    _require_exact_keys(raw, expected, "target state")
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("target state version must be 1")
    _validate_host_id(raw["controller_id"], "target state controller id")
    _validate_host_id(raw["target_id"], "target state target id")
    if (
        (controller_id is not None and raw["controller_id"] != controller_id)
        or (target_id is not None and raw["target_id"] != target_id)
    ):
        raise ControllerError("target state controller binding is invalid")
    if not isinstance(raw["scope_sha256"], str) or TREE_SHA256_RE.fullmatch(raw["scope_sha256"]) is None:
        raise ControllerError("target state scope digest is invalid")
    desired = _validate_optional_pair(raw["desired"], "target desired identities")
    confirmed = _validate_optional_pair(raw["confirmed"], "target confirmed identities")
    if type(raw["pending"]) is not bool:
        raise ControllerError("target pending flag must be boolean")
    if type(raw["generation"]) is not int or raw["generation"] < 0:
        raise ControllerError("target generation must be a non-negative integer")
    if raw["last_error"] not in (
        None,
        "ssh-uncertain",
        "remote-failed",
        "remote-receipt-invalid",
        "local-scope-changed",
        "process-in-flight",
        "process-retryable",
        "process-cleanup-inconclusive",
    ):
        raise ControllerError("target last_error is invalid")
    if raw["pending"] and desired is None:
        raise ControllerError("pending target state must bind desired identities")
    if not raw["pending"] and raw["last_error"] is not None:
        raise ControllerError("healthy target state must not contain an error")
    if not raw["pending"] and (
        confirmed is None or desired is None or confirmed != desired
    ):
        raise ControllerError(
            "healthy target state must bind equal desired and confirmed identities"
        )
    raw["desired"] = desired
    raw["confirmed"] = confirmed
    return raw


def _read_target_state(
    directory_fd: int,
    name: str,
    uid: int,
    controller_id: str,
    target_id: str,
    scope_sha256: str,
    revalidate: Callable[[], None],
) -> Tuple[FileSnapshot, Dict[str, Any]]:
    snapshot = _read_bound_state_file(directory_fd, name, uid, missing_ok=True)
    if not snapshot.exists:
        return snapshot, _empty_target_state(controller_id, target_id, scope_sha256)
    assert snapshot.payload is not None
    state_value = _parse_target_state(snapshot.payload, target_id=target_id)
    if state_value["controller_id"] == controller_id:
        return snapshot, state_value
    _reject_blocking_target_state(state_value)
    rebound = dict(state_value)
    rebound["controller_id"] = controller_id
    rebound["scope_sha256"] = scope_sha256
    rebound["pending"] = True
    rebound["last_error"] = "local-scope-changed"
    rebound["generation"] = state_value["generation"] + 1
    rebound_snapshot = _publish_target_state(
        directory_fd,
        name,
        uid,
        snapshot,
        rebound,
        revalidate,
    )
    return rebound_snapshot, rebound


def _publish_target_state(
    directory_fd: int,
    name: str,
    uid: int,
    previous: FileSnapshot,
    state_value: Dict[str, Any],
    revalidate: Callable[[], None],
) -> FileSnapshot:
    revalidate()
    published = _atomic_publish(
        directory_fd,
        name,
        _canonical_json_bytes(state_value),
        uid,
        previous,
    )
    revalidate()
    return published


def _operation_scope_digest(
    operation: str,
    controller: HostEntry,
    host: HostEntry,
) -> str:
    if operation in ("activation", "controller-run", "standalone-run"):
        binding: Dict[str, Any] = {
            "operation": operation,
            "host": host.to_json(),
        }
    elif operation in ("sync-target", "remote-apply"):
        binding = {
            "operation": operation,
            "controller": controller.binding_json(),
            "target": host.to_json(),
        }
    else:
        raise ControllerError("operation fence kind is invalid")
    return hashlib.sha256(_canonical_json_bytes(binding)).hexdigest()


def _parse_operation_state(
    payload: bytes,
) -> Dict[str, Any]:
    raw = _bounded_json(payload, "host mutation fence")
    if not isinstance(raw, dict):
        raise ControllerError("host mutation fence must be an object")
    _require_exact_keys(
        raw,
        (
            "version",
            "operation",
            "host_id",
            "controller_id",
            "scope_sha256",
            "status",
            "generation",
        ),
        "host mutation fence",
    )
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("host mutation fence version is invalid")
    if raw["operation"] not in HOST_MUTATION_OPERATIONS:
        raise ControllerError("host mutation fence kind binding is invalid")
    _validate_host_id(raw["host_id"], "host mutation host id")
    _validate_host_id(raw["controller_id"], "host mutation controller id")
    if (
        not isinstance(raw["scope_sha256"], str)
        or TREE_SHA256_RE.fullmatch(raw["scope_sha256"]) is None
    ):
        raise ControllerError("host mutation fence scope digest is invalid")
    if raw["status"] not in (
        "in-flight",
        "retryable",
        "process-cleanup-inconclusive",
    ):
        raise ControllerError("host mutation fence status is invalid")
    if type(raw["generation"]) is not int or raw["generation"] < 0:
        raise ControllerError("host mutation fence generation is invalid")
    return raw


def _read_operation_state(
    directory_fd: int,
    state_name: str,
    uid: int,
    operation: str,
    host_id: str,
    controller_id: str,
    scope_sha256: str,
) -> Tuple[FileSnapshot, Dict[str, Any]]:
    snapshot = _read_bound_state_file(
        directory_fd,
        state_name,
        uid,
        missing_ok=True,
    )
    if not snapshot.exists:
        return snapshot, {
            "version": VERSION,
            "operation": operation,
            "host_id": host_id,
            "controller_id": controller_id,
            "scope_sha256": scope_sha256,
            "status": "retryable",
            "generation": 0,
        }
    assert snapshot.payload is not None
    return snapshot, _parse_operation_state(snapshot.payload)


def _publish_operation_state(
    directory_fd: int,
    state_name: str,
    uid: int,
    previous: FileSnapshot,
    state_value: Dict[str, Any],
) -> FileSnapshot:
    return _atomic_publish(
        directory_fd,
        state_name,
        _canonical_json_bytes(state_value),
        uid,
        previous,
    )


def _reject_blocking_operation_state(state_value: Dict[str, Any]) -> None:
    if state_value["status"] in (
        "in-flight",
        "process-cleanup-inconclusive",
    ):
        raise ProcessCleanupInconclusiveError(
            "host mutation is blocked by a durable process fence from "
            f"{state_value['operation']}; "
            "manual recovery requires proving process absence (normally by reboot)"
        )


def _begin_operation_fence(
    directory_fd: int,
    state_name: str,
    uid: int,
    snapshot: FileSnapshot,
    state_value: Dict[str, Any],
    operation: str,
    host_id: str,
    controller_id: str,
    scope_sha256: str,
) -> Tuple[FileSnapshot, Dict[str, Any]]:
    _reject_blocking_operation_state(state_value)
    in_flight = dict(state_value)
    in_flight["operation"] = operation
    in_flight["host_id"] = host_id
    in_flight["controller_id"] = controller_id
    in_flight["scope_sha256"] = scope_sha256
    in_flight["status"] = "in-flight"
    in_flight["generation"] = state_value["generation"] + 1
    published = _publish_operation_state(
        directory_fd,
        state_name,
        uid,
        snapshot,
        in_flight,
    )
    return published, in_flight


def _transition_operation_fence(
    directory_fd: int,
    state_name: str,
    uid: int,
    snapshot: FileSnapshot,
    state_value: Dict[str, Any],
    status: str,
) -> Tuple[FileSnapshot, Dict[str, Any]]:
    if state_value["status"] != "in-flight" or status not in (
        "retryable",
        "process-cleanup-inconclusive",
    ):
        raise StatePublicationError("operation fence transition is invalid")
    transitioned = dict(state_value)
    transitioned["status"] = status
    transitioned["generation"] = state_value["generation"] + 1
    published = _publish_operation_state(
        directory_fd,
        state_name,
        uid,
        snapshot,
        transitioned,
    )
    return published, transitioned


@contextmanager
def _operation_attempt(
    directory_fd: int,
    state_name: str,
    uid: int,
    operation: str,
    host_id: str,
    controller_id: str,
    scope_sha256: str,
    revalidate: Callable[[], None],
) -> Iterator[NamedStateFence]:
    revalidate()
    snapshot, state_value = _read_operation_state(
        directory_fd,
        state_name,
        uid,
        operation,
        host_id,
        controller_id,
        scope_sha256,
    )
    snapshot, in_flight = _begin_operation_fence(
        directory_fd,
        state_name,
        uid,
        snapshot,
        state_value,
        operation,
        host_id,
        controller_id,
        scope_sha256,
    )
    named_fence = NamedStateFence(
        directory_fd=directory_fd,
        name=state_name,
        uid=uid,
        snapshot=snapshot,
        payload=_canonical_json_bytes(in_flight),
        revalidate=revalidate,
        label="host mutation",
    )
    # The blocking fence must still be visible through the named state path
    # immediately before the mutation-capable child is allowed to start.
    try:
        _revalidate_named_state_fences((named_fence,))
    except StatePublicationError as publication_error:
        raise ProcessCleanupInconclusiveError(
            "host mutation in-flight fence visibility could not be revalidated: "
            f"{publication_error}"
        ) from publication_error
    try:
        yield named_fence
    except ProcessCleanupInconclusiveError as cleanup_error:
        try:
            revalidate()
            _transition_operation_fence(
                directory_fd,
                state_name,
                uid,
                snapshot,
                in_flight,
                "process-cleanup-inconclusive",
            )
        except BaseException as publication_error:
            # The original in-flight object remains blocking unless the atomic
            # replacement already made the quarantine visible. Both states
            # fail closed, so preserve the process-cleanup classification.
            raise ProcessCleanupInconclusiveError(
                "process cleanup was inconclusive and durable quarantine "
                f"publication failed: {publication_error}"
            ) from cleanup_error
        raise
    except BaseException as operation_error:
        try:
            revalidate()
            _transition_operation_fence(
                directory_fd,
                state_name,
                uid,
                snapshot,
                in_flight,
                "retryable",
            )
        except (ControllerError, OSError) as publication_error:
            raise ProcessCleanupInconclusiveError(
                "operation ended but its durable in-flight fence could not be "
                f"cleared: {publication_error}"
            ) from operation_error
        raise
    try:
        revalidate()
        _transition_operation_fence(
            directory_fd,
            state_name,
            uid,
            snapshot,
            in_flight,
            "retryable",
        )
    except (ControllerError, OSError) as publication_error:
        raise ProcessCleanupInconclusiveError(
            "operation completed but its durable in-flight fence could not be "
            f"cleared: {publication_error}"
        ) from publication_error


def _read_host_mutation_state(
    home: Path,
    account: Account,
) -> Optional[Dict[str, Any]]:
    with _open_state_directory(home, account.uid, create=False) as (
        _path,
        directory_fd,
    ):
        _reject_unsupported_operation_files(directory_fd)
        snapshot = _read_bound_state_file(
            directory_fd,
            HOST_MUTATION_STATE_NAME,
            account.uid,
            missing_ok=True,
        )
    if not snapshot.exists:
        return None
    assert snapshot.payload is not None
    return _parse_operation_state(snapshot.payload)


def _aggregate_host_mutation_health(
    state_value: Optional[Dict[str, Any]],
) -> Dict[str, Any]:
    if state_value is None:
        return {
            "healthy": False,
            "operation": None,
            "host_id": None,
            "controller_id": None,
            "status": "missing",
            "binding_current": False,
            "generation": None,
            "reason": "host-mutation-state-missing",
        }
    healthy = state_value["status"] == "retryable"
    reason = None if healthy else f"host-mutation-{state_value['status']}"
    return {
        "healthy": healthy,
        "operation": state_value["operation"],
        "host_id": state_value["host_id"],
        "controller_id": state_value["controller_id"],
        "status": state_value["status"],
        "binding_current": None,
        "generation": state_value["generation"],
        "reason": reason,
    }


def _host_mutation_health(
    state_value: Optional[Dict[str, Any]],
    inventory_snapshot: InventorySnapshot,
    effective: EffectiveEntry,
) -> Dict[str, Any]:
    report = _aggregate_host_mutation_health(state_value)
    if state_value is None:
        return report
    host = effective.entry
    if host.role == "gui-standalone":
        operation = "standalone-run"
        controller = host
    elif host.role == "gui-controller":
        operation = "controller-run"
        controller = host
    elif host.role == "headless-managed":
        operation = "remote-apply"
        controller = inventory_snapshot.inventory.hosts.get(host.controller or "")
        if controller is None or controller.role != "gui-controller":
            raise ControllerError("operation fence controller scope is invalid")
    else:
        raise ControllerError("operation fence role is invalid")
    scope_sha256 = _operation_scope_digest(operation, controller, host)
    report["binding_current"] = (
        state_value["operation"] == operation
        and state_value["host_id"] == host.host_id
        and state_value["controller_id"] == controller.host_id
        and state_value["scope_sha256"] == scope_sha256
    )
    return report


def _unreadable_host_mutation_health(error: BaseException) -> Dict[str, Any]:
    return {
        "healthy": False,
        "operation": None,
        "host_id": None,
        "controller_id": None,
        "status": "unreadable",
        "binding_current": False,
        "generation": None,
        "reason": str(error),
    }


def _notify_transition(
    runtime: Runtime,
    target_id: str,
    pending: bool,
    *,
    retryable: bool = True,
) -> None:
    message = (
        (
            f"Private sync to {target_id} is pending and will retry."
            if retryable
            else (
                f"Private sync to {target_id} is quarantined; "
                "manual recovery requires proving process absence "
                "(normally by reboot)."
            )
        )
        if pending
        else f"Private sync to {target_id} recovered."
    )
    try:
        runtime.run(
            (
                "/usr/bin/osascript",
                "-e",
                "on run argv",
                "-e",
                "display notification (item 1 of argv) with title (item 2 of argv)",
                "-e",
                "end run",
                message,
                "Codex private sync",
            ),
            timeout=NOTIFICATION_TIMEOUT_SECONDS,
            output_limit=8192,
        )
    except ProcessCleanupInconclusiveError:
        raise
    except (ControllerError, OSError):
        pass


def _raise_after_quarantine_notification(
    runtime: Runtime,
    target_id: str,
    was_healthy: bool,
    cleanup_error: ProcessCleanupInconclusiveError,
) -> NoReturn:
    if was_healthy:
        try:
            _notify_transition(
                runtime,
                target_id,
                True,
                retryable=False,
            )
        except BaseException as notification_error:
            # A notification child or a signal observed while reporting must
            # not downgrade an already established process-cleanup quarantine.
            raise cleanup_error from notification_error
    raise cleanup_error


def _remote_command(
    target: HostEntry,
    controller: HostEntry,
    desired: Dict[str, Dict[str, str]],
) -> str:
    remote_home = str(PurePosixPath(target.home) / ".codex")
    argv = (
        str(PurePosixPath(remote_home) / "bin" / "codex-private-macos-sync"),
        "remote-apply",
        "--home",
        remote_home,
        "--host-id",
        target.host_id,
        "--controller-id",
        controller.host_id,
        "--expected-public-sha",
        desired["public"]["sha"],
        "--expected-public-tree",
        desired["public"]["tree_sha256"],
        "--expected-private-sha",
        desired["private"]["sha"],
        "--expected-private-tree",
        desired["private"]["tree_sha256"],
    )
    return shlex.join(argv)


def _ssh_argv(
    target: HostEntry,
    controller: HostEntry,
    desired: Dict[str, Dict[str, str]],
) -> Tuple[str, ...]:
    assert target.ssh_alias is not None
    return (
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "ConnectionAttempts=4",
        "-o",
        "ForwardAgent=no",
        "-o",
        "ClearAllForwardings=yes",
        "-o",
        "RequestTTY=no",
        "-T",
        target.ssh_alias,
        _remote_command(target, controller, desired),
    )


def _parse_remote_receipt(
    payload: bytes,
    controller: HostEntry,
    target: HostEntry,
    desired: Dict[str, Dict[str, str]],
    scope_sha256: str,
    inventory_snapshot: InventorySnapshot,
) -> None:
    raw = _bounded_json(payload, "remote verification receipt")
    if not isinstance(raw, dict):
        raise ControllerError("remote verification receipt must be an object")
    expected = (
        "version",
        "status",
        "controller_id",
        "target_id",
        "scope_sha256",
        "inventory_release_sha",
        "inventory_sha256",
        "release_trees",
    )
    _require_exact_keys(raw, expected, "remote verification receipt")
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("remote verification receipt version is invalid")
    if raw["status"] != "verified":
        raise ControllerError("remote verification receipt is not verified")
    if raw["controller_id"] != controller.host_id or raw["target_id"] != target.host_id:
        raise ControllerError("remote verification receipt host binding is invalid")
    if raw["scope_sha256"] != scope_sha256:
        raise ControllerError("remote verification receipt scope is invalid")
    if (
        raw["inventory_release_sha"] != inventory_snapshot.release_sha
        or raw["inventory_sha256"] != inventory_snapshot.content_sha256
    ):
        raise ControllerError("remote verification receipt inventory binding is invalid")
    trees = raw["release_trees"]
    if not isinstance(trees, dict):
        raise ControllerError("remote verification receipt identities are invalid")
    _require_exact_keys(trees, ("public", "private"), "remote receipt release trees")
    parsed = {
        "public": _identity_tree(trees["public"], "remote receipt public"),
        "private": _identity_tree(trees["private"], "remote receipt private"),
    }
    if parsed != desired:
        raise ControllerError("remote verification receipt identities do not match desired")


def _remote_request_digest(
    controller_id: str,
    target_id: str,
    desired: Dict[str, Dict[str, str]],
) -> str:
    return hashlib.sha256(
        _canonical_json_bytes(
            {
                "controller_id": controller_id,
                "target_id": target_id,
                "desired_release_trees": desired,
            }
        )
    ).hexdigest()


def _remote_cleanup_receipt(
    controller_id: str,
    target_id: str,
    desired: Dict[str, Dict[str, str]],
) -> Dict[str, Any]:
    return {
        "version": VERSION,
        "status": "process-cleanup-inconclusive",
        "controller_id": controller_id,
        "target_id": target_id,
        "request_sha256": _remote_request_digest(
            controller_id,
            target_id,
            desired,
        ),
    }


def _parse_remote_cleanup_receipt(
    payload: bytes,
    controller: HostEntry,
    target: HostEntry,
    desired: Dict[str, Dict[str, str]],
) -> None:
    raw = _bounded_json(payload, "remote cleanup receipt")
    if not isinstance(raw, dict):
        raise ControllerError("remote cleanup receipt must be an object")
    _require_exact_keys(
        raw,
        (
            "version",
            "status",
            "controller_id",
            "target_id",
            "request_sha256",
        ),
        "remote cleanup receipt",
    )
    if type(raw["version"]) is not int or raw["version"] != VERSION:
        raise ControllerError("remote cleanup receipt version is invalid")
    if raw["status"] != "process-cleanup-inconclusive":
        raise ControllerError("remote cleanup receipt status is invalid")
    if raw["controller_id"] != controller.host_id or raw["target_id"] != target.host_id:
        raise ControllerError("remote cleanup receipt host binding is invalid")
    if raw["request_sha256"] != _remote_request_digest(
        controller.host_id,
        target.host_id,
        desired,
    ):
        raise ControllerError("remote cleanup receipt request binding is invalid")


def _mark_pending_failure(
    directory_fd: int,
    state_name: str,
    uid: int,
    state_snapshot: FileSnapshot,
    state_value: Dict[str, Any],
    reason: str,
    revalidate: Callable[[], None],
) -> FileSnapshot:
    failed = dict(state_value)
    failed["pending"] = True
    failed["last_error"] = reason
    failed["generation"] = state_value["generation"] + 1
    return _publish_target_state(
        directory_fd,
        state_name,
        uid,
        state_snapshot,
        failed,
        revalidate,
    )


def _mark_target_retryable(
    directory_fd: int,
    state_name: str,
    uid: int,
    state_snapshot: FileSnapshot,
    state_value: Dict[str, Any],
    revalidate: Callable[[], None],
) -> Tuple[FileSnapshot, Dict[str, Any]]:
    if (
        not state_value["pending"]
        or state_value["last_error"] != "process-in-flight"
    ):
        raise StatePublicationError("target retryable transition is not in-flight")
    retryable = dict(state_value)
    retryable["last_error"] = "process-retryable"
    retryable["generation"] = state_value["generation"] + 1
    snapshot = _publish_target_state(
        directory_fd,
        state_name,
        uid,
        state_snapshot,
        retryable,
        revalidate,
    )
    return snapshot, retryable


def _reject_blocking_target_state(state_value: Dict[str, Any]) -> None:
    if state_value["pending"] and state_value["last_error"] is None:
        raise ControllerError(
            "legacy-pending: target state predates the process ownership fence; "
            "manual recovery requires proving process absence (normally by reboot)"
        )
    if state_value["last_error"] == "process-in-flight":
        raise ControllerError(
            "process-in-flight: target is blocked; manual recovery requires "
            "proving process absence (normally by reboot)"
        )
    if state_value["last_error"] == "process-cleanup-inconclusive":
        raise ControllerError(
            "process-cleanup-inconclusive: target is quarantined; manual recovery "
            "requires proving process absence (normally by reboot)"
        )


def _bounded_state_directory_names(directory_fd: int) -> Tuple[str, ...]:
    names: List[str] = []
    total_name_bytes = 0
    try:
        with os.scandir(directory_fd) as entries:
            for entry in entries:
                if len(names) >= MAX_STATE_DIRECTORY_ENTRIES:
                    raise StatePublicationError(
                        "state directory entry count exceeds its audit bound"
                    )
                name = entry.name
                if not isinstance(name, str):
                    raise StatePublicationError(
                        "state directory entry name is not text"
                    )
                try:
                    encoded = os.fsencode(name)
                except (UnicodeEncodeError, ValueError) as error:
                    raise StatePublicationError(
                        "state directory entry name is not encodable"
                    ) from error
                if len(encoded) > MAX_STATE_DIRECTORY_NAME_BYTES:
                    raise StatePublicationError(
                        "state directory entry name exceeds its audit bound"
                    )
                total_name_bytes += len(encoded)
                if total_name_bytes > MAX_STATE_DIRECTORY_NAMES_BYTES:
                    raise StatePublicationError(
                        "state directory entry names exceed their audit bound"
                    )
                names.append(name)
    except StatePublicationError:
        raise
    except OSError as error:
        raise StatePublicationError(
            f"state directory enumeration failed: {error}"
        ) from error
    return tuple(sorted(names))


def _audit_activation_state_directory(
    directory_fd: int,
    uid: int,
    revalidate: Callable[[], None],
) -> None:
    revalidate()
    names_before = _bounded_state_directory_names(directory_fd)
    unsupported = sorted(set(names_before) & UNSUPPORTED_OPERATION_FILES)
    if unsupported:
        raise StatePublicationError(
            "unsupported operation artifact requires proving process absence "
            f"and manual cleanup: {unsupported[0]}"
        )
    target_names = tuple(
        name
        for name in names_before
        if name.startswith("target-") and name.endswith(".json")
    )
    if len(target_names) > MAX_TARGET_STATE_FILES:
        raise StatePublicationError(
            "target state file count exceeds its activation audit bound"
        )
    total_payload_bytes = 0
    snapshots: List[Tuple[str, FileSnapshot]] = []
    for name in target_names:
        target_id = _validate_host_id(
            name[len("target-") : -len(".json")],
            "target state filename id",
        )
        snapshot = _read_bound_state_file(
            directory_fd,
            name,
            uid,
            missing_ok=False,
        )
        assert snapshot.payload is not None
        total_payload_bytes += len(snapshot.payload)
        if total_payload_bytes > MAX_TARGET_STATE_AUDIT_BYTES:
            raise StatePublicationError(
                "target state payloads exceed their activation audit bound"
            )
        state_value = _parse_target_state(snapshot.payload)
        if state_value["target_id"] != target_id:
            raise ControllerError(
                "target state filename and payload binding do not match"
            )
        _reject_blocking_target_state(state_value)
        snapshots.append((name, snapshot))
    names_after = _bounded_state_directory_names(directory_fd)
    if names_after != names_before:
        raise StatePublicationError(
            "state directory names changed during activation audit"
        )
    for name, expected in snapshots:
        current = _read_bound_state_file(
            directory_fd,
            name,
            uid,
            missing_ok=False,
        )
        if not _file_snapshot_matches(current, expected):
            raise StatePublicationError(
                f"target state changed during activation audit: {name}"
            )
    revalidate()


def _rebind_activation_target_states(
    runtime: Runtime,
    home: Path,
    account: Account,
    effective: EffectiveEntry,
    inventory_snapshot: InventorySnapshot,
    activation_fences: Sequence[NamedStateFence],
) -> None:
    controller = effective.entry
    if controller.role != "gui-controller":
        return
    for target_id in controller.targets:
        target = inventory_snapshot.inventory.hosts[target_id]
        scope_sha256 = _scope_digest(controller, target)
        with _target_lock(home, account.uid, target_id, runtime) as (
            directory_fd,
            state_name,
            revalidate_target,
        ):
            def revalidate_scope() -> None:
                _revalidate_named_state_fences(activation_fences)
                revalidate_target()

            _read_target_state(
                directory_fd,
                state_name,
                account.uid,
                controller.host_id,
                target_id,
                scope_sha256,
                revalidate_scope,
            )


def _fanout_target(
    runtime: Runtime,
    home: Path,
    account: Account,
    controller: HostEntry,
    target: HostEntry,
    inventory_snapshot: InventorySnapshot,
    desired: Dict[str, Dict[str, str]],
    host_fence: NamedStateFence,
    *,
    force: bool = False,
) -> bool:
    scope_sha256 = _scope_digest(controller, target)
    with _target_lock(home, account.uid, target.host_id, runtime) as (
        directory_fd,
        state_name,
        revalidate,
    ):
        def revalidate_scope() -> None:
            _revalidate_named_state_fences((host_fence,))
            revalidate()

        _audit_activation_state_directory(
            directory_fd,
            account.uid,
            revalidate_scope,
        )
        state_snapshot, state_value = _read_target_state(
            directory_fd,
            state_name,
            account.uid,
            controller.host_id,
            target.host_id,
            scope_sha256,
            revalidate_scope,
        )
        _reject_blocking_target_state(state_value)
        if (
            not force
            and not state_value["pending"]
            and state_value["scope_sha256"] == scope_sha256
            and _identity_pair_equal(state_value["confirmed"], desired)
        ):
            return True
        was_pending = bool(state_value["pending"])
        was_healthy = (
            not was_pending
            and state_value["confirmed"] is not None
            and state_value["last_error"] is None
        )
        # Older pending states with no error are ambiguous and were rejected
        # above. Every new attempt first publishes a blocking ownership fence
        # so neither a normal run nor --force can overlap an attributed child.
        in_flight = dict(state_value)
        in_flight["scope_sha256"] = scope_sha256
        in_flight["desired"] = desired
        in_flight["pending"] = True
        in_flight["last_error"] = "process-in-flight"
        in_flight["generation"] = state_value["generation"] + 1
        state_snapshot = _publish_target_state(
            directory_fd,
            state_name,
            account.uid,
            state_snapshot,
            in_flight,
            revalidate,
        )
        target_fence = NamedStateFence(
            directory_fd=directory_fd,
            name=state_name,
            uid=account.uid,
            snapshot=state_snapshot,
            payload=_canonical_json_bytes(in_flight),
            revalidate=revalidate,
            label=f"target {target.host_id}",
        )
        try:
            result = runtime.run(
                _ssh_argv(target, controller, desired),
                timeout=SSH_TIMEOUT_SECONDS,
                output_limit=MAX_SSH_OUTPUT_BYTES,
                before_spawn=_named_state_fence_callback(
                    host_fence,
                    target_fence,
                ),
            )
        except ProcessCleanupInconclusiveError as cleanup_error:
            try:
                _mark_pending_failure(
                    directory_fd,
                    state_name,
                    account.uid,
                    state_snapshot,
                    in_flight,
                    "process-cleanup-inconclusive",
                    revalidate,
                )
            except BaseException as publication_error:
                raise ProcessCleanupInconclusiveError(
                    "SSH cleanup was inconclusive and the target in-flight "
                    f"fence could not be quarantined: {publication_error}"
                ) from cleanup_error
            _raise_after_quarantine_notification(
                runtime,
                target.host_id,
                was_healthy,
                cleanup_error,
            )
        except (ControllerError, OSError):
            _mark_pending_failure(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                "ssh-uncertain",
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target.host_id, True)
            return False
        except BaseException:
            _mark_target_retryable(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                revalidate,
            )
            raise
        if result.returncode == REMOTE_PROCESS_CLEANUP_EXIT:
            # Exit 75 is a remote process-safety fence, not a retryable remote
            # failure. The exact request-bound JSON is useful evidence, but a
            # truncated/malformed payload or stderr cannot make retry safe.
            if not result.stderr:
                try:
                    _parse_remote_cleanup_receipt(
                        result.stdout,
                        controller,
                        target,
                        desired,
                    )
                except ControllerError:
                    pass
            cleanup_error = ProcessCleanupInconclusiveError(
                "remote target process cleanup was inconclusive; the target "
                "and host mutation fences remain quarantined"
            )
            try:
                _mark_pending_failure(
                    directory_fd,
                    state_name,
                    account.uid,
                    state_snapshot,
                    in_flight,
                    "process-cleanup-inconclusive",
                    revalidate,
                )
            except BaseException as publication_error:
                raise ProcessCleanupInconclusiveError(
                    "remote target process cleanup was inconclusive and the "
                    "target in-flight fence could not be quarantined: "
                    f"{publication_error}"
                ) from publication_error
            _raise_after_quarantine_notification(
                runtime,
                target.host_id,
                was_healthy,
                cleanup_error,
            )
        if result.timed_out or result.output_overflow or result.returncode == 255:
            _mark_pending_failure(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                "ssh-uncertain",
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target.host_id, True)
            return False
        if result.returncode != 0:
            _mark_pending_failure(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                "remote-failed",
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target.host_id, True)
            return False
        try:
            _parse_remote_receipt(
                result.stdout,
                controller,
                target,
                desired,
                scope_sha256,
                inventory_snapshot,
            )
        except ControllerError:
            _mark_pending_failure(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                "remote-receipt-invalid",
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target.host_id, True)
            return False
        try:
            current_inventory = _load_current_inventory(home, account.uid)
            current_effective = _validate_activation(
                home,
                account,
                current_inventory,
                requested_host_id=controller.host_id,
                runtime=runtime,
            )
            current_target = current_inventory.inventory.hosts.get(target.host_id)
            current_identities = _read_release_identities(
                runtime,
                home,
                before_spawn=_named_state_fence_callback(
                    host_fence,
                    target_fence,
                ),
            )
            if (
                current_inventory.fingerprint() != inventory_snapshot.fingerprint()
                or current_effective.entry != controller
                or current_target != target
                or current_identities != desired
            ):
                raise ControllerError("local controller scope changed during remote sync")
        except ProcessCleanupInconclusiveError as cleanup_error:
            try:
                _mark_pending_failure(
                    directory_fd,
                    state_name,
                    account.uid,
                    state_snapshot,
                    in_flight,
                    "process-cleanup-inconclusive",
                    revalidate,
                )
            except BaseException as publication_error:
                raise ProcessCleanupInconclusiveError(
                    "controller validation cleanup was inconclusive and the "
                    "target in-flight fence could not be quarantined: "
                    f"{publication_error}"
                ) from cleanup_error
            _raise_after_quarantine_notification(
                runtime,
                target.host_id,
                was_healthy,
                cleanup_error,
            )
        except ControllerError:
            _mark_pending_failure(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                in_flight,
                "local-scope-changed",
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target.host_id, True)
            return False
        healthy = dict(in_flight)
        healthy["confirmed"] = desired
        healthy["pending"] = False
        healthy["last_error"] = None
        healthy["generation"] = in_flight["generation"] + 1
        _publish_target_state(
            directory_fd,
            state_name,
            account.uid,
            state_snapshot,
            healthy,
            revalidate,
        )
        if was_pending:
            _notify_transition(runtime, target.host_id, False)
        return True


def _persist_controller_scope_change(
    runtime: Runtime,
    home: Path,
    account: Account,
    controller: HostEntry,
    inventory_snapshot: InventorySnapshot,
    desired: Dict[str, Dict[str, str]],
    host_fence: NamedStateFence,
) -> None:
    for target_id in controller.targets:
        target = inventory_snapshot.inventory.hosts[target_id]
        scope_sha256 = _scope_digest(controller, target)
        with _target_lock(home, account.uid, target_id, runtime) as (
            directory_fd,
            state_name,
            revalidate,
        ):
            def revalidate_scope() -> None:
                _revalidate_named_state_fences((host_fence,))
                revalidate()

            _audit_activation_state_directory(
                directory_fd,
                account.uid,
                revalidate_scope,
            )
            state_snapshot, state_value = _read_target_state(
                directory_fd,
                state_name,
                account.uid,
                controller.host_id,
                target_id,
                scope_sha256,
                revalidate_scope,
            )
            _reject_blocking_target_state(state_value)
            was_healthy = (
                not state_value["pending"]
                and state_value["confirmed"] is not None
                and state_value["last_error"] is None
            )
            pending = dict(state_value)
            pending["scope_sha256"] = scope_sha256
            pending["desired"] = desired
            pending["pending"] = True
            pending["last_error"] = "local-scope-changed"
            pending["generation"] = state_value["generation"] + 1
            _publish_target_state(
                directory_fd,
                state_name,
                account.uid,
                state_snapshot,
                pending,
                revalidate,
            )
            if was_healthy:
                _notify_transition(runtime, target_id, True)


def _controller_run_operation(
    runtime: Runtime,
    home: Path,
    account: Account,
    initial_inventory: InventorySnapshot,
    scoped_effective: EffectiveEntry,
    host_fence: NamedStateFence,
    *,
    strict: bool,
) -> bool:
    _run_local_sync(
        runtime,
        home,
        before_spawn=_named_state_fence_callback(host_fence),
    )
    try:
        inventory_snapshot = _load_current_inventory(home, account.uid)
        effective = _validate_activation(
            home, account, inventory_snapshot, runtime=runtime
        )
    except ProcessCleanupInconclusiveError:
        raise
    except ControllerError as scope_error:
        desired_after_change = _read_release_identities(
            runtime,
            home,
            before_spawn=_named_state_fence_callback(host_fence),
        )
        _persist_controller_scope_change(
            runtime,
            home,
            account,
            scoped_effective.entry,
            initial_inventory,
            desired_after_change,
            host_fence,
        )
        raise ControllerError(
            f"role-activation-required: controller scope changed after local sync: {scope_error}"
        ) from scope_error
    controller = effective.entry
    if controller.role != "gui-controller":
        raise ControllerError("role-activation-required: controller role changed")
    desired = _read_release_identities(
        runtime,
        home,
        before_spawn=_named_state_fence_callback(host_fence),
    )
    if desired["private"]["sha"] != inventory_snapshot.release_sha:
        raise ControllerError("current inventory release does not match private identity")
    healthy = True
    for target_id in controller.targets:
        target = inventory_snapshot.inventory.hosts.get(target_id)
        if target is None or target.role != "headless-managed":
            raise ControllerError(f"controller target scope is invalid: {target_id}")
        if not _fanout_target(
            runtime,
            home,
            account,
            controller,
            target,
            inventory_snapshot,
            desired,
            host_fence,
            force=False,
        ):
            healthy = False
    if strict and not healthy:
        return False
    return True


def controller_run(
    runtime: Runtime,
    raw_home: Path,
    *,
    strict: bool,
) -> bool:
    account = runtime.account()
    home = _codex_home(raw_home, account)
    initial_inventory = _load_current_inventory(home, account.uid)
    scoped_effective = _preflight_activation_scope(
        home,
        account,
        initial_inventory,
    )
    scheduled_host = scoped_effective.entry
    if scheduled_host.role == "gui-standalone":
        operation = "standalone-run"
    elif scheduled_host.role == "gui-controller":
        operation = "controller-run"
    else:
        raise ControllerError("run-scheduled requires an activated GUI role")
    controller = scheduled_host
    scope_sha256 = _operation_scope_digest(
        operation,
        controller,
        controller,
    )
    with _host_mutation_lock(
        home,
        account.uid,
        runtime,
    ) as host_transaction:
        directory_fd = host_transaction.directory_fd
        state_name = host_transaction.state_name
        revalidate = host_transaction.revalidate
        _snapshot, operation_state = _read_operation_state(
            directory_fd,
            state_name,
            account.uid,
            operation,
            controller.host_id,
            controller.host_id,
            scope_sha256,
        )
        _reject_blocking_operation_state(operation_state)
        committed_effective = _validate_activation(
            home,
            account,
            initial_inventory,
            runtime=runtime,
        )
        if committed_effective != scoped_effective:
            raise ControllerError(
                f"role-activation-required: {operation} scope changed"
            )
        with _operation_attempt(
            directory_fd,
            state_name,
            account.uid,
            operation,
            controller.host_id,
            controller.host_id,
            scope_sha256,
            revalidate,
        ) as host_fence:
            if operation == "standalone-run":
                _run_local_sync(
                    runtime,
                    home,
                    before_spawn=_named_state_fence_callback(host_fence),
                )
                return True
            return _controller_run_operation(
                runtime,
                home,
                account,
                initial_inventory,
                scoped_effective,
                host_fence,
                strict=strict,
            )


def sync_target(
    runtime: Runtime,
    raw_home: Path,
    *,
    target_id: str,
    force: bool,
    strict: bool,
) -> bool:
    account = runtime.account()
    home = _codex_home(raw_home, account)
    inventory_snapshot = _load_current_inventory(home, account.uid)
    scoped_effective = _preflight_activation_scope(
        home,
        account,
        inventory_snapshot,
    )
    controller = scoped_effective.entry
    if controller.role != "gui-controller":
        raise ControllerError("sync-target requires an activated gui-controller role")
    selected = _validate_host_id(target_id, "manual target id")
    if selected not in controller.targets:
        raise ControllerError(
            "manual target is not derived from the activated controller inventory"
        )
    scope_sha256 = _operation_scope_digest(
        "sync-target",
        controller,
        inventory_snapshot.inventory.hosts[selected],
    )
    with _host_mutation_lock(
        home,
        account.uid,
        runtime,
    ) as host_transaction:
        directory_fd = host_transaction.directory_fd
        state_name = host_transaction.state_name
        revalidate = host_transaction.revalidate
        _snapshot, operation_state = _read_operation_state(
            directory_fd,
            state_name,
            account.uid,
            "sync-target",
            controller.host_id,
            controller.host_id,
            scope_sha256,
        )
        _reject_blocking_operation_state(operation_state)
        effective = _validate_activation(
            home,
            account,
            inventory_snapshot,
            runtime=runtime,
        )
        if effective != scoped_effective:
            raise ControllerError("role-activation-required: controller scope changed")
        target = inventory_snapshot.inventory.hosts[selected]
        with _operation_attempt(
            directory_fd,
            state_name,
            account.uid,
            "sync-target",
            controller.host_id,
            controller.host_id,
            scope_sha256,
            revalidate,
        ) as host_fence:
            desired = _read_release_identities(
                runtime,
                home,
                before_spawn=_named_state_fence_callback(host_fence),
            )
            if desired["private"]["sha"] != inventory_snapshot.release_sha:
                raise ControllerError(
                    "current inventory release does not match private identity"
                )
            healthy = _fanout_target(
                runtime,
                home,
                account,
                controller,
                target,
                inventory_snapshot,
                desired,
                host_fence,
                force=force,
            )
    if strict and not healthy:
        return False
    return True


def _remote_apply_operation(
    runtime: Runtime,
    home: Path,
    account: Account,
    *,
    host_id: str,
    controller_id: str,
    expected: Dict[str, Dict[str, str]],
    host_fence: NamedStateFence,
) -> Dict[str, Any]:
    _run_local_sync(
        runtime,
        home,
        before_spawn=_named_state_fence_callback(host_fence),
    )
    inventory_snapshot = _load_current_inventory(home, account.uid)
    effective = _validate_activation(
        home,
        account,
        inventory_snapshot,
        requested_host_id=host_id,
        runtime=runtime,
    )
    target = effective.entry
    controller = inventory_snapshot.inventory.hosts.get(controller_id)
    if (
        target.role != "headless-managed"
        or target.controller != controller_id
        or controller is None
        or controller.role != "gui-controller"
        or target.host_id not in controller.targets
    ):
        raise ControllerError("role-activation-required: remote target scope changed")
    identities = _read_release_identities(
        runtime,
        home,
        before_spawn=_named_state_fence_callback(host_fence),
    )
    if identities != expected:
        raise ControllerError("remote installed release identities do not match desired")
    if identities["private"]["sha"] != inventory_snapshot.release_sha:
        raise ControllerError("remote inventory release does not match private identity")
    try:
        _strict_local_verification(
            runtime,
            home,
            before_spawn=_named_state_fence_callback(host_fence),
        )
    except (ProcessCleanupInconclusiveError, StatePublicationError):
        raise
    except ControllerError as error:
        raise ControllerError(
            "remote current inventory or identity changed before acknowledgement: "
            f"{error}"
        ) from error
    try:
        final_inventory = _load_current_inventory(home, account.uid)
        final_effective = _validate_activation(
            home,
            account,
            final_inventory,
            requested_host_id=host_id,
            runtime=runtime,
        )
        final_identities = _read_release_identities(
            runtime,
            home,
            before_spawn=_named_state_fence_callback(host_fence),
        )
    except ProcessCleanupInconclusiveError:
        raise
    except ControllerError as error:
        raise ControllerError(
            "remote current inventory or identity changed before acknowledgement: "
            f"{error}"
        ) from error
    final_target = final_effective.entry
    final_controller = final_inventory.inventory.hosts.get(controller_id)
    if (
        final_inventory.fingerprint() != inventory_snapshot.fingerprint()
        or final_identities != identities
        or final_target != target
        or final_controller != controller
    ):
        raise ControllerError("remote current inventory or identity changed before acknowledgement")
    return {
        "version": VERSION,
        "status": "verified",
        "controller_id": controller_id,
        "target_id": host_id,
        "scope_sha256": _scope_digest(controller, target),
        "inventory_release_sha": inventory_snapshot.release_sha,
        "inventory_sha256": inventory_snapshot.content_sha256,
        "release_trees": identities,
    }


def remote_apply(
    runtime: Runtime,
    raw_home: Path,
    *,
    host_id: str,
    controller_id: str,
    expected: Dict[str, Dict[str, str]],
) -> Dict[str, Any]:
    account = runtime.account()
    home = _codex_home(raw_home, account)
    cleanup_receipt = _remote_cleanup_receipt(
        controller_id,
        host_id,
        expected,
    )
    initial_inventory = _load_current_inventory(home, account.uid)
    try:
        scoped_effective = _preflight_activation_scope(
            home,
            account,
            initial_inventory,
            requested_host_id=host_id,
        )
    except ActivationProcessFenceError as cleanup_error:
        raise RemoteProcessCleanupInconclusiveError(
            cleanup_receipt
        ) from cleanup_error
    target = scoped_effective.entry
    controller = initial_inventory.inventory.hosts.get(controller_id)
    if (
        target.role != "headless-managed"
        or target.controller != controller_id
        or controller is None
        or controller.role != "gui-controller"
        or target.host_id not in controller.targets
    ):
        raise ControllerError("remote apply scope is not an activated headless target")
    scope_sha256 = _operation_scope_digest(
        "remote-apply",
        controller,
        target,
    )
    try:
        with _host_mutation_lock(
            home,
            account.uid,
            runtime,
        ) as host_transaction:
            directory_fd = host_transaction.directory_fd
            state_name = host_transaction.state_name
            revalidate = host_transaction.revalidate
            try:
                _snapshot, operation_state = _read_operation_state(
                    directory_fd,
                    state_name,
                    account.uid,
                    "remote-apply",
                    target.host_id,
                    controller.host_id,
                    scope_sha256,
                )
                _reject_blocking_operation_state(operation_state)
            except ProcessCleanupInconclusiveError as cleanup_error:
                raise RemoteProcessCleanupInconclusiveError(
                    cleanup_receipt
                ) from cleanup_error
            initial_effective = _validate_activation(
                home,
                account,
                initial_inventory,
                requested_host_id=host_id,
                runtime=runtime,
            )
            if initial_effective != scoped_effective:
                raise ControllerError(
                    "role-activation-required: remote target scope changed"
                )
            try:
                with _operation_attempt(
                    directory_fd,
                    state_name,
                    account.uid,
                    "remote-apply",
                    target.host_id,
                    controller.host_id,
                    scope_sha256,
                    revalidate,
                ) as host_fence:
                    return _remote_apply_operation(
                        runtime,
                        home,
                        account,
                        host_id=host_id,
                        controller_id=controller_id,
                        expected=expected,
                        host_fence=host_fence,
                    )
            except ProcessCleanupInconclusiveError as cleanup_error:
                raise RemoteProcessCleanupInconclusiveError(
                    cleanup_receipt
                ) from cleanup_error
    except (
        UnsupportedOperationArtifactError,
        ActivationProcessFenceError,
    ) as cleanup_error:
        raise RemoteProcessCleanupInconclusiveError(
            cleanup_receipt
        ) from cleanup_error


def _parse_scheduler_report(payload: bytes) -> Dict[str, Any]:
    raw = _bounded_json(payload, "canonical scheduler status")
    if not isinstance(raw, dict):
        raise ControllerError("canonical scheduler status must be an object")
    _require_exact_keys(raw, SCHEDULER_REPORT_KEYS, "canonical scheduler status")

    def optional_string(value: Any, label: str, maximum: int = 4096) -> None:
        if value is None:
            return
        try:
            encoded = value.encode("utf-8", errors="strict")
        except (AttributeError, UnicodeEncodeError):
            raise ControllerError(f"canonical scheduler {label} is invalid")
        if not value or len(encoded) > maximum:
            raise ControllerError(f"canonical scheduler {label} is invalid")

    for name in ("installed", "stable_runner", "migration_needed"):
        if type(raw[name]) is not bool:
            raise ControllerError(f"canonical scheduler {name} must be boolean")
    if raw["enabled"] is not None and type(raw["enabled"]) is not bool:
        raise ControllerError("canonical scheduler enabled state is invalid")
    optional_string(raw["platform"], "platform", 32)
    for name in (
        "runner",
        "command",
        "mode",
        "repo",
        "base_repo",
        "private_repo",
        "owner",
        "last_attempt",
        "recent_success",
        "failure_code",
        "failure_reason",
    ):
        optional_string(raw[name], name)
    interval = raw["interval_minutes"]
    if interval is not None and (
        type(interval) is not int or interval < 1 or interval > 7 * 24 * 60
    ):
        raise ControllerError("canonical scheduler interval is invalid")
    config = raw["config"]
    if not isinstance(config, list) or len(config) > 8:
        raise ControllerError("canonical scheduler config paths are invalid")
    for path in config:
        optional_string(path, "config path")
    current_release = raw["current_release"]
    if not isinstance(current_release, dict) or len(current_release) > 2:
        raise ControllerError("canonical scheduler current releases are invalid")
    for owner, sha in current_release.items():
        if owner not in ("public", PRIVATE_OWNER):
            raise ControllerError("canonical scheduler current release owner is invalid")
        if not isinstance(sha, str) or FULL_SHA_RE.fullmatch(sha) is None:
            raise ControllerError("canonical scheduler current release sha is invalid")
    release_integrity = raw["release_integrity"]
    if not isinstance(release_integrity, list) or len(release_integrity) > 64:
        raise ControllerError("canonical scheduler release integrity is invalid")
    for issue in release_integrity:
        if not isinstance(issue, dict):
            raise ControllerError("canonical scheduler release issue must be an object")
        _require_exact_keys(
            issue,
            ("code", "owner", "sha", "detail"),
            "canonical scheduler release issue",
        )
        for name in ("code", "owner", "detail"):
            optional_string(issue[name], f"release issue {name}")
        if not isinstance(issue["sha"], str) or FULL_SHA_RE.fullmatch(issue["sha"]) is None:
            raise ControllerError("canonical scheduler release issue sha is invalid")
    quarantine_batches = raw["quarantine_batches"]
    if quarantine_batches is not None and (
        type(quarantine_batches) is not int or quarantine_batches < 0
    ):
        raise ControllerError("canonical scheduler quarantine_batches is invalid")
    quarantine_limit = raw["quarantine_limit"]
    if type(quarantine_limit) is not int or quarantine_limit < 0:
        raise ControllerError("canonical scheduler quarantine_limit is invalid")
    if raw["mirror_quarantine"] is not None and not isinstance(
        raw["mirror_quarantine"], dict
    ):
        raise ControllerError("canonical scheduler mirror quarantine is invalid")
    daemon_query = raw["daemon_query"]
    if not isinstance(daemon_query, dict):
        raise ControllerError("canonical scheduler daemon query must be an object")
    _require_exact_keys(
        daemon_query,
        ("classification", "reason"),
        "canonical scheduler daemon query",
    )
    if daemon_query["classification"] not in (
        "enabled",
        "active-disabled",
        "disabled",
        "enabled-inactive",
        "unavailable",
    ):
        raise ControllerError("canonical scheduler daemon classification is invalid")
    optional_string(daemon_query["reason"], "daemon reason")
    failures = raw["failures"]
    if not isinstance(failures, list) or len(failures) > 64:
        raise ControllerError("canonical scheduler failures are invalid")
    for failure in failures:
        if not isinstance(failure, dict):
            raise ControllerError("canonical scheduler failure must be an object")
        _require_exact_keys(
            failure,
            ("code", "reason"),
            "canonical scheduler failure",
        )
        optional_string(failure["code"], "failure code")
        optional_string(failure["reason"], "failure reason")
        if failure["reason"] is None:
            raise ControllerError("canonical scheduler failure reason is missing")
    return raw


def _scheduler_health(
    runtime: Runtime,
    home: Path,
    role: str,
    *,
    expected_interval_minutes: Optional[int],
    before_spawn: Optional[Callable[[], None]] = None,
) -> Dict[str, Any]:
    expected_interval = _validate_activation_interval(
        role,
        expected_interval_minutes,
    )
    args = (
        "status-scheduler",
        "--home",
        str(home),
        "--platform",
        "macos",
        "--json",
        "--strict",
    )
    result = _run_canonical_command(
        runtime,
        home,
        args,
        before_spawn=before_spawn,
    )
    if result.timed_out or result.output_overflow:
        raise ControllerError("canonical scheduler status exceeded its command bounds")
    if result.returncode not in (0, 1) or result.stderr:
        raise ControllerError(
            f"canonical scheduler status failed operationally with exit {result.returncode}"
        )
    report = _parse_scheduler_report(result.stdout)
    daemon_classification = report["daemon_query"]["classification"]
    expected_config = [
        str(
            home.parent
            / "Library"
            / "LaunchAgents"
            / "io.github.joey-tools.codex-personal-sync.plist"
        )
    ]
    summary: Dict[str, Any] = {
        "healthy": False,
        "reason": None,
        "returncode": result.returncode,
        "platform": report["platform"],
        "installed": report["installed"],
        "enabled": report["enabled"],
        "runner": report["runner"],
        "stable_runner": report["stable_runner"],
        "command": report["command"],
        "mode": report["mode"],
        "repo": report["repo"],
        "base_repo": report["base_repo"],
        "owner": report["owner"],
        "interval_minutes": report["interval_minutes"],
        "expected_interval_minutes": expected_interval,
        "migration_needed": report["migration_needed"],
        "daemon_classification": daemon_classification,
    }
    if role == "headless-managed":
        absent = (
            result.returncode == 1
            and report["platform"] == "macos"
            and report["installed"] is False
            and report["enabled"] is False
            and report["runner"] is None
            and report["stable_runner"] is False
            and report["command"] is None
            and report["mode"] is None
            and report["repo"] is None
            and report["base_repo"] is None
            and report["private_repo"] is None
            and report["owner"] is None
            and report["migration_needed"] is False
            and report["config"] == expected_config
            and report["interval_minutes"] is None
            and report["current_release"] == {}
            and daemon_classification == "disabled"
            and report["failure_code"] is None
            and report["failure_reason"] is None
            and report["failures"] == []
        )
        summary["healthy"] = absent
        summary["reason"] = None if absent else "headless-scheduler-present-or-uncertain"
        return summary

    expected_runner = _private_runner(home)
    common_healthy = (
        report["platform"] == "macos"
        and report["installed"] is True
        and report["enabled"] is True
        and report["config"] == expected_config
        and report["interval_minutes"] == expected_interval
        and report["runner"] == expected_runner
        and report["command"] == "run-scheduled"
        and report["mode"] == "private"
        and report["repo"] == PRIVATE_REPO
        and report["base_repo"] == PUBLIC_REPO
        and report["private_repo"] == PRIVATE_REPO
        and report["owner"] == PRIVATE_OWNER
        and report["migration_needed"] is False
        and daemon_classification == "enabled"
        and report["daemon_query"]["reason"] is None
    )
    if not common_healthy:
        if report["installed"] is not True:
            reason = "scheduler-not-installed"
        elif report["enabled"] is not True or daemon_classification != "enabled":
            reason = "scheduler-daemon-disabled"
        elif report["runner"] != expected_runner:
            reason = "scheduler-runner-mismatch"
        elif report["interval_minutes"] != expected_interval:
            reason = "scheduler-interval-mismatch"
        else:
            reason = "scheduler-config-mismatch"
        summary["reason"] = reason
        return summary
    # Canonical stable-runner validation intentionally recognizes only the
    # public `codex-personal-sync` link. Every activated GUI role must use the
    # private wrapper so run-scheduled validates the committed role before
    # dispatch, so accept exactly that one known drift and reject every extra
    # or differently shaped failure.
    expected_drift = {
        "code": "scheduler-runner-drift",
        "reason": "scheduler does not use the stable installed runner path",
    }
    healthy = (
        result.returncode == 1
        and report["stable_runner"] is False
        and report["failure_code"] == expected_drift["code"]
        and report["failure_reason"] == expected_drift["reason"]
        and report["failures"] == [expected_drift]
    )
    summary["healthy"] = healthy
    summary["reason"] = None if healthy else "scheduler-status-not-clean"
    if healthy:
        summary["compatibility_exception"] = "canonical-private-runner-drift"
    return summary


def _status_activation_snapshot(
    runtime: Runtime,
    home: Path,
    account: Account,
    snapshot: InventorySnapshot,
) -> Tuple[Optional[EffectiveEntry], Dict[str, Any]]:
    with _open_state_directory(home, account.uid, create=False) as (
        _path,
        directory_fd,
    ):
        pending_file = _read_bound_state_file(
            directory_fd,
            ACTIVATION_PENDING_FILE_NAME,
            account.uid,
            missing_ok=True,
        )
        receipt_file = _read_bound_state_file(
            directory_fd,
            ACTIVATION_FILE_NAME,
            account.uid,
            missing_ok=True,
        )
    if pending_file.exists:
        assert pending_file.payload is not None
        pending = _parse_activation_pending(pending_file.payload)
        pending_status = pending["status"]
        reason = {
            "pending": "legacy-pending",
            "in-flight": "process-in-flight",
            "retryable": "activation-retryable",
            "process-cleanup-inconclusive": "process-cleanup-inconclusive",
        }[pending_status]
        activation = {
            "healthy": False,
            "status": pending_status,
            "reason": reason,
        }
        if not receipt_file.exists:
            return None, activation
    else:
        activation = {
            "healthy": True,
            "status": "committed",
            "reason": None,
        }
    effective = _validated_activation_receipt(
        home,
        account,
        snapshot,
        receipt_file,
        requested_host_id=None,
        runtime=runtime,
    )
    return effective, activation


def _status_payload_locked(
    runtime: Runtime,
    home: Path,
    account: Account,
) -> Tuple[Dict[str, Any], bool]:
    host_state_error: Optional[BaseException] = None
    try:
        host_state = _read_host_mutation_state(home, account)
        aggregate_host_mutation = _aggregate_host_mutation_health(host_state)
    except (ControllerError, OSError) as error:
        host_state = None
        host_state_error = error
        aggregate_host_mutation = _unreadable_host_mutation_health(error)
    try:
        snapshot = _load_current_inventory(home, account.uid)
        effective, activation = _status_activation_snapshot(
            runtime,
            home,
            account,
            snapshot,
        )
    except (ControllerError, OSError) as error:
        return (
            {
                "version": VERSION,
                "healthy": False,
                "degraded": True,
                "operational_error": True,
                "reason": str(error),
                "host_mutation": aggregate_host_mutation,
                "activation": {
                    "healthy": False,
                    "status": "unreadable",
                    "reason": str(error),
                },
                "targets": [],
            },
            False,
        )
    if effective is None:
        if host_state_error is not None:
            return (
                {
                    "version": VERSION,
                    "healthy": False,
                    "degraded": True,
                    "operational_error": True,
                    "reason": str(host_state_error),
                    "host_mutation": aggregate_host_mutation,
                    "activation": activation,
                    "targets": [],
                },
                False,
            )
        return (
            {
                "version": VERSION,
                "healthy": False,
                "degraded": True,
                "operational_error": False,
                "reason": activation["reason"],
                "host_mutation": aggregate_host_mutation,
                "activation": activation,
                "targets": [],
            },
            True,
        )
    payload: Dict[str, Any] = {
        "version": VERSION,
        "healthy": True,
        "degraded": False,
        "operational_error": False,
        "reason": None,
        "host_id": effective.entry.host_id,
        "role": effective.entry.role,
        "entry_source": effective.source,
        "inventory_release_sha": snapshot.release_sha,
        "inventory_sha256": snapshot.content_sha256,
        "activation": activation,
        "targets": [],
    }
    if not activation["healthy"]:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["reason"] = activation["reason"]
    if host_state_error is not None:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["operational_error"] = True
        payload["reason"] = str(host_state_error)
        payload["host_mutation"] = aggregate_host_mutation
        return payload, False
    try:
        host_mutation = _host_mutation_health(
            host_state,
            snapshot,
            effective,
        )
    except (ControllerError, OSError) as error:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["operational_error"] = True
        payload["reason"] = str(error)
        payload["host_mutation"] = aggregate_host_mutation
        return payload, False
    payload["host_mutation"] = host_mutation
    if not host_mutation["healthy"]:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["reason"] = host_mutation["reason"]
    try:
        with _open_home_directory_descriptor(home, account.uid) as (
            _home_fd,
            revalidate_home,
        ):
            scheduler = _scheduler_health(
                runtime,
                home,
                effective.entry.role,
                expected_interval_minutes=effective.interval_minutes,
                before_spawn=revalidate_home,
            )
            if effective.entry.role in ("gui-controller", "gui-standalone"):
                _verify_private_runner(
                    runtime,
                    home,
                    before_spawn=revalidate_home,
                )
    except (ControllerError, OSError) as error:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["operational_error"] = True
        payload["reason"] = str(error)
        return payload, False
    payload["scheduler"] = scheduler
    if not scheduler["healthy"]:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["reason"] = (
            scheduler["reason"]
            if host_mutation["healthy"] and activation["healthy"]
            else "scheduler-and-operation-degraded"
        )
    if effective.entry.role != "gui-controller":
        return payload, True
    target_reports: List[Dict[str, Any]] = []
    try:
        current_identities = _read_release_identities(runtime, home)
        if current_identities["private"]["sha"] != snapshot.release_sha:
            raise ControllerError(
                "current inventory release does not match private identity"
            )
        with _open_state_directory(home, account.uid, create=False) as (_path, directory_fd):
            for target_id in effective.entry.targets:
                target = snapshot.inventory.hosts[target_id]
                name = f"target-{target_id}.json"
                state_file = _read_bound_state_file(
                    directory_fd, name, account.uid, missing_ok=True
                )
                if not state_file.exists:
                    target_reports.append(
                        {
                            "target_id": target_id,
                            "healthy": False,
                            "pending": False,
                            "reason": "state-missing",
                        }
                    )
                    continue
                assert state_file.payload is not None
                state_value = _parse_target_state(
                    state_file.payload,
                    target_id=target_id,
                )
                controller_matches = (
                    state_value["controller_id"] == effective.entry.host_id
                )
                scope_matches = (
                    controller_matches
                    and state_value["scope_sha256"]
                    == _scope_digest(effective.entry, target)
                )
                release_matches = (
                    state_value["confirmed"] == current_identities
                    and state_value["desired"] == current_identities
                )
                healthy = (
                    not state_value["pending"]
                    and scope_matches
                    and release_matches
                )
                if state_value["pending"] and state_value["last_error"] is None:
                    target_reason = "legacy-pending"
                elif state_value["last_error"] in (
                    "process-in-flight",
                    "process-cleanup-inconclusive",
                ):
                    target_reason = state_value["last_error"]
                elif not scope_matches:
                    target_reason = "scope-changed"
                elif state_value["pending"]:
                    target_reason = state_value["last_error"]
                elif release_matches:
                    target_reason = None
                else:
                    target_reason = "release-unconfirmed"
                target_reports.append(
                    {
                        "target_id": target_id,
                        "healthy": healthy,
                        "pending": state_value["pending"],
                        "reason": target_reason,
                        "confirmed": state_value["confirmed"],
                        "desired": state_value["desired"],
                    }
                )
    except (ControllerError, OSError) as error:
        payload["healthy"] = False
        payload["degraded"] = True
        payload["operational_error"] = True
        payload["reason"] = str(error)
        return payload, False
    payload["targets"] = target_reports
    if any(not report["healthy"] for report in target_reports):
        payload["healthy"] = False
        payload["degraded"] = True
        payload["reason"] = (
            "one-or-more-targets-degraded"
            if scheduler["healthy"] and host_mutation["healthy"]
            else (
                "operation-and-targets-degraded"
                if scheduler["healthy"]
                else "scheduler-operation-or-targets-degraded"
            )
        )
    return payload, True


def _status_payload(runtime: Runtime, raw_home: Path) -> Tuple[Dict[str, Any], bool]:
    try:
        account = runtime.account()
        home = _codex_home(raw_home, account)
        with _status_snapshot_lock(home, account.uid, runtime):
            return _status_payload_locked(runtime, home, account)
    except (ControllerError, OSError) as error:
        return (
            {
                "version": VERSION,
                "healthy": False,
                "degraded": True,
                "operational_error": True,
                "reason": str(error),
                "host_mutation": _unreadable_host_mutation_health(error),
                "activation": {
                    "healthy": False,
                    "status": "unreadable",
                    "reason": str(error),
                },
                "targets": [],
            },
            False,
        )


def _parse_expected_pair(args: argparse.Namespace) -> Dict[str, Dict[str, str]]:
    return {
        "public": _identity_tree(
            {"sha": args.expected_public_sha, "tree_sha256": args.expected_public_tree},
            "expected public",
        ),
        "private": _identity_tree(
            {"sha": args.expected_private_sha, "tree_sha256": args.expected_private_tree},
            "expected private",
        ),
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Role-aware private macOS personal sync controller"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    activate_parser = subparsers.add_parser(
        "activate", help="Activate the current host's explicit or GUI-standalone role"
    )
    activate_parser.add_argument("--home", default="~/.codex")
    activate_parser.add_argument("--host-id")
    activate_parser.add_argument("--interval-minutes", type=int, default=30)

    status_parser = subparsers.add_parser("status", help="Report controller fanout health")
    status_parser.add_argument("--home", default="~/.codex")
    status_parser.add_argument("--json", action="store_true")
    status_parser.add_argument("--strict", action="store_true")

    scheduled_parser = subparsers.add_parser("run-scheduled", help=argparse.SUPPRESS)
    scheduled_parser.add_argument("--mode", choices=("private",), required=True)
    scheduled_parser.add_argument("--repo", required=True)
    scheduled_parser.add_argument("--base-repo", required=True)
    scheduled_parser.add_argument("--owner", required=True)
    scheduled_parser.add_argument("--home", default="~/.codex")
    scheduled_parser.add_argument("--strict", action="store_true")

    target_parser = subparsers.add_parser(
        "sync-target", help="Synchronize one inventory-derived headless target"
    )
    target_parser.add_argument("--home", default="~/.codex")
    target_parser.add_argument("--target-id", required=True)
    target_parser.add_argument("--force", action="store_true")
    target_parser.add_argument("--strict", action="store_true")

    remote_parser = subparsers.add_parser("remote-apply", help=argparse.SUPPRESS)
    remote_parser.add_argument("--home", required=True)
    remote_parser.add_argument("--host-id", required=True)
    remote_parser.add_argument("--controller-id", required=True)
    remote_parser.add_argument("--expected-public-sha", required=True)
    remote_parser.add_argument("--expected-public-tree", required=True)
    remote_parser.add_argument("--expected-private-sha", required=True)
    remote_parser.add_argument("--expected-private-tree", required=True)
    return parser


def _report_committed_activation(effective: EffectiveEntry) -> None:
    try:
        message = json.dumps(
            {
                "version": VERSION,
                "activated": True,
                "host_id": effective.entry.host_id,
                "role": effective.entry.role,
                "entry_source": effective.source,
                "scheduler": (
                    "aqua-controller"
                    if effective.entry.role == "gui-controller"
                    else (
                        "aqua-standalone"
                        if effective.entry.role == "gui-standalone"
                        else "not-installed"
                    )
                ),
            },
            sort_keys=True,
        ) + "\n"
        written = sys.stdout.write(message)
        if written is not None and written != len(message):
            raise OSError("short write for committed activation report")
        sys.stdout.flush()
    except BaseException:
        # Sentinel removal has already committed authorization. Reporting is
        # best-effort and must neither change exit status nor leave a failing
        # buffered stream for interpreter-shutdown flush.
        sys.stdout = _CommittedStdoutSink()


def _report_remote_cleanup(receipt: Dict[str, Any]) -> None:
    """Best-effort reporting after the durable remote fence is authoritative."""
    try:
        payload = _canonical_json_bytes(receipt)
        written = sys.stdout.buffer.write(payload)
        if written is not None and written != len(payload):
            raise OSError("short write for remote cleanup receipt")
        sys.stdout.buffer.flush()
    except BaseException:
        # The remote operation fence is already blocking. A broken transport
        # must preserve exit 75 so the controller quarantines the target; it
        # must never turn the result into a retryable generic remote failure.
        sys.stdout = _CommittedStdoutSink()


def main(argv: Optional[Sequence[str]] = None, runtime: Optional[Runtime] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    active_runtime = runtime or SystemRuntime()
    try:
        if args.command == "activate":
            if args.interval_minutes < 1 or args.interval_minutes > 7 * 24 * 60:
                raise ControllerError("--interval-minutes is outside the supported range")
            effective = activate(
                active_runtime,
                Path(args.home),
                requested_host_id=args.host_id,
                interval_minutes=args.interval_minutes,
            )
            _report_committed_activation(effective)
            return 0
        if args.command == "status":
            payload, state_readable = _status_payload(active_runtime, Path(args.home))
            if args.json:
                print(json.dumps(payload, sort_keys=True))
            else:
                print(
                    "healthy"
                    if payload["healthy"]
                    else f"degraded: {payload.get('reason') or 'unknown'}"
                )
            if not state_readable:
                return 1
            if args.strict and not payload["healthy"]:
                return 2
            return 0
        if args.command == "run-scheduled":
            if (
                args.repo != PRIVATE_REPO
                or args.base_repo != PUBLIC_REPO
                or args.owner != PRIVATE_OWNER
            ):
                raise ControllerError("scheduled private repository scope is invalid")
            healthy = controller_run(
                active_runtime,
                Path(args.home),
                strict=args.strict,
            )
            return 0 if healthy else 2
        if args.command == "sync-target":
            healthy = sync_target(
                active_runtime,
                Path(args.home),
                target_id=args.target_id,
                force=args.force,
                strict=args.strict,
            )
            return 0 if healthy else 2
        if args.command == "remote-apply":
            host_id = _validate_host_id(args.host_id, "remote host id")
            controller_id = _validate_host_id(args.controller_id, "remote controller id")
            receipt = remote_apply(
                active_runtime,
                Path(args.home),
                host_id=host_id,
                controller_id=controller_id,
                expected=_parse_expected_pair(args),
            )
            sys.stdout.buffer.write(_canonical_json_bytes(receipt))
            return 0
        parser.error(f"unsupported command: {args.command}")
    except RemoteProcessCleanupInconclusiveError as error:
        _report_remote_cleanup(error.receipt)
        return REMOTE_PROCESS_CLEANUP_EXIT
    except _ManagedProcessSignal as error:
        return 128 + error.signum
    except KeyboardInterrupt:
        return 128 + int(signal.SIGINT)
    except (ControllerError, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
