class ControllerError(RuntimeError):
    """A fail-closed controller or protocol validation failure."""


class StatePublicationError(ControllerError):
    """Durable state could not be published or revalidated."""


class UnsupportedOperationArtifactError(StatePublicationError):
    """A retired per-operation artifact requires process-safe quarantine."""


class ActivationProcessFenceError(ControllerError):
    """An activation sentinel proves or cannot exclude a live process."""


class ProcessCleanupInconclusiveError(ControllerError):
    """An owned subprocess group could not be proven terminal and reaped."""


class RemoteProcessCleanupInconclusiveError(ProcessCleanupInconclusiveError):
    """A remote-apply operation retained its durable process fence."""

    def __init__(self, receipt: Dict[str, Any]) -> None:
        self.receipt = receipt
        super().__init__("remote process cleanup was inconclusive")


class _DarwinAclApi:
    """Lazily bind the Darwin extended-ACL API after the platform gate."""

    def __init__(self) -> None:
        library = ctypes.CDLL(None, use_errno=True)
        self.acl_get_fd_np = library.acl_get_fd_np
        self.acl_get_fd_np.argtypes = (ctypes.c_int, ctypes.c_int)
        self.acl_get_fd_np.restype = ctypes.c_void_p
        self.acl_valid = library.acl_valid
        self.acl_valid.argtypes = (ctypes.c_void_p,)
        self.acl_valid.restype = ctypes.c_int
        self.acl_get_entry = library.acl_get_entry
        self.acl_get_entry.argtypes = (
            ctypes.c_void_p,
            ctypes.c_int,
            ctypes.POINTER(ctypes.c_void_p),
        )
        self.acl_get_entry.restype = ctypes.c_int
        self.acl_get_tag_type = library.acl_get_tag_type
        self.acl_get_tag_type.argtypes = (
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_int),
        )
        self.acl_get_tag_type.restype = ctypes.c_int
        self.acl_get_qualifier = library.acl_get_qualifier
        self.acl_get_qualifier.argtypes = (ctypes.c_void_p,)
        self.acl_get_qualifier.restype = ctypes.c_void_p
        self.acl_free = library.acl_free
        self.acl_free.argtypes = (ctypes.c_void_p,)
        self.acl_free.restype = ctypes.c_int
        self.mbr_uid_to_uuid = library.mbr_uid_to_uuid
        self.mbr_uid_to_uuid.argtypes = (
            ctypes.c_uint32,
            ctypes.POINTER(ctypes.c_ubyte),
        )
        self.mbr_uid_to_uuid.restype = ctypes.c_int


_DARWIN_ACL_API: Optional[_DarwinAclApi] = None


class _CommittedStdoutSink:
    """Prevent a failed committed-success stream from failing again at exit."""

    def write(self, value: str) -> int:
        return len(value)

    def flush(self) -> None:
        return None


@dataclass(frozen=True)
class CommandResult:
    returncode: int
    stdout: bytes
    stderr: bytes
    timed_out: bool = False
    output_overflow: bool = False


@dataclass(frozen=True)
class Account:
    username: str
    uid: int
    home: Path


@dataclass(frozen=True)
class HostEntry:
    host_id: str
    role: str
    username: str
    uid: int
    home: str
    targets: Tuple[str, ...] = ()
    controller: Optional[str] = None
    ssh_alias: Optional[str] = None

    def to_json(self) -> Dict[str, Any]:
        result: Dict[str, Any] = {
            "id": self.host_id,
            "role": self.role,
            "username": self.username,
            "uid": self.uid,
            "home": self.home,
        }
        if self.role == "headless-managed":
            result["controller"] = self.controller
            result["ssh_alias"] = self.ssh_alias
        return result

    def binding_json(self) -> Dict[str, Any]:
        result: Dict[str, Any] = {"entry": self.to_json()}
        if self.role == "gui-controller":
            result["managed_targets"] = list(self.targets)
        else:
            result["managed_targets"] = []
        return result


