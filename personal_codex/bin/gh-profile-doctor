#!/bin/sh
set -eu

all_profiles="JoeyTeng JoeyTeng-Codex hoteng_cisco hoteng"

die() {
    printf '%s\n' "gh-profile-doctor: $*" >&2
    exit 78
}

usage() {
    printf '%s\n' "Usage: gh-profile-doctor [--verify [PROFILE ...]]"
    printf '%s\n' "Known profiles: JoeyTeng, JoeyTeng-Codex, hoteng_cisco, hoteng"
}

profile_host() {
    case "$1" in
        JoeyTeng|JoeyTeng-Codex|hoteng_cisco)
            printf '%s\n' "github.com"
            ;;
        hoteng)
            printf '%s\n' "sqbu-github.cisco.com"
            ;;
        *)
            return 1
            ;;
    esac
}

read_profile_token() {
    profile=$1
    host=$(profile_host "$profile") || return 1
    GH_PROMPT_DISABLED=1 gh auth token --hostname "$host" --user "$profile"
}

verify_profile_login() {
    profile=$1
    token=$2
    host=$(profile_host "$profile") || return 1

    case "$host" in
        github.com)
            GH_PROMPT_DISABLED=1 GH_HOST="$host" GH_TOKEN="$token" \
                gh api user --jq .login
            ;;
        *)
            GH_PROMPT_DISABLED=1 GH_HOST="$host" GH_ENTERPRISE_TOKEN="$token" \
                gh api user --jq .login
            ;;
    esac
}

verify=false
if [ "$#" -gt 0 ]; then
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --verify)
            verify=true
            shift
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
fi

if [ "$verify" = false ] && [ "$#" -gt 0 ]; then
    die "profile names require --verify"
fi

for profile in "$@"; do
    if ! profile_host "$profile" >/dev/null; then
        die "unknown profile: $profile"
    fi
done

unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
unset GH_CONFIG_DIR GH_HOST GH_PATH GH_REPO
export GH_NO_UPDATE_NOTIFIER=1
export GH_TELEMETRY=0

if ! command -v gh >/dev/null 2>&1; then
    die "gh is not available on PATH."
fi

if ! gh auth token --help >/dev/null 2>&1; then
    die "gh must support the auth token command."
fi

if [ "$verify" = false ]; then
    printf '%s\n' "gh auth token is available."
    for profile in $all_profiles; do
        host=$(profile_host "$profile")
        if token=$(read_profile_token "$profile" 2>/dev/null) && [ -n "$token" ]; then
            status=available
        else
            status=unavailable
        fi
        token=
        printf '%s\n' "$profile: $status host=$host"
    done
    printf '%s\n' "Use --verify to validate configured identities without prompting."
    exit 0
fi

requested_count=$#
if [ "$requested_count" -eq 0 ]; then
    profiles_to_verify=$all_profiles
else
    profiles_to_verify="$*"
fi

verified_count=0
skipped_count=0
failed_count=0
for profile in $profiles_to_verify; do
    host=$(profile_host "$profile")
    if token=$(read_profile_token "$profile" 2>/dev/null) && [ -n "$token" ]; then
        :
    else
        if [ "$requested_count" -gt 0 ]; then
            printf '%s\n' \
                "$profile: unavailable in the default gh configuration for $host" >&2
            failed_count=$((failed_count + 1))
        else
            printf '%s\n' "$profile: skipped (unavailable)"
            skipped_count=$((skipped_count + 1))
        fi
        token=
        continue
    fi

    if actual_login=$(verify_profile_login "$profile" "$token"); then
        :
    else
        printf '%s\n' "$profile: verification request failed for $host" >&2
        token=
        failed_count=$((failed_count + 1))
        continue
    fi
    token=

    if [ "$actual_login" != "$profile" ]; then
        printf '%s\n' \
            "$profile: expected $profile but gh authenticated as $actual_login" >&2
        failed_count=$((failed_count + 1))
        continue
    fi

    printf '%s\n' "$profile: verified host=$host"
    verified_count=$((verified_count + 1))
done

if [ "$failed_count" -ne 0 ]; then
    exit 1
fi

printf '%s\n' "verified=$verified_count skipped=$skipped_count"
