#!/bin/sh
set -eu

host=sqbu-github.cisco.com
user=hoteng

if [ "$#" -ge 1 ] && [ "$1" = "auth" ]; then
    if [ "$#" -ne 2 ] || [ "$2" != "status" ]; then
        printf '%s\n' "gh-hoteng only permits gh auth status through this wrapper." >&2
        exit 64
    fi
fi

unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
unset GH_CONFIG_DIR GH_HOST GH_PATH GH_REPO
export GH_NO_UPDATE_NOTIFIER=1
export GH_TELEMETRY=0

if ! command -v gh >/dev/null 2>&1; then
    printf '%s\n' "gh-hoteng requires gh to be available on PATH." >&2
    exit 127
fi

if token=$(GH_PROMPT_DISABLED=1 gh auth token --hostname "$host" --user "$user"); then
    :
else
    printf '%s\n' \
        "gh-hoteng could not read the $host token for $user from the default gh configuration." >&2
    exit 78
fi

if [ -z "$token" ]; then
    printf '%s\n' "gh-hoteng received an empty token for $host account $user." >&2
    exit 78
fi

export GH_ENTERPRISE_TOKEN="$token"
export GH_HOST="$host"
unset token
exec /usr/bin/env gh "$@"
